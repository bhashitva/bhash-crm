    निजी साझा फलन अंश18() -> पाठ { लौटाओ "// src/signup.bhash:89\n    सार्वजनिक फलन विवरण(टोकन: पाठ) -> मानचित्र<पाठ,पाठ> {\n        यदि (पाठ्य.लंबाई(टोकन)!=६४) { फेंको नया वेबत्रुटि(४२२,\"Verification link is invalid or expired. Request a new email.\"); }\n        मान क: पूर्णांक=०; जबतक (क<६४) { यदि (!पाठ्य.है(\"0123456789abcdef\",पाठ्य.अंश(टोकन,क,क+१))) { फेंको नया वेबत्रुटि(४२२,\"Verification link is invalid or expired. Request a new email.\"); } क=क+१; }\n        स्थिर फल: मानचित्र<पाठ,पाठ> =नया मानचित्र<पाठ,पाठ>();\n        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (कथन: डेटाकथन=ड.तैयार(\"SELECT email,language FROM crm_email_verifications WHERE token_hash=? AND sent=TRUE AND created<=? AND expires>?\")) { कथन.पाठरखो(१,डेटाचेकसम.शा२५६(टोकन)); कथन.पूर्णांकरखो(२,समय.अभी()); कथन.पूर्णांकरखो(३,समय.अभी()); यदि (कथन.अगला()) { फल[\"email\"]=कथन.पाठलो(०); फल[\"language\"]=कथन.पाठलो(१); लौटाओ फल; } } }\n        फेंको नया वेबत्रुटि(४२२,\"Verification link is invalid or expired. Request a new email.\");\n    }\n\n// src/signup.bhash:96\n    सार्वजनिक फलन पूरा(टोकन: पाठ, नाम: पाठ, पास: पाठ, संगठन: पाठ) -> पाठ {\n        यदि (!यह.तैयार()) { फेंको नया वेबत्रुटि(५०३,\"Account registration is temporarily unavailable.\"); }\n        स्थिर वि: मानचित्र<पाठ,पाठ> =यह.विवरण(टोकन); यह.सीमा(\"complete:\"+टोकन,८,६०००००);\n        स्थिर उ: पाठ=सीआरएमभंडार.खातानाम(नाम); सीआरएमभंडार.कूटजाँचो(पास);\n        स्थिर सं: पाठ=पाठ्य.छाँटो(संगठन); यदि (सं==\"\" || पाठ्य.यूटीएफ८(सं).आकार>२००) { फेंको नया वेबत्रुटि(४२२,\"Enter an organization name.\"); }\n        स्थिर हैश: पाठ=कूटशब्द.हैशबनाओ(पास); स्थिर पहचान: पाठ=सुरक्षा.टोकन(); स्थिर त: पाठ=सुरक्षा.टोकन();\n        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {\n            पंजीकरण.तालालो(ड);\n            संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT id FROM platform_users WHERE username=? OR email=?\")) { क.पाठ"; }
    निजी साझा फलन अंश19() -> पाठ { लौटाओ "रखो(१,उ); क.पाठरखो(२,वि[\"email\"]); यदि (क.अगला()) { फेंको नया वेबत्रुटि(४०९,\"Username or email is already registered. Sign in or choose another username.\"); } }\n            संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT COUNT(*) FROM platform_users\")) { क.अगला(); यदि (क.पूर्णांकलो(०)>=१००००) { फेंको नया वेबत्रुटि(४०९,\"Account capacity reached.\"); } }\n            संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT COUNT(*) FROM platform_tenants\")) { क.अगला(); यदि (क.पूर्णांकलो(०)>=१०००) { फेंको नया वेबत्रुटि(४०९,\"Organization capacity reached.\"); } }\n            संसाधन (क: डेटाकथन=ड.तैयार(\"DELETE FROM crm_email_verifications WHERE token_hash=? AND email=? AND sent=TRUE AND expires>?\")) { क.पाठरखो(१,डेटाचेकसम.शा२५६(टोकन)); क.पाठरखो(२,वि[\"email\"]); क.पूर्णांकरखो(३,समय.अभी()); यदि (क.चलाओ()!=१) { फेंको नया वेबत्रुटि(४२२,\"Verification link is invalid or expired. Request a new email.\"); } }\n            संसाधन (क: डेटाकथन=ड.तैयार(\"INSERT INTO platform_users(id,username,password_hash,active,ui_language,email,email_verified) VALUES (?,?,?,TRUE,?,?,TRUE)\")) { क.पाठरखो(१,पहचान); क.पाठरखो(२,उ); क.पाठरखो(३,हैश); क.पाठरखो(४,वि[\"language\"]); क.पाठरखो(५,वि[\"email\"]); क.चलाओ(); }\n            संसाधन (क: डेटाकथन=ड.तैयार(\"INSERT INTO platform_tenants(id,name,revision) VALUES (?,?,0)\")) { क.पाठरखो(१,त); क.पाठरखो(२,सं); क.चलाओ(); }\n            संसाधन (क: डेटाकथन=ड.तैयार(\"INSERT INTO platform_members(tenant_id,user_id,role) VALUES (?,?,'owner')\")) { क.पाठरखो(१,त); क.पाठरखो(२,पहचान); क.चलाओ(); }\n            संगठननीति.लेखा(ड,नया संगठनसंदर्भ(त,पहचान,\"owner\"),\"create\",\"organization\",त);\n            संसाधन (क: डेटाकथन=ड.तैयार(\"DELETE FROM crm_email_verifications WHERE email=?\")) { क.पाठरखो(१,वि[\"email\"]); क.चलाओ(); } ल.सहेजो();\n        } } लौटाओ पहचान;\n    }\n\n"; }
    निजी साझा फलन अंश20() -> पाठ { लौटाओ "// src/web.bhash:13\n    निजी फलन शीर्षक(प्रकार: पाठ) -> पाठ {\n        यदि (प्रकार==\"companies\") { लौटाओ भाषादृश्य.पाठलो(\"Companies\"); } यदि (प्रकार==\"contacts\") { लौटाओ भाषादृश्य.पाठलो(\"Contacts\"); }\n        यदि (प्रकार==\"deals\") { लौटाओ भाषादृश्य.पाठलो(\"Opportunities\"); } यदि (प्रकार==\"tasks\") { लौटाओ भाषादृश्य.पाठलो(\"Tasks\"); }\n        फेंको नया वेबत्रुटि(४०४,\"अमान्य CRM प्रकार।\");\n    }\n\n// src/web.bhash:18\n    निजी फलन पथ(त: पाठ, प्रकार: पाठ) -> पाठ { लौटाओ \"/t/\"+त+\"/\"+प्रकार; }\n\n// src/web.bhash:22\n    निजी फलन क्षेत्र(न: पाठ, शीर्षक: पाठ, प्रकार: पाठ, व: पाठ) -> दृश्य {\n        लौटाओ दृश्य.खंड(\"label\").जोड़ो(दृश्य.अक्षर(भाषादृश्य.पाठलो(शीर्षक))).जोड़ो(दृश्य.खंड(\"input\").गुण(\"name\",न).गुण(\"type\",प्रकार).गुण(\"value\",व).गुण(\"maxlength\",\"1024\"));\n    }\n\n// src/web.bhash:25\n    निजी फलन चुनो(न: पाठ, शीर्षक: पाठ, मानक: पाठ, विकल्पसूची: सूची<पाठ>) -> दृश्य {\n        स्थिर चयनसूची: दृश्य=दृश्य.खंड(\"select\").गुण(\"name\",न);\n        प्रत्येक (विकल्पसूची में व: पाठ) { मान नाम: पाठ=भाषादृश्य.पाठलो(व); यदि (व==\"hi\") { नाम=\"हिन्दी\"; } यदि (व==\"en\") { नाम=\"English\"; } स्थिर ख: दृश्य=दृश्य.शब्द(\"option\",नाम).गुण(\"value\",व); यदि (व==मानक) { ख.गुण(\"selected\",\"selected\"); } चयनसूची.जोड़ो(ख); }\n        लौटाओ दृश्य.खंड(\"label\").जोड़ो(दृश्य.अक्षर(भाषादृश्य.पाठलो(शीर्षक))).जोड़ो(चयनसूची);\n    }\n\n// src/web.bhash:30\n    निजी फलन भाषाफॉर्म(स: सत्र) -> दृश्य {\n        लौटाओ दृश्य.फॉर्म(\"/language\",स.सीएसआरएफ()).जोड़ो(दृश्य.छिपा(\"_return\",वापसी)).जोड़ो(यह.चुनो(\"language\",\"Display language\",भाषादृश्य.भाषा,नया सूची<पाठ>{\"hi\",\"en\"})).जोड़ो(भाषादृश्य.भेजो(\"Switch\"));\n    }\n\n// src/web.bhash:33\n    निजी फलन ढाँचा(स: सत्र, त: पाठ, शीर्षक: पाठ, मुख्य: दृश्य, स्रोतकुंजी: पाठ) -> वेबउत्तर {\n        स्थिर नव: दृश्य=दृश्य.खंड(\"nav\").गुण(\"aria-label\",भाषादृश्य.पाठलो(\"Main navigation\")).जोड़ो(भाषादृश्य.क"; }
    निजी साझा फलन अंश21() -> पाठ { लौटाओ "ड़ी(\"/\",\"Organizations\"));\n        यदि (त!=\"\") {\n            नव.जोड़ो(भाषादृश्य.कड़ी(\"/t/\"+त,\"Overview\"));\n            प्रत्येक (नया सूची<पाठ>{\"companies\",\"contacts\",\"deals\",\"tasks\"} में प: पाठ) { नव.जोड़ो(दृश्य.कड़ी(यह.पथ(त,प),यह.शीर्षक(प))); }\n            यदि (भंडार.संदर्भ(स,त).भूमिका==\"owner\") { नव.जोड़ो(भाषादृश्य.कड़ी(यह.पथ(त,\"members\"),\"Members\")).जोड़ो(भाषादृश्य.कड़ी(यह.पथ(त,\"audit\"),\"Audit\")); }\n        }\n        नव.जोड़ो(भाषादृश्य.कड़ी(\"/account\",\"Account\"));\n        स्थिर शीर्ष: दृश्य=दृश्य.खंड(\"header\").जोड़ो(भाषादृश्य.नोड(\"strong\",\"Bhash · CRM\")).जोड़ो(नव).जोड़ो(यह.भाषाफॉर्म(स)).जोड़ो(दृश्य.फॉर्म(\"/logout\",स.सीएसआरएफ()).जोड़ो(भाषादृश्य.भेजो(\"Sign out\")));\n        लौटाओ भाषादृश्य.पृष्ठ(शीर्षक,दृश्य.खंड(\"div\").जोड़ो(शीर्ष).जोड़ो(दृश्य.खंड(\"main\").जोड़ो(दृश्य.शब्द(\"h1\",शीर्षक)).जोड़ो(मुख्य)),स्रोतकुंजी);\n    }\n\n"; }
    निजी साझा फलन अंश22() -> पाठ { लौटाओ "// src/storage.bhash:56\n    सार्वजनिक साझा फलन खातानाम(नाम: पाठ) -> पाठ {\n        स्थिर न: पाठ=पाठ्य.छोटाअक्षर(पाठ्य.छाँटो(नाम));\n        यदि (पाठ्य.लंबाई(न)<३ || पाठ्य.लंबाई(न)>६४) { फेंको नया वेबत्रुटि(४२२,\"खाता ३–६४ अक्षर चाहिए।\"); }\n        मान क: पूर्णांक=०; जबतक (क<पाठ्य.लंबाई(न)) {\n            यदि (!पाठ्य.है(\"abcdefghijklmnopqrstuvwxyz0123456789._-\",पाठ्य.अंश(न,क,क+१))) { फेंको नया वेबत्रुटि(४२२,\"खाते में छोटे Latin अक्षर, अंक, . _ - दें।\"); } क=क+१;\n        } लौटाओ न;\n    }\n\n// src/storage.bhash:69\n    सार्वजनिक फलन प्रवेश(नाम: पाठ, पास: पाठ) -> पाठ {\n        स्थिर न: पाठ=सीआरएमभंडार.खातानाम(नाम); मंच.प्रवेशसीमा(स्रोत,न);\n        मान पहचान: पाठ=\"\"; मान हैश: पाठ=\"$bhash$pbkdf2-sha256$600000$000102030405060708090a0b0c0d0e0f$3bc37118e625093e9b79ed08930ea7af7389591233fdd92dddf369371e60dbc0\";\n        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT id,password_hash FROM platform_users WHERE username=? AND active=TRUE\")) { क.पाठरखो(१,न); यदि (क.अगला()) { पहचान=क.पाठलो(०); हैश=क.पाठलो(१); } } }\n        यदि (!कूटशब्द.जाँचो(पास,हैश) || पहचान==\"\") { फेंको नया वेबत्रुटि(४०१,\"प्रवेश असफल।\"); } लौटाओ पहचान;\n    }\n\n"; }
    निजी साझा फलन अंश23() -> पाठ { लौटाओ "// src/storage.bhash:93\n    निजी फलन संगठनबनाओ(ड: डेटासंबंध, उ: पाठ, नाम: पाठ) -> पाठ {\n        संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT COUNT(*) FROM platform_tenants\")) { क.अगला(); यदि (क.पूर्णांकलो(०)>=१०००) { फेंको नया वेबत्रुटि(४०९,\"संगठन क्षमता।\"); } }\n        संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT COUNT(*) FROM platform_members WHERE user_id=? AND role='owner'\")) { क.पाठरखो(१,उ); क.अगला(); यदि (क.पूर्णांकलो(०)>=२०) { फेंको नया वेबत्रुटि(४०९,\"मालिक संगठन सीमा।\"); } }\n        स्थिर त: पाठ=सुरक्षा.टोकन();\n        संसाधन (क: डेटाकथन=ड.तैयार(\"INSERT INTO platform_tenants(id,name,revision) VALUES (?,?,0)\")) { क.पाठरखो(१,त); क.पाठरखो(२,नाम); क.चलाओ(); }\n        संसाधन (क: डेटाकथन=ड.तैयार(\"INSERT INTO platform_members(tenant_id,user_id,role) VALUES (?,?,'owner')\")) { क.पाठरखो(१,त); क.पाठरखो(२,उ); क.चलाओ(); }\n        संगठननीति.लेखा(ड,नया संगठनसंदर्भ(त,उ,\"owner\"),\"create\",\"tenant\",त); लौटाओ त;\n    }\n\n// src/storage.bhash:101\n    सार्वजनिक फलन नयासंगठन(स: सत्र, नाम: पाठ) -> पाठ {\n        यदि (नाम==\"\" || पाठ्य.यूटीएफ८(नाम).आकार>२००) { फेंको नया वेबत्रुटि(४२२,\"अमान्य नाम।\"); }\n        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {\n            संसाधन (क: डेटाकथन=ड.तैयार(\"UPDATE platform_lock SET revision=revision WHERE id=1\")) { क.चलाओ(); }\n            यह.जीवितखाता(ड,स); स्थिर त: पाठ=यह.संगठनबनाओ(ड,स.उपयोगकर्ता(),नाम); ल.सहेजो(); लौटाओ त;\n        } }\n    }\n\n// src/storage.bhash:127\n    सार्वजनिक फलन संगठनसूची(स: सत्र) -> सूची<मानचित्र<पाठ,पाठ>> {\n        स्थिर फल: सूची<मानचित्र<पाठ,पाठ>> =नया सूची<मानचित्र<पाठ,पाठ>>();\n        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { यह.जीवितखाता(ड,स);\n            संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT t.id,t.name,m.role FROM platform_tenants t JOIN platform_members m ON m.tenant_id=t.id WHERE m.user_id=? ORDER BY t.name,t.id LIMIT 100"; }
    निजी साझा फलन अंश24() -> पाठ { लौटाओ "0\")) { क.पाठरखो(१,स.उपयोगकर्ता());\n                जबतक (क.अगला()) { स्थिर प: मानचित्र<पाठ,पाठ> =नया मानचित्र<पाठ,पाठ>(); प[\"id\"]=क.पाठलो(०); प[\"name\"]=क.पाठलो(१); प[\"role\"]=क.पाठलो(२); फल.जोड़ो(प); }\n            }\n        } लौटाओ फल;\n    }\n\n"; }
