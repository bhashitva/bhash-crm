    निजी साझा फलन अंश80() -> पाठ { लौटाओ "\"code\"); स्थिर पंक्तियाँ: सूची<पाठ> =पाठ्य.बाँटो(मूल,\"\\n\"); मान क: पूर्णांक=०;\n        प्रत्येक (पंक्तियाँ में पंक्ति: पाठ) {\n            यदि (!(क==पंक्तियाँ.आकार-१ && पंक्ति==\"\" && क>०)) { स्थिर प: दृश्य=रंग.पंक्ति(पंक्ति,क+१); यदि (क<पंक्तियाँ.आकार-१) { प.जोड़ो(दृश्य.अक्षर(\"\\n\")); } कोड.जोड़ो(प); } क=क+१;\n        }\n        लौटाओ कोड;\n    }\n    सार्वजनिक साझा फलन ब्लॉक(मूल: पाठ, शीर्षक: पाठ, कॉपी: पाठ, सफल: पाठ, असफल: पाठ) -> दृश्य {\n        स्थिर बटन: दृश्य=दृश्य.शब्द(\"button\",कॉपी).गुण(\"type\",\"button\").गुण(\"class\",\"source-copy-button\").गुण(\"data-copy-code\",\"true\").गुण(\"data-copy-ready\",कॉपी).गुण(\"data-copy-done\",सफल).गुण(\"data-copy-error\",असफल).गुण(\"aria-label\",कॉपी+\" · \"+शीर्षक);\n        स्थिर औजार: दृश्य=दृश्य.खंड(\"div\").गुण(\"class\",\"source-code-tools\").जोड़ो(बटन).जोड़ो(दृश्य.खंड(\"span\").गुण(\"class\",\"source-copy-status\").गुण(\"role\",\"status\").गुण(\"aria-live\",\"polite\"));\n        लौटाओ दृश्य.खंड(\"div\").गुण(\"class\",\"source-code-block\").जोड़ो(औजार).जोड़ो(दृश्य.खंड(\"pre\").गुण(\"tabindex\",\"0\").गुण(\"aria-label\",शीर्षक).जोड़ो(स्रोतप्रकाश.कोड(मूल)));\n    }\n    सार्वजनिक साझा फलन कॉपीलिपि() -> वेबउत्तर {\n        स्थिर उत्तर: वेबउत्तर=वेब.पाठउत्तर(२००,\"'use strict';document.documentElement.classList.add('source-copy-ready');const timers=new WeakMap();document.addEventListener('click',async(event)=>{const button=event.target.closest('button[data-copy-code]');if(!button)return;const block=button.closest('.source-code-block');const code=block.querySelector('code');const status=block.querySelector('[role=status]');clearTimeout(timers.get(button));button.disabled=true;status.textContent='';try{if(!navigator.clipboard||!window.isSecureContext)throw new Error('unavailable');await navigator.clipboard.writeText(code.textContent);button.textContent=button.dataset.copyDone;status.textCont"; }
