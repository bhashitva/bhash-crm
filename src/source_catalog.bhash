    निजी साझा फलन अंश88() -> पाठ { लौटाओ "// SPDX-License-Identifier: Apache-2.0\nसंकुल अनुप्रयोग;\nआयात मानक.पाठ्य;\nआयात मानक.वेब;\nआयात मानक.वेबत्रुटि;\nआयात मानक.वेबअनुरोध;\nआयात मानक.वेबउत्तर;\nआयात मानक.वेबचालक;\nआयात मानक.सत्रप्रबंधक;\n\nसार्वजनिक वर्ग फॉर्म {\n    सार्वजनिक साझा फलन विकूटित(मूल: पाठ) -> पाठ {\n        स्थिर ब: बाइटबफ़र=पाठ्य.यूटीएफ८(मूल); स्थिर फल: बाइटबफ़र=नया बाइटबफ़र(ब.आकार); मान क: पूर्णांक=०; मान ग: पूर्णांक=०;\n        जबतक (क<ब.आकार) {\n            मान अ: पूर्णांक=परिवर्तित<पूर्णांक>(ब[क]);\n            यदि (अ==३७) {\n                यदि (क+२>=ब.आकार) { फेंको नया वेबत्रुटि(४००,\"अमान्य फॉर्म कूट।\"); }\n                स्थिर ह: पूर्णांक=पाठ्य.खोजो(\"0123456789abcdef\",पाठ्य.छोटाअक्षर(पाठ्य.यूटीएफ८पाठ(ब.काटो(क+१,क+२))));\n                स्थिर ल: पूर्णांक=पाठ्य.खोजो(\"0123456789abcdef\",पाठ्य.छोटाअक्षर(पाठ्य.यूटीएफ८पाठ(ब.काटो(क+२,क+३))));\n                यदि (ह<० || ल<०) { फेंको नया वेबत्रुटि(४००,\"अमान्य फॉर्म कूट।\"); } अ=ह*१६+ल; क=क+२;\n            } अन्यथा यदि (अ==४३) { अ=३२; }\n            यदि ((अ<३२ && अ!=९ && अ!=१० && अ!=१३) || अ==१२७) { फेंको नया वेबत्रुटि(४००,\"अमान्य फॉर्म अक्षर।\"); }\n            फल[ग]=परिवर्तित<बाइट>(अ); ग=ग+१; क=क+१;\n        }\n        प्रयास { लौटाओ पाठ्य.यूटीएफ८पाठ(फल.काटो(०,ग)); } पकड़ो (द: अपवाद) { फेंको नया वेबत्रुटि(४००,\"फॉर्म शुद्ध UTF-8 चाहिए।\"); }\n    }\n    सार्वजनिक साझा फलन पढ़ो(अ: वेबअनुरोध) -> मानचित्र<पाठ,पाठ> {\n        स्थिर प्रकार: सूची<पाठ> =अ.शीर्षमान(\"content-type\");\n        यदि (प्रकार.आकार!=१) { फेंको नया वेबत्रुटि(४१५,\"URL encoded फॉर्म चाहिए।\"); }\n        स्थिर ख: सूची<पाठ> =पाठ्य.बाँटो(पाठ्य.छोटाअक्षर(प्रकार[०]),\";\");\n        यदि (पाठ्य.छाँटो(ख[०])!=\"application/x-www-form-urlencoded\" || ख.आकार>२ || (ख.आकार==२ && पाठ्य.छाँटो(ख[१])!=\"charset=utf-8\")) { फेंको नया वेबत्रुटि(४१५,\"UTF-8 URL encoded फॉर्म चाहिए।\"); }\n        यदि (अ.सामग्री.आकार>६५५३६) { फेंको नया "; }
    निजी साझा फलन अंश89() -> पाठ { लौटाओ "वेबत्रुटि(४१३,\"फॉर्म बहुत बड़ा है।\"); }\n        स्थिर फल: मानचित्र<पाठ,पाठ> =नया मानचित्र<पाठ,पाठ>();\n        प्रत्येक (पाठ्य.बाँटो(अ.पाठ्यांश(),\"&\") में य: पाठ) {\n            यदि (य==\"\") { जारी; }\n            स्थिर बराबर: पूर्णांक=पाठ्य.खोजो(य,\"=\"); यदि (बराबर<१) { फेंको नया वेबत्रुटि(४००,\"अमान्य फॉर्म।\"); }\n            स्थिर न: पाठ=फॉर्म.विकूटित(पाठ्य.अंश(य,०,बराबर)); स्थिर व: पाठ=फॉर्म.विकूटित(पाठ्य.अंश(य,बराबर+१,पाठ्य.लंबाई(य)));\n            यदि (पाठ्य.लंबाई(न)>६४ || फल.है(न) || फल.आकार>=६४ || पाठ्य.यूटीएफ८(व).आकार>८१९२) { फेंको नया वेबत्रुटि(४००,\"दोहरा या सीमा से बाहर फॉर्म क्षेत्र।\"); }\n            फल[न]=व;\n        } लौटाओ फल;\n    }\n    सार्वजनिक साझा फलन मानलो(फ: मानचित्र<पाठ,पाठ>, नाम: पाठ, सीमा: पूर्णांक) -> पाठ {\n        यदि (!फ.है(नाम)) { फेंको नया वेबत्रुटि(४२२,\"अनिवार्य क्षेत्र अनुपस्थित।\"); }\n        स्थिर व: पाठ=पाठ्य.छाँटो(फ[नाम]); यदि (व==\"\" || पाठ्य.यूटीएफ८(व).आकार>सीमा) { फेंको नया वेबत्रुटि(४२२,\"क्षेत्र सीमा से बाहर।\"); } लौटाओ व;\n    }\n}\n\n// Only this adapter promotes a validated form token into the existing CSRF policy.\n// JSON/header-token clients continue to use सुरक्षितवेब unchanged.\nसार्वजनिक अनुबंध वेबत्रुटिदृश्य {\n    फलन उत्तर(अनुरोध: वेबअनुरोध, दोष: वेबत्रुटि) -> वेबउत्तर;\n}\nसार्वजनिक वर्ग फॉर्मसुरक्षा पालन वेबचालक {\n    निजी स्थिर म: सत्रप्रबंधक; निजी स्थिर चालक: वेबचालक;\n    निजी मान त्रुटिदृश्य: वेबत्रुटिदृश्य;\n    सार्वजनिक निर्माता(म: सत्रप्रबंधक, चालक: वेबचालक) { यह.म=म; यह.चालक=चालक; }\n    सार्वजनिक निर्माता(म: सत्रप्रबंधक, चालक: वेबचालक, त्रुटिदृश्य: वेबत्रुटिदृश्य) { यह.म=म; यह.चालक=चालक; यह.त्रुटिदृश्य=त्रुटिदृश्य; }\n    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर {\n        मान उ: वेबउत्तर=रिक्त;\n        प्रयास {\n            यदि (अ.विधि==\"POST\") {\n                यदि (अ.शीर्षमान(\"x-csrf-token\").आकार!=०) { फेंको नया वेबत्रुटि(४०"; }
    निजी साझा फलन अंश90() -> पाठ { लौटाओ "०,\"मिश्रित CSRF टोकन।\"); }\n                स्थिर फ: मानचित्र<पाठ,पाठ> =फॉर्म.पढ़ो(अ);\n                यदि (!फ.है(\"_csrf\")) { फेंको नया वेबत्रुटि(४०३,\"CSRF टोकन चाहिए।\"); }\n                अ.शीर्ष.जोड़ो(\"x-csrf-token\"); अ.शीर्ष.जोड़ो(फ[\"_csrf\"]);\n            }\n            म.सीएसआरएफजाँचो(अ); उ=चालक.संभालो(अ);\n        } पकड़ो (द: वेबत्रुटि) {\n            यदि (त्रुटिदृश्य!=रिक्त) { उ=त्रुटिदृश्य.उत्तर(अ,द); }\n            अन्यथा {\n            उ=दृश्य.पृष्ठ(\"Request could not be completed\",दृश्य.खंड(\"main\").जोड़ो(दृश्य.शब्द(\"h1\",\"Request could not be completed\")).जोड़ो(दृश्य.शब्द(\"p\",\"Status \"+वेब.अंक(द.स्थिति))).जोड़ो(दृश्य.शब्द(\"p\",द.संदेश)).जोड़ो(दृश्य.शब्द(\"p\",\"Refresh the original page before trying again.\")).जोड़ो(दृश्य.कड़ी(\"/\",\"Return to CRM\"))); उ.स्थिति=द.स्थिति;\n            }\n        }\n        उ.शीर्षरखो(\"Cache-Control\",\"no-store\"); उ.शीर्षरखो(\"X-Content-Type-Options\",\"nosniff\"); उ.शीर्षरखो(\"Referrer-Policy\",\"strict-origin\"); लौटाओ उ;\n    }\n}\n"; }
    निजी साझा फलन अंश91() -> पाठ { लौटाओ "// SPDX-License-Identifier: Apache-2.0\nसंकुल अनुप्रयोग;\nआयात मानक.सत्रप्रबंधक; आयात मानक.सत्र; आयात मानक.कुकी;\nआयात मानक.पाठ्य; आयात मानक.सुरक्षा; आयात मानक.समय; आयात मानक.डेटाचेकसम;\nआयात मानक.डेटासंबंध; आयात मानक.डेटाकथन; आयात मानक.डेटालेनदेन;\nआयात मानक.वेबअनुरोध; आयात मानक.वेबउत्तर; आयात मानक.वेबत्रुटि;\n\n// Database-backed sessions work across cooperating processes. Tokens are never\n// stored in plaintext. Membership roles are deliberately read separately per request.\nसार्वजनिक वर्ग स्थायीसत्र विस्तार सत्रप्रबंधक {\n    निजी स्थिर स्रोत: डेटास्रोत;\n    निजी स्थिर नीति: सत्रप्रबंधक;\n    निजी मान दूसरीनीति: सत्रप्रबंधक;\n    निजी मान दूसराहोस्ट: पाठ=\"\";\n    निजी स्थिर विकासमोड: तार्किक;\n    निजी मान सेवाबंद: तार्किक=असत्य;\n    सार्वजनिक निर्माता(स्रोत: डेटास्रोत, मूल: पाठ, विकासमोड: तार्किक) : आधार(\"https://localhost\") {\n        यह.स्रोत=स्रोत; यह.विकासमोड=विकासमोड;\n        यदि (विकासमोड) {\n            नीति=सत्रप्रबंधक.स्थानीय(मूल);\n            मान दूसरा: पाठ=\"\";\n            यदि (पाठ्य.आरंभ(मूल,\"http://127.0.0.1\")) { दूसरा=\"http://localhost\"+पाठ्य.अंश(मूल,पाठ्य.लंबाई(\"http://127.0.0.1\"),पाठ्य.लंबाई(मूल)); }\n            अन्यथा { दूसरा=\"http://127.0.0.1\"+पाठ्य.अंश(मूल,पाठ्य.लंबाई(\"http://localhost\"),पाठ्य.लंबाई(मूल)); }\n            दूसरीनीति=सत्रप्रबंधक.स्थानीय(दूसरा); दूसराहोस्ट=पाठ्य.अंश(दूसरा,७,पाठ्य.लंबाई(दूसरा));\n        } अन्यथा { नीति=नया सत्रप्रबंधक(मूल); }\n    }\n    निजी फलन नाम() -> पाठ { यदि (विकासमोड) { लौटाओ \"bhash-local-session\"; } लौटाओ \"__Host-bhash-session\"; }\n    निजी फलन जाँचो() -> शून्य { यदि (सेवाबंद) { फेंको नया अपवाद(\"सत्र सेवा सेवाबंद है।\"); } }\n    सार्वजनिक अधिलेखन फलन मूलजाँचो(अ: वेबअनुरोध) -> शून्य {\n        यह.जाँचो();\n        स्थिर होस्ट: सूची<पाठ> = कुकी.शीर्षलो(अ,\"host\");\n        यदि (दूसरीनीति!=रिक्त && होस्ट.आकार==१ && पाठ्य.छोटाअक्षर(होस्ट"; }
    निजी साझा फलन अंश92() -> पाठ { लौटाओ "[०])==दूसराहोस्ट) {\n            दूसरीनीति.मूलजाँचो(अ);\n        } अन्यथा { नीति.मूलजाँचो(अ); }\n    }\n    सार्वजनिक अधिलेखन फलन पाओ(अ: वेबअनुरोध) -> सत्र {\n        यह.मूलजाँचो(अ); स्थिर ट: पाठ=कुकी.पढ़ो(अ,यह.नाम());\n        यदि (पाठ्य.लंबाई(ट)!=६४) { लौटाओ रिक्त; }\n        मान क्रम: पूर्णांक=०; जबतक (क्रम<६४) { यदि (!पाठ्य.है(\"0123456789abcdef\",पाठ्य.अंश(ट,क्रम,क्रम+१))) { लौटाओ रिक्त; } क्रम=क्रम+१; }\n        स्थिर ह: पाठ=डेटाचेकसम.शा२५६(ट); स्थिर अब: पूर्णांक=समय.अभी();\n        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) {\n            // Never move touched backwards when another worker has already advanced it.\n            // A time captured before waiting on a row lock is not a clock-regression signal.\n            संसाधन (क: डेटाकथन=ड.तैयार(\"UPDATE platform_sessions SET touched=CASE WHEN touched>? THEN touched ELSE ? END WHERE token_hash=? AND born<=? AND born>? AND touched>?\")) {\n                क.पूर्णांकरखो(१,अब); क.पूर्णांकरखो(२,अब); क.पाठरखो(३,ह); क.पूर्णांकरखो(४,अब); क.पूर्णांकरखो(५,अब-२८८०००००); क.पूर्णांकरखो(६,अब-१८०००००);\n                यदि (क.चलाओ()!=१) { लौटाओ रिक्त; }\n            }\n            संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT user_id,csrf FROM platform_sessions WHERE token_hash=?\")) {\n                क.पाठरखो(१,ह); यदि (!क.अगला()) { लौटाओ रिक्त; }\n                लौटाओ नया सत्र(ट,क.पाठलो(०),क.पाठलो(१),नया सूची<पाठ>());\n            }\n        }\n    }\n    सार्वजनिक अधिलेखन फलन आरंभ(उ: पाठ, भूमिकाएँ: सूची<पाठ>) -> सत्र {\n        यह.जाँचो(); यदि (भूमिकाएँ.आकार!=० || पाठ्य.लंबाई(उ)>२५६) { फेंको नया अपवाद(\"भूमिकाएँ संगठन सदस्यता से लें।\"); }\n        स्थिर स: सत्र=नया सत्र(सुरक्षा.टोकन(),उ,सुरक्षा.टोकन(),नया सूची<पाठ>()); स्थिर अब: पूर्णांक=समय.अभी();\n        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {\n            संसाधन (क: डेटाकथन=ड.तैयार(\"U"; }
    निजी साझा फलन अंश93() -> पाठ { लौटाओ "PDATE platform_lock SET revision=revision WHERE id=1\")) { क.चलाओ(); }\n            संसाधन (क: डेटाकथन=ड.तैयार(\"DELETE FROM platform_sessions WHERE born<=? OR touched<=?\")) { क.पूर्णांकरखो(१,अब-२८८०००००); क.पूर्णांकरखो(२,अब-१८०००००); क.चलाओ(); }\n            संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT COUNT(*) FROM platform_sessions\")) { क.अगला(); यदि (क.पूर्णांकलो(०)>=१००००) { फेंको नया वेबत्रुटि(५०३,\"सत्र क्षमता भर गई।\"); } }\n            संसाधन (क: डेटाकथन=ड.तैयार(\"INSERT INTO platform_sessions(token_hash,user_id,csrf,born,touched) VALUES (?,?,?,?,?)\")) {\n                क.पाठरखो(१,डेटाचेकसम.शा२५६(स.पहचान())); क.पाठरखो(२,उ); क.पाठरखो(३,स.सीएसआरएफ()); क.पूर्णांकरखो(४,अब); क.पूर्णांकरखो(५,अब); क.चलाओ();\n            } ल.सहेजो();\n        } } लौटाओ स;\n    }\n    सार्वजनिक अधिलेखन फलन आंतरिकजीवितहै(स: सत्र) -> तार्किक {\n        यदि (सेवाबंद || स==रिक्त) { लौटाओ असत्य; } स्थिर अब: पूर्णांक=समय.अभी();\n        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT user_id,csrf FROM platform_sessions WHERE token_hash=? AND born<=? AND born>? AND touched>?\")) {\n            क.पाठरखो(१,डेटाचेकसम.शा२५६(स.पहचान())); क.पूर्णांकरखो(२,अब); क.पूर्णांकरखो(३,अब-२८८०००००); क.पूर्णांकरखो(४,अब-१८०००००);\n            लौटाओ क.अगला() && क.पाठलो(०)==स.उपयोगकर्ता() && सुरक्षा.समान(क.पाठलो(१),स.सीएसआरएफ());\n        } }\n    }\n    सार्वजनिक अधिलेखन फलन बदलो(पुराना: सत्र, उ: पाठ, भूमिकाएँ: सूची<पाठ>) -> सत्र {\n        यदि (!यह.आंतरिकजीवितहै(पुराना)) { फेंको नया वेबत्रुटि(४०१,\"सत्र उपलब्ध नहीं।\"); }\n        यह.हटाओ(पुराना); लौटाओ यह.आरंभ(उ,भूमिकाएँ);\n    }\n    सार्वजनिक अधिलेखन फलन हटाओ(स: सत्र) -> शून्य {\n        यह.जाँचो(); यदि (स==रिक्त) { लौटाओ; }\n        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार(\"DELETE FROM platform_sessions WHERE token_hash=? AND csrf=? AND user_id=?\"))"; }
    निजी साझा फलन अंश94() -> पाठ { लौटाओ " {\n            क.पाठरखो(१,डेटाचेकसम.शा२५६(स.पहचान())); क.पाठरखो(२,स.सीएसआरएफ()); क.पाठरखो(३,स.उपयोगकर्ता()); क.चलाओ();\n        } }\n    }\n    सार्वजनिक अधिलेखन फलन उपयोगकर्ताहटाओ(उ: पाठ) -> शून्य {\n        यह.जाँचो(); संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार(\"DELETE FROM platform_sessions WHERE user_id=?\")) { क.पाठरखो(१,उ); क.चलाओ(); } }\n    }\n    सार्वजनिक अधिलेखन फलन कुकीरखो(उ: वेबउत्तर, स: सत्र) -> शून्य {\n        यदि (!यह.आंतरिकजीवितहै(स)) { फेंको नया वेबत्रुटि(४०१,\"सत्र उपलब्ध नहीं।\"); }\n        यदि (विकासमोड) { उ.शीर्षजोड़ो(\"Set-Cookie\",यह.नाम()+\"=\"+स.पहचान()+\"; Path=/; HttpOnly; SameSite=Lax\"); }\n        अन्यथा { कुकी.सुरक्षितजोड़ो(उ,यह.नाम(),स.पहचान(),-१); } उ.शीर्षरखो(\"Cache-Control\",\"no-store\");\n    }\n    सार्वजनिक अधिलेखन फलन कुकीमिटाओ(उ: वेबउत्तर) -> शून्य {\n        यदि (विकासमोड) { उ.शीर्षजोड़ो(\"Set-Cookie\",यह.नाम()+\"=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0\"); }\n        अन्यथा { कुकी.सुरक्षितजोड़ो(उ,यह.नाम(),\"\",०); } उ.शीर्षरखो(\"Cache-Control\",\"no-store\");\n    }\n    सार्वजनिक अधिलेखन फलन आकार() -> पूर्णांक {\n        यह.साफकरो(); संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT COUNT(*) FROM platform_sessions\")) { क.अगला(); लौटाओ क.पूर्णांकलो(०); } }\n    }\n    सार्वजनिक अधिलेखन फलन साफकरो() -> शून्य {\n        यह.जाँचो(); स्थिर अब: पूर्णांक=समय.अभी();\n        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार(\"DELETE FROM platform_sessions WHERE born<=? OR touched<=?\")) { क.पूर्णांकरखो(१,अब-२८८०००००); क.पूर्णांकरखो(२,अब-१८०००००); क.चलाओ(); } }\n    }\n    सार्वजनिक अधिलेखन फलन बंदकरो() -> शून्य { सेवाबंद=सत्य; नीति.बंदकरो(); यदि (दूसरीनीति!=रिक्त) { दूसरीनीति.बंदकरो(); } आधार.बंदकरो(); }\n}\n"; }
    निजी साझा फलन अंश95() -> पाठ { लौटाओ "// SPDX-License-Identifier: Apache-2.0\nसंकुल अनुप्रयोग;\nआयात मानक.डेटासंबंध; आयात मानक.डेटाकथन; आयात मानक.डेटालेनदेन;\nआयात मानक.वेबत्रुटि; आयात मानक.सत्र; आयात मानक.समय; आयात मानक.डेटाचेकसम;\nआयात मानक.सुरक्षा;\n\nसार्वजनिक अभिलेख संगठनसंदर्भ(संगठन: पाठ, उपयोगकर्ता: पाठ, भूमिका: पाठ);\n\nसार्वजनिक वर्ग संगठननीति {\n    सार्वजनिक साझा फलन खाताजाँचो(ड: डेटासंबंध, स: सत्र) -> शून्य {\n        यदि (स==रिक्त || स.उपयोगकर्ता()==\"\") { फेंको नया वेबत्रुटि(४०१,\"प्रवेश आवश्यक।\"); }\n        स्थिर अब: पूर्णांक=समय.अभी();\n        संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT u.id FROM platform_users u JOIN platform_sessions s ON s.user_id=u.id WHERE u.id=? AND u.active=TRUE AND s.token_hash=? AND s.csrf=? AND s.born<=? AND s.born>? AND s.touched>?\")) {\n            क.पाठरखो(१,स.उपयोगकर्ता()); क.पाठरखो(२,डेटाचेकसम.शा२५६(स.पहचान())); क.पाठरखो(३,स.सीएसआरएफ()); क.पूर्णांकरखो(४,अब); क.पूर्णांकरखो(५,अब-२८८०००००); क.पूर्णांकरखो(६,अब-१८०००००);\n            यदि (!क.अगला()) { फेंको नया वेबत्रुटि(४०१,\"खाता उपलब्ध नहीं।\"); }\n        }\n    }\n    // Caller supplies an authenticated session, never a client-submitted user ID.\n    // Mutations call this after acquiring the tenant write lock in their transaction.\n    सार्वजनिक साझा फलन जाँचो(ड: डेटासंबंध, स: सत्र, संगठन: पाठ, लिखना: तार्किक, मालिक: तार्किक) -> संगठनसंदर्भ {\n        यदि (स==रिक्त || स.उपयोगकर्ता()==\"\") { फेंको नया वेबत्रुटि(४०१,\"प्रवेश आवश्यक।\"); }\n        स्थिर अब: पूर्णांक=समय.अभी();\n        संसाधन (क: डेटाकथन=ड.तैयार(\"SELECT m.role FROM platform_members m JOIN platform_users u ON u.id=m.user_id JOIN platform_tenants t ON t.id=m.tenant_id JOIN platform_sessions s ON s.user_id=m.user_id WHERE m.tenant_id=? AND m.user_id=? AND u.active=TRUE AND s.token_hash=? AND s.csrf=? AND s.born<=? AND s.born>? AND s.touched>?\")) {\n            क.पाठरखो(१,संगठन); क.पा"; }
    निजी साझा फलन अंश96() -> पाठ { लौटाओ "ठरखो(२,स.उपयोगकर्ता()); क.पाठरखो(३,डेटाचेकसम.शा२५६(स.पहचान())); क.पाठरखो(४,स.सीएसआरएफ());\n            क.पूर्णांकरखो(५,अब); क.पूर्णांकरखो(६,अब-२८८०००००); क.पूर्णांकरखो(७,अब-१८०००००);\n            यदि (!क.अगला()) { फेंको नया वेबत्रुटि(४०४,\"संगठन उपलब्ध नहीं।\"); }\n            स्थिर र: पाठ=क.पाठलो(०);\n            यदि ((लिखना && र==\"viewer\") || (मालिक && र!=\"owner\")) { फेंको नया वेबत्रुटि(४०३,\"अनुमति नहीं।\"); }\n            लौटाओ नया संगठनसंदर्भ(संगठन,स.उपयोगकर्ता(),र);\n        }\n    }\n    सार्वजनिक साझा फलन तालालो(ड: डेटासंबंध, संगठन: पाठ) -> शून्य {\n        संसाधन (क: डेटाकथन=ड.तैयार(\"UPDATE platform_tenants SET revision=revision+1 WHERE id=? AND revision<2147483647\")) { क.पाठरखो(१,संगठन); यदि (क.चलाओ()!=१) { फेंको नया वेबत्रुटि(४०४,\"संगठन उपलब्ध नहीं।\"); } }\n    }\n    सार्वजनिक साझा फलन लेखा(ड: डेटासंबंध, संदर्भ: संगठनसंदर्भ, क्रिया: पाठ, वस्तु: पाठ, पहचान: पाठ) -> शून्य {\n        संसाधन (क: डेटाकथन=ड.तैयार(\"INSERT INTO platform_audit(id,tenant_id,actor,action,entity,entity_id,created) VALUES (?,?,?,?,?,?,?)\")) {\n            क.पाठरखो(१,सुरक्षा.टोकन()); क.पाठरखो(२,संदर्भ.संगठन); क.पाठरखो(३,संदर्भ.उपयोगकर्ता); क.पाठरखो(४,क्रिया); क.पाठरखो(५,वस्तु); क.पाठरखो(६,पहचान); क.पूर्णांकरखो(७,समय.अभी()); क.चलाओ();\n        }\n    }\n}\n"; }
}
