    निजी साझा फलन अंश46() -> पाठ { लौटाओ "// SPDX-License-Identifier: Apache-2.0\nआयात अनुप्रयोग.मंच;\nआयात मानक.माइग्रेशन; आयात मानक.माइग्रेशनयोजना; आयात मानक.डेटासंबंध;\nवर्ग सीआरएमस्कीमा {\n    सार्वजनिक साझा फलन आरंभकरो(ड: डेटासंबंध) -> शून्य {\n        स्थिर बदलाव: सूची<माइग्रेशन> = मंच.माइग्रेशनलो();\n        बदलाव.जोड़ो(नया माइग्रेशन(२,\"CRM records\",नया सूची<पाठ>{\n            \"CREATE TABLE crm_records (tenant_id TEXT NOT NULL REFERENCES platform_tenants(id), id TEXT NOT NULL, kind TEXT NOT NULL CHECK (kind IN ('companies','contacts','deals','tasks')), name TEXT NOT NULL, email TEXT NOT NULL, phone TEXT NOT NULL, notes TEXT NOT NULL, related_id TEXT, stage TEXT NOT NULL, amount_minor BIGINT NOT NULL CHECK(amount_minor>=0), currency TEXT NOT NULL, due_date TEXT NOT NULL, version BIGINT NOT NULL, archived BOOLEAN NOT NULL, PRIMARY KEY(tenant_id,id), FOREIGN KEY(tenant_id,related_id) REFERENCES crm_records(tenant_id,id))\",\n            \"CREATE INDEX crm_records_list ON crm_records(tenant_id,kind,archived,name,id)\"\n        }));\n        बदलाव.जोड़ो(नया माइग्रेशन(३,\"User display languages\",नया सूची<पाठ>{\n            \"ALTER TABLE platform_users ADD COLUMN ui_language TEXT NOT NULL DEFAULT 'hi' CHECK (ui_language IN ('hi','en'))\",\n            \"ALTER TABLE platform_sessions ADD COLUMN display_language TEXT NOT NULL DEFAULT '' CHECK (display_language IN ('','hi','en'))\"\n        }));\n        बदलाव.जोड़ो(नया माइग्रेशन(४,\"Verified self-service signup\",नया सूची<पाठ>{\n            \"ALTER TABLE platform_users ADD COLUMN email TEXT\",\n            \"ALTER TABLE platform_users ADD COLUMN email_verified BOOLEAN NOT NULL DEFAULT FALSE\",\n            \"CREATE UNIQUE INDEX platform_users_email ON platform_users(email)\",\n            \"CREATE TABLE crm_email_verifications (token_hash TEXT PRIMARY KEY, email TEXT NOT NULL, language TEXT NOT NU"; }
    निजी साझा फलन अंश47() -> पाठ { लौटाओ "LL CHECK(language IN ('hi','en')), created BIGINT NOT NULL, expires BIGINT NOT NULL, sent BOOLEAN NOT NULL)\",\n            \"CREATE INDEX crm_email_verifications_email ON crm_email_verifications(email)\",\n            \"CREATE TABLE crm_signup_limits (key_hash TEXT PRIMARY KEY, started BIGINT NOT NULL, attempts BIGINT NOT NULL)\",\n            \"CREATE TABLE crm_captcha_tokens (token_hash TEXT PRIMARY KEY, expires BIGINT NOT NULL)\"\n        }));\n        स्थिर योजना: माइग्रेशनयोजना=नया माइग्रेशनयोजना(बदलाव); योजना.लागूकरो(ड);\n    }\n}\n"; }
    निजी साझा फलन अंश48() -> पाठ { लौटाओ "// SPDX-License-Identifier: Apache-2.0\nआयात अनुप्रयोग.दृश्य; आयात मानक.वेबउत्तर;\nवर्ग अनुवाद {\n    सार्वजनिक स्थिर भाषा: पाठ;\n    निजी स्थिर शब्दकोश: मानचित्र<पाठ,पाठ>;\n    निजी स्थिर अंग्रेज़ी: मानचित्र<पाठ,पाठ>;\n    निर्माता(भाषा: पाठ) {\n        सीआरएमभंडार.भाषाजाँचो(भाषा); यह.भाषा=भाषा; शब्दकोश=नया मानचित्र<पाठ,पाठ>(); अंग्रेज़ी=नया मानचित्र<पाठ,पाठ>();\n        अनुवाद.भाग१(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग२(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग३(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग४(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग५(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग६(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग७(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग८(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग९(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग१०(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग12(शब्दकोश,अंग्रेज़ी);\n        अनुवाद.भाग11(शब्दकोश,अंग्रेज़ी);\n    }\n    निजी साझा फलन भाग१(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"Account\"]=\"खाता\"; अंग्रेज़ी[\"खाता\"]=\"Account\";\n        शब्दकोश[\"Action\"]=\"क्रिया\"; अंग्रेज़ी[\"क्रिया\"]=\"Action\";\n        शब्दकोश[\"Active\"]=\"सक्रिय\"; अंग्रेज़ी[\"सक्रिय\"]=\"Active\";\n        शब्दकोश[\"Actor\"]=\"कर्ता\"; अंग्रेज़ी[\"कर्ता\"]=\"Actor\";\n        शब्दकोश[\"Add a member\"]=\"सदस्य जोड़ें\"; अंग्रेज़ी[\"सदस्य जोड़ें\"]=\"Add a member\";\n        शब्दकोश[\"Add member\"]=\"सदस्य जोड़ें\"; अंग्रेज़ी[\"सदस्य जोड़ें\"]=\"Add member\";\n        शब्दकोश[\"Add record\"]=\"रिकॉर्ड जोड़ें\"; अंग्रेज़ी[\"रिकॉर्ड जोड़ें\"]=\"Add record\";\n        शब्दकोश[\"Archive record\"]=\"रिकॉर्ड संग्रहित करें\"; अंग्रेज़ी[\"रिकॉर्ड संग्रहित करें\"]=\"Archive record\";\n        शब्दकोश[\"Archived\"]=\"संग्रहित\"; अंग्रेज़ी[\"संग्रहित\"]=\"Archived\";\n        शब्दकोश[\"Audit\"]=\"लेखा\"; अंग्रेज़ी[\"लेखा\"]=\"Audit\";\n        शब्दकोश[\"Audit trail\"]=\"बदलावों का लेखा\"; अंग्रेज़ी[\"बदलावों का लेखा\"]=\"Audit trai"; }
    निजी साझा फलन अंश49() -> पाठ { लौटाओ "l\";\n        शब्दकोश[\"Back to list\"]=\"सूची पर लौटें\"; अंग्रेज़ी[\"सूची पर लौटें\"]=\"Back to list\";\n        शब्दकोश[\"Browse, search and manage records.\"]=\"रिकॉर्ड देखें, खोजें और प्रबंधित करें।\"; अंग्रेज़ी[\"रिकॉर्ड देखें, खोजें और प्रबंधित करें।\"]=\"Browse, search and manage records.\";\n        शब्दकोश[\"Change password\"]=\"कूटशब्द बदलें\"; अंग्रेज़ी[\"कूटशब्द बदलें\"]=\"Change password\";\n        शब्दकोश[\"Change password and sign out\"]=\"कूटशब्द बदलें और बाहर निकलें\"; अंग्रेज़ी[\"कूटशब्द बदलें और बाहर निकलें\"]=\"Change password and sign out\";\n        शब्दकोश[\"Companies\"]=\"कंपनियाँ\"; अंग्रेज़ी[\"कंपनियाँ\"]=\"Companies\";\n        शब्दकोश[\"Company\"]=\"कंपनी\"; अंग्रेज़ी[\"कंपनी\"]=\"Company\";\n        शब्दकोश[\"Confirm new password\"]=\"नए कूटशब्द की पुष्टि\"; अंग्रेज़ी[\"नए कूटशब्द की पुष्टि\"]=\"Confirm new password\";\n        शब्दकोश[\"Contacts\"]=\"संपर्क\"; अंग्रेज़ी[\"संपर्क\"]=\"Contacts\";\n        शब्दकोश[\"Contacts, pipeline and follow-ups in one place.\"]=\"संपर्क, बिक्री के अवसर और अनुवर्ती कार्य एक स्थान पर।\"; अंग्रेज़ी[\"संपर्क, बिक्री के अवसर और अनुवर्ती कार्य एक स्थान पर।\"]=\"Contacts, pipeline and follow-ups in one place.\";\n    }\n    निजी साझा फलन भाग२(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"Create an organization\"]=\"संगठन बनाएँ\"; अंग्रेज़ी[\"संगठन बनाएँ\"]=\"Create an organization\";\n        शब्दकोश[\"Create organization\"]=\"संगठन बनाएँ\"; अंग्रेज़ी[\"संगठन बनाएँ\"]=\"Create organization\";\n        शब्दकोश[\"Currency\"]=\"मुद्रा\"; अंग्रेज़ी[\"मुद्रा\"]=\"Currency\";\n        शब्दकोश[\"Current password\"]=\"वर्तमान कूटशब्द\"; अंग्रेज़ी[\"वर्तमान कूटशब्द\"]=\"Current password\";\n        शब्दकोश[\"Current related record\"]=\"वर्तमान संबंधित रिकॉर्ड\"; अंग्रेज़ी[\"वर्तमान संबंधित रिकॉर्ड\"]=\"Current related record\";\n        शब्दकोश[\"Details\"]=\"विवरण\"; अंग्रेज़ी[\"विवरण\"]=\"Details\";\n        शब"; }
    निजी साझा फलन अंश50() -> पाठ { लौटाओ "्दकोश[\"Due date\"]=\"नियत तिथि\"; अंग्रेज़ी[\"नियत तिथि\"]=\"Due date\";\n        शब्दकोश[\"Email\"]=\"ईमेल\"; अंग्रेज़ी[\"ईमेल\"]=\"Email\";\n        शब्दकोश[\"Entity\"]=\"रिकॉर्ड का प्रकार\"; अंग्रेज़ी[\"रिकॉर्ड का प्रकार\"]=\"Entity\";\n        शब्दकोश[\"Language\"]=\"भाषा\"; अंग्रेज़ी[\"भाषा\"]=\"Language\";\n        शब्दकोश[\"Default language\"]=\"डिफ़ॉल्ट भाषा\"; अंग्रेज़ी[\"डिफ़ॉल्ट भाषा\"]=\"Default language\";\n        शब्दकोश[\"Display language\"]=\"प्रदर्शन की भाषा\"; अंग्रेज़ी[\"प्रदर्शन की भाषा\"]=\"Display language\";\n        शब्दकोश[\"Save language preference\"]=\"भाषा की पसंद सहेजें\"; अंग्रेज़ी[\"भाषा की पसंद सहेजें\"]=\"Save language preference\";\n        शब्दकोश[\"Language preference\"]=\"भाषा की पसंद\"; अंग्रेज़ी[\"भाषा की पसंद\"]=\"Language preference\";\n        शब्दकोश[\"Choose your default language. It is used whenever you sign in.\"]=\"अपनी डिफ़ॉल्ट भाषा चुनें। हर बार प्रवेश करने पर यही भाषा उपयोग होगी।\"; अंग्रेज़ी[\"अपनी डिफ़ॉल्ट भाषा चुनें। हर बार प्रवेश करने पर यही भाषा उपयोग होगी।\"]=\"Choose your default language. It is used whenever you sign in.\";\n        शब्दकोश[\"Switch\"]=\"बदलें\"; अंग्रेज़ी[\"बदलें\"]=\"Switch\";\n        शब्दकोश[\"Main navigation\"]=\"मुख्य नेविगेशन\"; अंग्रेज़ी[\"मुख्य नेविगेशन\"]=\"Main navigation\";\n        शब्दकोश[\"Members\"]=\"सदस्य\"; अंग्रेज़ी[\"सदस्य\"]=\"Members\";\n        शब्दकोश[\"Members & access\"]=\"सदस्य और अनुमतियाँ\"; अंग्रेज़ी[\"सदस्य और अनुमतियाँ\"]=\"Members & access\";\n        शब्दकोश[\"Name\"]=\"नाम\"; अंग्रेज़ी[\"नाम\"]=\"Name\";\n    }\n    निजी साझा फलन भाग३(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"New password\"]=\"नया कूटशब्द\"; अंग्रेज़ी[\"नया कूटशब्द\"]=\"New password\";\n        शब्दकोश[\"Next\"]=\"अगला\"; अंग्रेज़ी[\"अगला\"]=\"Next\";\n        शब्दकोश[\"No matching records.\"]=\"कोई मेल खाता रिकॉर्ड नहीं मिला।\"; अंग्रेज़ी[\"कोई मेल खाता रिकॉर्ड नहीं मिला।\"]=\"No matching records"; }
    निजी साझा फलन अंश51() -> पाठ { लौटाओ ".\";\n        शब्दकोश[\"None\"]=\"कोई नहीं\"; अंग्रेज़ी[\"कोई नहीं\"]=\"None\";\n        शब्दकोश[\"Notes\"]=\"टिप्पणियाँ\"; अंग्रेज़ी[\"टिप्पणियाँ\"]=\"Notes\";\n        शब्दकोश[\"Opportunities\"]=\"बिक्री के अवसर\"; अंग्रेज़ी[\"बिक्री के अवसर\"]=\"Opportunities\";\n        शब्दकोश[\"Organization name\"]=\"संगठन का नाम\"; अंग्रेज़ी[\"संगठन का नाम\"]=\"Organization name\";\n        शब्दकोश[\"Organizations\"]=\"संगठन\"; अंग्रेज़ी[\"संगठन\"]=\"Organizations\";\n        शब्दकोश[\"Overview\"]=\"अवलोकन\"; अंग्रेज़ी[\"अवलोकन\"]=\"Overview\";\n        शब्दकोश[\"Pagination\"]=\"पृष्ठ बदलें\"; अंग्रेज़ी[\"पृष्ठ बदलें\"]=\"Pagination\";\n        शब्दकोश[\"Password\"]=\"कूटशब्द\"; अंग्रेज़ी[\"कूटशब्द\"]=\"Password\";\n        शब्दकोश[\"Password for a NEW account only (12+ characters)\"]=\"केवल नए खाते का कूटशब्द (कम से कम १२ अक्षर)\"; अंग्रेज़ी[\"केवल नए खाते का कूटशब्द (कम से कम १२ अक्षर)\"]=\"Password for a NEW account only (12+ characters)\";\n        शब्दकोश[\"Phone\"]=\"फ़ोन\"; अंग्रेज़ी[\"फ़ोन\"]=\"Phone\";\n        शब्दकोश[\"Pipeline preview shows the first 50 opportunities. Open Opportunities to search and page through all records.\"]=\"पूर्वावलोकन में पहले ५० अवसर हैं। सभी रिकॉर्ड खोजने और उनके पृष्ठ देखने के लिए बिक्री के अवसर खोलें।\"; अंग्रेज़ी[\"पूर्वावलोकन में पहले ५० अवसर हैं। सभी रिकॉर्ड खोजने और उनके पृष्ठ देखने के लिए बिक्री के अवसर खोलें।\"]=\"Pipeline preview shows the first 50 opportunities. Open Opportunities to search and page through all records.\";\n        शब्दकोश[\"Previous\"]=\"पिछला\"; अंग्रेज़ी[\"पिछला\"]=\"Previous\";\n        शब्दकोश[\"Related contact\"]=\"संबंधित संपर्क\"; अंग्रेज़ी[\"संबंधित संपर्क\"]=\"Related contact\";\n        शब्दकोश[\"Remove member\"]=\"सदस्य हटाएँ\"; अंग्रेज़ी[\"सदस्य हटाएँ\"]=\"Remove member\";\n        शब्दकोश[\"Restore record\"]=\"रिकॉर्ड वापस लाएँ\"; अंग्रेज़ी[\"रिकॉर्ड वापस लाएँ\"]=\"Restore record\";\n        शब्दकोश[\"Role\"]=\"भूमिका\"; अंग्रेज़ी[\"भूमिका\""; }
    निजी साझा फलन अंश52() -> पाठ { लौटाओ "]=\"Role\";\n        शब्दकोश[\"Sales pipeline\"]=\"बिक्री के अवसरों की स्थिति\"; अंग्रेज़ी[\"बिक्री के अवसरों की स्थिति\"]=\"Sales pipeline\";\n    }\n    निजी साझा फलन भाग४(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"Save record\"]=\"रिकॉर्ड सहेजें\"; अंग्रेज़ी[\"रिकॉर्ड सहेजें\"]=\"Save record\";\n        शब्दकोश[\"Search\"]=\"खोजें\"; अंग्रेज़ी[\"खोजें\"]=\"Search\";\n        शब्दकोश[\"Search by name\"]=\"नाम से खोजें\"; अंग्रेज़ी[\"नाम से खोजें\"]=\"Search by name\";\n        शब्दकोश[\"Sign in\"]=\"प्रवेश करें\"; अंग्रेज़ी[\"प्रवेश करें\"]=\"Sign in\";\n        शब्दकोश[\"Sign in to manage your organizations, relationships and opportunities.\"]=\"अपने संगठन, संपर्क और बिक्री के अवसर सँभालने के लिए प्रवेश करें।\"; अंग्रेज़ी[\"अपने संगठन, संपर्क और बिक्री के अवसर सँभालने के लिए प्रवेश करें।\"]=\"Sign in to manage your organizations, relationships and opportunities.\";\n        शब्दकोश[\"Sign out\"]=\"बाहर निकलें\"; अंग्रेज़ी[\"बाहर निकलें\"]=\"Sign out\";\n        शब्दकोश[\"Status\"]=\"स्थिति\"; अंग्रेज़ी[\"स्थिति\"]=\"Status\";\n        शब्दकोश[\"Tasks\"]=\"कार्य\"; अंग्रेज़ी[\"कार्य\"]=\"Tasks\";\n        शब्दकोश[\"Time (UTC)\"]=\"समय (यूटीसी)\"; अंग्रेज़ी[\"समय (यूटीसी)\"]=\"Time (UTC)\";\n        शब्दकोश[\"Update role\"]=\"भूमिका बदलें\"; अंग्रेज़ी[\"भूमिका बदलें\"]=\"Update role\";\n        शब्दकोश[\"Use an existing username, or create a new account with a temporary password. Share credentials privately; the owner cannot reset an existing account's password here.\"]=\"मौजूदा उपयोगकर्ता नाम दें या अस्थायी कूटशब्द से नया खाता बनाएँ। प्रवेश विवरण निजी रूप से साझा करें। मालिक यहाँ किसी मौजूदा खाते का कूटशब्द नहीं बदल सकता।\"; अंग्रेज़ी[\"मौजूदा उपयोगकर्ता नाम दें या अस्थायी कूटशब्द से नया खाता बनाएँ। प्रवेश विवरण निजी रूप से साझा करें। मालिक यहाँ किसी मौजूदा खाते का कूटशब्द नहीं बदल सकता।\"]=\"Use an existing username, or create a ne"; }
    निजी साझा फलन अंश53() -> पाठ { लौटाओ "w account with a temporary password. Share credentials privately; the owner cannot reset an existing account's password here.\";\n        शब्दकोश[\"Use at least 12 characters. Changing your password signs out all your sessions, including this one.\"]=\"कम से कम १२ अक्षर दें। कूटशब्द बदलने पर इस सत्र सहित आपके सभी सत्र समाप्त होंगे।\"; अंग्रेज़ी[\"कम से कम १२ अक्षर दें। कूटशब्द बदलने पर इस सत्र सहित आपके सभी सत्र समाप्त होंगे।\"]=\"Use at least 12 characters. Changing your password signs out all your sessions, including this one.\";\n        शब्दकोश[\"Username\"]=\"उपयोगकर्ता नाम\"; अंग्रेज़ी[\"उपयोगकर्ता नाम\"]=\"Username\";\n        शब्दकोश[\"Value in minor units (e.g. 12500 = 125.00)\"]=\"राशि सबसे छोटी इकाई में (जैसे 12500 = 125.00)\"; अंग्रेज़ी[\"राशि सबसे छोटी इकाई में (जैसे 12500 = 125.00)\"]=\"Value in minor units (e.g. 12500 = 125.00)\";\n        शब्दकोश[\"Your account\"]=\"आपका खाता\"; अंग्रेज़ी[\"आपका खाता\"]=\"Your account\";\n        शब्दकोश[\"Your customer workspace\"]=\"आपके ग्राहक प्रबंधन का कार्यस्थल\"; अंग्रेज़ी[\"आपके ग्राहक प्रबंधन का कार्यस्थल\"]=\"Your customer workspace\";\n        शब्दकोश[\"Your organizations\"]=\"आपके संगठन\"; अंग्रेज़ी[\"आपके संगठन\"]=\"Your organizations\";\n        शब्दकोश[\" (first 50; existing selection retained)\"]=\" (पहले ५०; वर्तमान चयन सुरक्षित रहेगा)\"; अंग्रेज़ी[\" (पहले ५०; वर्तमान चयन सुरक्षित रहेगा)\"]=\" (first 50; existing selection retained)\";\n        शब्दकोश[\"Record\"]=\"रिकॉर्ड\"; अंग्रेज़ी[\"रिकॉर्ड\"]=\"Record\";\n        शब्दकोश[\"Request could not be completed\"]=\"अनुरोध पूरा नहीं हो सका\"; अंग्रेज़ी[\"अनुरोध पूरा नहीं हो सका\"]=\"Request could not be completed\";\n    }\n    निजी साझा फलन भाग५(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"Refresh the original page before trying again.\"]=\"फिर प्रयास करने से पहले मूल पृष्ठ दोबारा खोलें।\"; अंग्रेज"; }
    निजी साझा फलन अंश54() -> पाठ { लौटाओ "़ी[\"फिर प्रयास करने से पहले मूल पृष्ठ दोबारा खोलें।\"]=\"Refresh the original page before trying again.\";\n        शब्दकोश[\"Return to CRM\"]=\"सीआरएम पर लौटें\"; अंग्रेज़ी[\"सीआरएम पर लौटें\"]=\"Return to CRM\";\n        शब्दकोश[\"owner\"]=\"मालिक\"; अंग्रेज़ी[\"मालिक\"]=\"owner\";\n        शब्दकोश[\"editor\"]=\"संपादक\"; अंग्रेज़ी[\"संपादक\"]=\"editor\";\n        शब्दकोश[\"viewer\"]=\"पाठक\"; अंग्रेज़ी[\"पाठक\"]=\"viewer\";\n        शब्दकोश[\"open\"]=\"खुला\"; अंग्रेज़ी[\"खुला\"]=\"open\";\n        शब्दकोश[\"active\"]=\"सक्रिय\"; अंग्रेज़ी[\"सक्रिय\"]=\"active\";\n        शब्दकोश[\"inactive\"]=\"निष्क्रिय\"; अंग्रेज़ी[\"निष्क्रिय\"]=\"inactive\";\n        शब्दकोश[\"won\"]=\"सफल\"; अंग्रेज़ी[\"सफल\"]=\"won\";\n        शब्दकोश[\"lost\"]=\"असफल\"; अंग्रेज़ी[\"असफल\"]=\"lost\";\n        शब्दकोश[\"done\"]=\"पूरा\"; अंग्रेज़ी[\"पूरा\"]=\"done\";\n        शब्दकोश[\"companies\"]=\"कंपनियाँ\"; अंग्रेज़ी[\"कंपनियाँ\"]=\"companies\";\n        शब्दकोश[\"contacts\"]=\"संपर्क\"; अंग्रेज़ी[\"संपर्क\"]=\"contacts\";\n        शब्दकोश[\"deals\"]=\"अवसर\"; अंग्रेज़ी[\"अवसर\"]=\"deals\";\n        शब्दकोश[\"tasks\"]=\"कार्य\"; अंग्रेज़ी[\"कार्य\"]=\"tasks\";\n        शब्दकोश[\"tenant\"]=\"संगठन\"; अंग्रेज़ी[\"संगठन\"]=\"tenant\";\n        शब्दकोश[\"user\"]=\"उपयोगकर्ता\"; अंग्रेज़ी[\"उपयोगकर्ता\"]=\"user\";\n        शब्दकोश[\"create\"]=\"बनाया\"; अंग्रेज़ी[\"बनाया\"]=\"create\";\n        शब्दकोश[\"update\"]=\"बदला\"; अंग्रेज़ी[\"बदला\"]=\"update\";\n        शब्दकोश[\"archive\"]=\"संग्रहित किया\"; अंग्रेज़ी[\"संग्रहित किया\"]=\"archive\";\n    }\n    निजी साझा फलन भाग६(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"restore\"]=\"वापस लाया\"; अंग्रेज़ी[\"वापस लाया\"]=\"restore\";\n        शब्दकोश[\"membership\"]=\"सदस्यता बदली\"; अंग्रेज़ी[\"सदस्यता बदली\"]=\"membership\";\n        शब्दकोश[\"Unsupported language.\"]=\"असमर्थित भाषा।\"; अंग्रेज़ी[\"असमर्थित भाषा।\"]=\"Unsupported language.\";\n        शब्दकोश[\"Session is unavailable.\"]=\"सत्र उपलब्ध नह"; }
    निजी साझा फलन अंश55() -> पाठ { लौटाओ "ीं।\"; अंग्रेज़ी[\"सत्र उपलब्ध नहीं।\"]=\"Session is unavailable.\";\n        शब्दकोश[\"Please sign in.\"]=\"प्रवेश आवश्यक।\"; अंग्रेज़ी[\"प्रवेश आवश्यक।\"]=\"Please sign in.\";\n        शब्दकोश[\"Account is unavailable.\"]=\"खाता उपलब्ध नहीं।\"; अंग्रेज़ी[\"खाता उपलब्ध नहीं।\"]=\"Account is unavailable.\";\n        शब्दकोश[\"Sign-in failed.\"]=\"प्रवेश असफल।\"; अंग्रेज़ी[\"प्रवेश असफल।\"]=\"Sign-in failed.\";\n        शब्दकोश[\"Permission denied.\"]=\"अनुमति नहीं।\"; अंग्रेज़ी[\"अनुमति नहीं।\"]=\"Permission denied.\";\n        शब्दकोश[\"Organization is unavailable.\"]=\"संगठन उपलब्ध नहीं।\"; अंग्रेज़ी[\"संगठन उपलब्ध नहीं।\"]=\"Organization is unavailable.\";\n        शब्दकोश[\"Invalid name.\"]=\"अमान्य नाम।\"; अंग्रेज़ी[\"अमान्य नाम।\"]=\"Invalid name.\";\n        शब्दकोश[\"Record is unavailable.\"]=\"रिकॉर्ड उपलब्ध नहीं।\"; अंग्रेज़ी[\"रिकॉर्ड उपलब्ध नहीं।\"]=\"Record is unavailable.\";\n        शब्दकोश[\"This record changed. Reload it before editing.\"]=\"रिकॉर्ड बदल गया।\"; अंग्रेज़ी[\"रिकॉर्ड बदल गया।\"]=\"This record changed. Reload it before editing.\";\n        शब्दकोश[\"Unlink or archive active related records first.\"]=\"सक्रिय संबंधित रिकॉर्ड पहले अलग करें।\"; अंग्रेज़ी[\"सक्रिय संबंधित रिकॉर्ड पहले अलग करें।\"]=\"Unlink or archive active related records first.\";\n        शब्दकोश[\"Restore the related record first.\"]=\"संबंधित रिकॉर्ड पहले वापस लाएँ।\"; अंग्रेज़ी[\"संबंधित रिकॉर्ड पहले वापस लाएँ।\"]=\"Restore the related record first.\";\n        शब्दकोश[\"Invalid relationship.\"]=\"अमान्य संबंध।\"; अंग्रेज़ी[\"अमान्य संबंध।\"]=\"Invalid relationship.\";\n        शब्दकोश[\"Select an active related record in this organization.\"]=\"संबंध इसी संगठन के सक्रिय रिकॉर्ड से चाहिए।\"; अंग्रेज़ी[\"संबंध इसी संगठन के सक्रिय रिकॉर्ड से चाहिए।\"]=\"Select an active related record in this organization.\";\n        शब्दकोश[\"An organization must retain at least one owner.\"]=\"कम से कम"; }
    निजी साझा फलन अंश56() -> पाठ { लौटाओ " एक मालिक चाहिए।\"; अंग्रेज़ी[\"कम से कम एक मालिक चाहिए।\"]=\"An organization must retain at least one owner.\";\n        शब्दकोश[\"Member is unavailable.\"]=\"सदस्य उपलब्ध नहीं।\"; अंग्रेज़ी[\"सदस्य उपलब्ध नहीं।\"]=\"Member is unavailable.\";\n        शब्दकोश[\"Invalid role.\"]=\"अमान्य भूमिका।\"; अंग्रेज़ी[\"अमान्य भूमिका।\"]=\"Invalid role.\";\n        शब्दकोश[\"Provide a password for the new account.\"]=\"नए खाते के लिए कूटशब्द दें।\"; अंग्रेज़ी[\"नए खाते के लिए कूटशब्द दें।\"]=\"Provide a password for the new account.\";\n    }\n    निजी साझा फलन भाग७(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"An existing account's password cannot be changed here.\"]=\"मौजूदा खाते का कूटशब्द यहाँ नहीं बदलता।\"; अंग्रेज़ी[\"मौजूदा खाते का कूटशब्द यहाँ नहीं बदलता।\"]=\"An existing account's password cannot be changed here.\";\n        शब्दकोश[\"Member limit reached.\"]=\"सदस्य सीमा।\"; अंग्रेज़ी[\"सदस्य सीमा।\"]=\"Member limit reached.\";\n        शब्दकोश[\"Account limit reached.\"]=\"खाता सीमा।\"; अंग्रेज़ी[\"खाता सीमा।\"]=\"Account limit reached.\";\n        शब्दकोश[\"Organization limit reached.\"]=\"संगठन क्षमता।\"; अंग्रेज़ी[\"संगठन क्षमता।\"]=\"Organization limit reached.\";\n        शब्दकोश[\"Owned organization limit reached.\"]=\"मालिक संगठन सीमा।\"; अंग्रेज़ी[\"मालिक संगठन सीमा।\"]=\"Owned organization limit reached.\";\n        शब्दकोश[\"Organization record limit reached.\"]=\"संगठन रिकॉर्ड सीमा।\"; अंग्रेज़ी[\"संगठन रिकॉर्ड सीमा।\"]=\"Organization record limit reached.\";\n        शब्दकोश[\"The current password is incorrect.\"]=\"वर्तमान कूटशब्द गलत है।\"; अंग्रेज़ी[\"वर्तमान कूटशब्द गलत है।\"]=\"The current password is incorrect.\";\n        शब्दकोश[\"The account changed. Please sign in again.\"]=\"खाता बदल गया; फिर प्रवेश करें।\"; अंग्रेज़ी[\"खाता बदल गया; फिर प्रवेश करें।\"]=\"The account changed. Please sign in again.\";\n        "; }
    निजी साझा फलन अंश57() -> पाठ { लौटाओ "शब्दकोश[\"Use at least 12 characters and at most 1024 UTF-8 bytes for the password.\"]=\"कूटशब्द कम से कम १२ अक्षर और अधिकतम १०२४ UTF-8 बाइट चाहिए।\"; अंग्रेज़ी[\"कूटशब्द कम से कम १२ अक्षर और अधिकतम १०२४ UTF-8 बाइट चाहिए।\"]=\"Use at least 12 characters and at most 1024 UTF-8 bytes for the password.\";\n        शब्दकोश[\"Usernames must contain 3-64 characters.\"]=\"खाता ३–६४ अक्षर चाहिए।\"; अंग्रेज़ी[\"खाता ३–६४ अक्षर चाहिए।\"]=\"Usernames must contain 3-64 characters.\";\n        शब्दकोश[\"Use lowercase Latin letters, digits, dot, underscore or hyphen in usernames.\"]=\"खाते में छोटे Latin अक्षर, अंक, . _ - दें।\"; अंग्रेज़ी[\"खाते में छोटे Latin अक्षर, अंक, . _ - दें।\"]=\"Use lowercase Latin letters, digits, dot, underscore or hyphen in usernames.\";\n        शब्दकोश[\"Invalid CRM record type.\"]=\"अमान्य CRM प्रकार।\"; अंग्रेज़ी[\"अमान्य CRM प्रकार।\"]=\"Invalid CRM record type.\";\n        शब्दकोश[\"Field is too large.\"]=\"क्षेत्र बहुत बड़ा।\"; अंग्रेज़ी[\"क्षेत्र बहुत बड़ा।\"]=\"Field is too large.\";\n        शब्दकोश[\"Duplicate pagination field.\"]=\"दोहरा पृष्ठ।\"; अंग्रेज़ी[\"दोहरा पृष्ठ।\"]=\"Duplicate pagination field.\";\n        शब्दकोश[\"Duplicate search field.\"]=\"दोहरी खोज।\"; अंग्रेज़ी[\"दोहरी खोज।\"]=\"Duplicate search field.\";\n        शब्दकोश[\"Search text is too large.\"]=\"खोज बहुत बड़ी।\"; अंग्रेज़ी[\"खोज बहुत बड़ी।\"]=\"Search text is too large.\";\n        शब्दकोश[\"Duplicate archive filter.\"]=\"दोहरा संग्रह।\"; अंग्रेज़ी[\"दोहरा संग्रह।\"]=\"Duplicate archive filter.\";\n        शब्दकोश[\"Unknown record field.\"]=\"अज्ञात रिकॉर्ड क्षेत्र।\"; अंग्रेज़ी[\"अज्ञात रिकॉर्ड क्षेत्र।\"]=\"Unknown record field.\";\n        शब्दकोश[\"Invalid status.\"]=\"अमान्य स्थिति।\"; अंग्रेज़ी[\"अमान्य स्थिति।\"]=\"Invalid status.\";\n        शब्दकोश[\"Invalid currency.\"]=\"अमान्य मुद्रा।\"; अंग्रेज़ी[\"अमान्य मुद्रा।\"]=\"Invalid currency.\";\n    }\n    निजी साझा "; }
    निजी साझा फलन अंश58() -> पाठ { लौटाओ "फलन भाग८(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"Invalid date.\"]=\"अमान्य तिथि।\"; अंग्रेज़ी[\"अमान्य तिथि।\"]=\"Invalid date.\";\n        शब्दकोश[\"Invalid email address.\"]=\"अमान्य ईमेल।\"; अंग्रेज़ी[\"अमान्य ईमेल।\"]=\"Invalid email address.\";\n        शब्दकोश[\"Invalid password.\"]=\"अमान्य कूटशब्द।\"; अंग्रेज़ी[\"अमान्य कूटशब्द।\"]=\"Invalid password.\";\n        शब्दकोश[\"Check password confirmation and length.\"]=\"कूटशब्द पुष्टि और सीमा जाँचें।\"; अंग्रेज़ी[\"कूटशब्द पुष्टि और सीमा जाँचें।\"]=\"Check password confirmation and length.\";\n        शब्दकोश[\"Invalid action.\"]=\"अमान्य क्रिया।\"; अंग्रेज़ी[\"अमान्य क्रिया।\"]=\"Invalid action.\";\n        शब्दकोश[\"Invalid archive state.\"]=\"अमान्य संग्रह स्थिति।\"; अंग्रेज़ी[\"अमान्य संग्रह स्थिति।\"]=\"Invalid archive state.\";\n        शब्दकोश[\"A required field is missing.\"]=\"अनिवार्य क्षेत्र अनुपस्थित।\"; अंग्रेज़ी[\"अनिवार्य क्षेत्र अनुपस्थित।\"]=\"A required field is missing.\";\n        शब्दकोश[\"Field value is outside the allowed limits.\"]=\"क्षेत्र सीमा से बाहर।\"; अंग्रेज़ी[\"क्षेत्र सीमा से बाहर।\"]=\"Field value is outside the allowed limits.\";\n        शब्दकोश[\"Too many sign-in attempts. Try again later.\"]=\"प्रवेश प्रयास सीमा।\"; अंग्रेज़ी[\"प्रवेश प्रयास सीमा।\"]=\"Too many sign-in attempts. Try again later.\";\n        शब्दकोश[\"Sign-in limit capacity reached. Try again later.\"]=\"प्रवेश प्रयास क्षमता।\"; अंग्रेज़ी[\"प्रवेश प्रयास क्षमता।\"]=\"Sign-in limit capacity reached. Try again later.\";\n        शब्दकोश[\"Request origin is not allowed.\"]=\"अनुरोध मूल अस्वीकार है।\"; अंग्रेज़ी[\"अनुरोध मूल अस्वीकार है।\"]=\"Request origin is not allowed.\";\n        शब्दकोश[\"CSRF validation failed. Refresh the page.\"]=\"CSRF सुरक्षा जाँच असफल।\"; अंग्रेज़ी[\"CSRF सुरक्षा जाँच असफल।\"]=\"CSRF validation failed. Refresh the page.\";\n        शब्दकोश[\"Do no"; }
    निजी साझा फलन अंश59() -> पाठ { लौटाओ "t send multiple CSRF token sources.\"]=\"मिश्रित CSRF टोकन।\"; अंग्रेज़ी[\"मिश्रित CSRF टोकन।\"]=\"Do not send multiple CSRF token sources.\";\n        शब्दकोश[\"A CSRF token is required.\"]=\"CSRF टोकन चाहिए।\"; अंग्रेज़ी[\"CSRF टोकन चाहिए।\"]=\"A CSRF token is required.\";\n        शब्दकोश[\"Invalid form encoding.\"]=\"अमान्य फॉर्म कूट।\"; अंग्रेज़ी[\"अमान्य फॉर्म कूट।\"]=\"Invalid form encoding.\";\n        शब्दकोश[\"Invalid character in form data.\"]=\"अमान्य फॉर्म अक्षर।\"; अंग्रेज़ी[\"अमान्य फॉर्म अक्षर।\"]=\"Invalid character in form data.\";\n        शब्दकोश[\"Form data must be valid UTF-8.\"]=\"फॉर्म शुद्ध UTF-8 चाहिए।\"; अंग्रेज़ी[\"फॉर्म शुद्ध UTF-8 चाहिए।\"]=\"Form data must be valid UTF-8.\";\n        शब्दकोश[\"URL-encoded form data is required.\"]=\"URL encoded फॉर्म चाहिए।\"; अंग्रेज़ी[\"URL encoded फॉर्म चाहिए।\"]=\"URL-encoded form data is required.\";\n        शब्दकोश[\"UTF-8 URL-encoded form data is required.\"]=\"UTF-8 URL encoded फॉर्म चाहिए।\"; अंग्रेज़ी[\"UTF-8 URL encoded फॉर्म चाहिए।\"]=\"UTF-8 URL-encoded form data is required.\";\n        शब्दकोश[\"Form data is too large.\"]=\"फॉर्म बहुत बड़ा है।\"; अंग्रेज़ी[\"फॉर्म बहुत बड़ा है।\"]=\"Form data is too large.\";\n    }\n    निजी साझा फलन भाग९(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"Duplicate or oversized form field.\"]=\"दोहरा या सीमा से बाहर फॉर्म क्षेत्र।\"; अंग्रेज़ी[\"दोहरा या सीमा से बाहर फॉर्म क्षेत्र।\"]=\"Duplicate or oversized form field.\";\n        शब्दकोश[\"Invalid numeric value.\"]=\"अमान्य HTTP अंक।\"; अंग्रेज़ी[\"अमान्य HTTP अंक।\"]=\"Invalid numeric value.\";\n        शब्दकोश[\"Return path must stay in this app.\"]=\"वापसी का पथ इसी ऐप में होना चाहिए।\"; अंग्रेज़ी[\"वापसी का पथ इसी ऐप में होना चाहिए।\"]=\"Return path must stay in this app.\";\n        शब्दकोश[\"Bhash · CRM\"]=\"भाष · सीआरएम\"; अंग्रेज़ी[\"भाष · सीआरएम\"]=\"Bhash · CRM\""; }
    निजी साझा फलन अंश60() -> पाठ { लौटाओ ";\n    }\n    निजी साझा फलन भाग१०(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"Copy code\"]=\"कोड कॉपी करें\"; अंग्रेज़ी[\"कोड कॉपी करें\"]=\"Copy code\";\n        शब्दकोश[\"Copied\"]=\"कॉपी हो गया\"; अंग्रेज़ी[\"कॉपी हो गया\"]=\"Copied\";\n        शब्दकोश[\"Copy unavailable. Code selected; press Ctrl+C or Command+C.\"]=\"कॉपी उपलब्ध नहीं। कोड चुना गया है; Ctrl+C या Command+C दबाएँ।\"; अंग्रेज़ी[\"कॉपी उपलब्ध नहीं। कोड चुना गया है; Ctrl+C या Command+C दबाएँ।\"]=\"Copy unavailable. Code selected; press Ctrl+C or Command+C.\";\n\n        शब्दकोश[\"Page not found.\"]=\"पृष्ठ उपलब्ध नहीं है।\"; अंग्रेज़ी[\"पृष्ठ उपलब्ध नहीं है।\"]=\"Page not found.\";\n        शब्दकोश[\"Method not allowed.\"]=\"यह अनुरोध विधि अनुमत नहीं है।\"; अंग्रेज़ी[\"यह अनुरोध विधि अनुमत नहीं है।\"]=\"Method not allowed.\";\n        शब्दकोश[\"Source page unavailable.\"]=\"स्रोत पृष्ठ उपलब्ध नहीं।\"; अंग्रेज़ी[\"स्रोत पृष्ठ उपलब्ध नहीं।\"]=\"Source page unavailable.\";\n        शब्दकोश[\"View Bhash source\"]=\"भाष स्रोत देखें\"; अंग्रेज़ी[\"भाष स्रोत देखें\"]=\"View Bhash source\";\n        शब्दकोश[\"Close source view\"]=\"स्रोत दृश्य बंद करें\"; अंग्रेज़ी[\"स्रोत दृश्य बंद करें\"]=\"Close source view\";\n        शब्दकोश[\"Bhash source for this page\"]=\"इस पृष्ठ का भाष स्रोत\"; अंग्रेज़ी[\"इस पृष्ठ का भाष स्रोत\"]=\"Bhash source for this page\";\n        शब्दकोश[\"Frontend Bhash\"]=\"फ्रंटएंड भाष\"; अंग्रेज़ी[\"फ्रंटएंड भाष\"]=\"Frontend Bhash\";\n        शब्दकोश[\"Backend Bhash\"]=\"बैकएंड भाष\"; अंग्रेज़ी[\"बैकएंड भाष\"]=\"Backend Bhash\";\n        शब्दकोश[\"This page\"]=\"यह पृष्ठ\"; अंग्रेज़ी[\"यह पृष्ठ\"]=\"This page\";\n        शब्दकोश[\"Shared page layout\"]=\"साझा पृष्ठ संरचना\"; अंग्रेज़ी[\"साझा पृष्ठ संरचना\"]=\"Shared page layout\";\n        शब्दकोश[\"Request handlers\"]=\"अनुरोध हैंडलर\"; अंग्रेज़ी[\"अनुरोध हैंडलर\"]=\"Request handlers\";\n        शब्दकोश[\"Record validation\"]"; }
    निजी साझा फलन अंश61() -> पाठ { लौटाओ "=\"रिकॉर्ड सत्यापन\"; अंग्रेज़ी[\"रिकॉर्ड सत्यापन\"]=\"Record validation\";\n        शब्दकोश[\"Read the Bhash source used by this running app. Opening or closing this panel keeps your page and unsaved entries in place.\"]=\"इस चल रहे ऐप का भाष स्रोत पढ़ें। इस पैनल को खोलने या बंद करने पर आपका पृष्ठ और बिना सहेजी प्रविष्टियाँ बनी रहती हैं।\"; अंग्रेज़ी[\"इस चल रहे ऐप का भाष स्रोत पढ़ें। इस पैनल को खोलने या बंद करने पर आपका पृष्ठ और बिना सहेजी प्रविष्टियाँ बनी रहती हैं।\"]=\"Read the Bhash source used by this running app. Opening or closing this panel keeps your page and unsaved entries in place.\";\n    }\n    निजी साझा फलन भाग11(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"Create an account\"]=\"खाता बनाएँ\"; अंग्रेज़ी[\"खाता बनाएँ\"]=\"Create an account\";\n        शब्दकोश[\"Send verification email\"]=\"सत्यापन ईमेल भेजें\"; अंग्रेज़ी[\"सत्यापन ईमेल भेजें\"]=\"Send verification email\";\n        शब्दकोश[\"Check your email\"]=\"अपना ईमेल देखें\"; अंग्रेज़ी[\"अपना ईमेल देखें\"]=\"Check your email\";\n        शब्दकोश[\"Pass the bot check and verify your email. Then choose your username and password.\"]=\"बॉट जाँच पूरी करके अपना ईमेल सत्यापित करें। फिर उपयोगकर्ता नाम और कूटशब्द चुनें।\"; अंग्रेज़ी[\"बॉट जाँच पूरी करके अपना ईमेल सत्यापित करें। फिर उपयोगकर्ता नाम और कूटशब्द चुनें।\"]=\"Pass the bot check and verify your email. Then choose your username and password.\";\n        शब्दकोश[\"If this email can be used, a verification link has been sent. Check your inbox and spam folder. Links expire in 30 minutes.\"]=\"यदि यह ईमेल उपयोग किया जा सकता है, तो सत्यापन लिंक भेज दिया गया है। इनबॉक्स और स्पैम फ़ोल्डर देखें। लिंक ३० मिनट में समाप्त हो जाता है।\"; अंग्रेज़ी[\"यदि यह ईमेल उपयोग किया जा सकता है, तो सत्यापन लिंक भेज दिया गया है। इनबॉक्स और स्पैम फ़ोल्डर देखें। लिंक ३० मिनट में समाप्त हो जात"; }
    निजी साझा फलन अंश62() -> पाठ { लौटाओ "ा है।\"]=\"If this email can be used, a verification link has been sent. Check your inbox and spam folder. Links expire in 30 minutes.\";\n        शब्दकोश[\"Send another verification email\"]=\"सत्यापन ईमेल फिर भेजें\"; अंग्रेज़ी[\"सत्यापन ईमेल फिर भेजें\"]=\"Send another verification email\";\n        शब्दकोश[\"Finish creating your account\"]=\"अपना खाता बनाना पूरा करें\"; अंग्रेज़ी[\"अपना खाता बनाना पूरा करें\"]=\"Finish creating your account\";\n        शब्दकोश[\"Confirm password\"]=\"कूटशब्द की पुष्टि करें\"; अंग्रेज़ी[\"कूटशब्द की पुष्टि करें\"]=\"Confirm password\";\n        शब्दकोश[\"Create verified account\"]=\"सत्यापित खाता बनाएँ\"; अंग्रेज़ी[\"सत्यापित खाता बनाएँ\"]=\"Create verified account\";\n        शब्दकोश[\"Choose a password with at least 12 characters. Your account will have its own organization.\"]=\"कम से कम १२ अक्षरों का कूटशब्द चुनें। आपके खाते का अपना संगठन होगा।\"; अंग्रेज़ी[\"कम से कम १२ अक्षरों का कूटशब्द चुनें। आपके खाते का अपना संगठन होगा।\"]=\"Choose a password with at least 12 characters. Your account will have its own organization.\";\n        शब्दकोश[\"Enter a valid email address.\"]=\"मान्य ईमेल पता दें।\"; अंग्रेज़ी[\"मान्य ईमेल पता दें।\"]=\"Enter a valid email address.\";\n        शब्दकोश[\"Account registration is temporarily unavailable.\"]=\"अभी नया खाता बनाना उपलब्ध नहीं है।\"; अंग्रेज़ी[\"अभी नया खाता बनाना उपलब्ध नहीं है।\"]=\"Account registration is temporarily unavailable.\";\n        शब्दकोश[\"Complete the bot check and try again.\"]=\"बॉट जाँच पूरी करके फिर प्रयास करें।\"; अंग्रेज़ी[\"बॉट जाँच पूरी करके फिर प्रयास करें।\"]=\"Complete the bot check and try again.\";\n        शब्दकोश[\"Bot verification is unavailable. Try again later.\"]=\"अभी बॉट सत्यापन उपलब्ध नहीं है। बाद में प्रयास करें।\"; अंग्रेज़ी[\"अभी बॉट सत्यापन उपलब्ध नहीं है। बाद में प्रयास करें।\"]=\"Bot verification is unavailable. Try again late"; }
    निजी साझा फलन अंश63() -> पाठ { लौटाओ "r.\";\n        शब्दकोश[\"Too many signup attempts. Try again later.\"]=\"खाता बनाने के बहुत अधिक प्रयास हुए हैं। बाद में प्रयास करें।\"; अंग्रेज़ी[\"खाता बनाने के बहुत अधिक प्रयास हुए हैं। बाद में प्रयास करें।\"]=\"Too many signup attempts. Try again later.\";\n    }\n    निजी साझा फलन भाग12(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {\n        शब्दकोश[\"Verification email could not be sent. Try again later.\"]=\"सत्यापन ईमेल नहीं भेजा जा सका। बाद में प्रयास करें।\"; अंग्रेज़ी[\"सत्यापन ईमेल नहीं भेजा जा सका। बाद में प्रयास करें।\"]=\"Verification email could not be sent. Try again later.\";\n        शब्दकोश[\"Verification link is invalid or expired. Request a new email.\"]=\"सत्यापन लिंक अमान्य है या समाप्त हो गया है। नया ईमेल माँगें।\"; अंग्रेज़ी[\"सत्यापन लिंक अमान्य है या समाप्त हो गया है। नया ईमेल माँगें।\"]=\"Verification link is invalid or expired. Request a new email.\";\n        शब्दकोश[\"Enter an organization name.\"]=\"संगठन का नाम दें।\"; अंग्रेज़ी[\"संगठन का नाम दें।\"]=\"Enter an organization name.\";\n        शब्दकोश[\"Username or email is already registered. Sign in or choose another username.\"]=\"उपयोगकर्ता नाम या ईमेल पहले से पंजीकृत है। प्रवेश करें या दूसरा उपयोगकर्ता नाम चुनें।\"; अंग्रेज़ी[\"उपयोगकर्ता नाम या ईमेल पहले से पंजीकृत है। प्रवेश करें या दूसरा उपयोगकर्ता नाम चुनें।\"]=\"Username or email is already registered. Sign in or choose another username.\";\n        शब्दकोश[\"Account capacity reached.\"]=\"खातों की क्षमता पूरी हो गई है।\"; अंग्रेज़ी[\"खातों की क्षमता पूरी हो गई है।\"]=\"Account capacity reached.\";\n        शब्दकोश[\"Organization capacity reached.\"]=\"संगठनों की क्षमता पूरी हो गई है।\"; अंग्रेज़ी[\"संगठनों की क्षमता पूरी हो गई है।\"]=\"Organization capacity reached.\";\n        शब्दकोश[\"Sign out before creating another account.\"]=\"दूसरा खाता बनाने से पहले बाहर निकलें।\"; "; }
    निजी साझा फलन अंश64() -> पाठ { लौटाओ "अंग्रेज़ी[\"दूसरा खाता बनाने से पहले बाहर निकलें।\"]=\"Sign out before creating another account.\";\n        शब्दकोश[\"Unexpected signup field.\"]=\"खाता बनाने का अज्ञात क्षेत्र मिला।\"; अंग्रेज़ी[\"खाता बनाने का अज्ञात क्षेत्र मिला।\"]=\"Unexpected signup field.\";\n        शब्दकोश[\"Passwords must match.\"]=\"दोनों कूटशब्द एक जैसे होने चाहिए।\"; अंग्रेज़ी[\"दोनों कूटशब्द एक जैसे होने चाहिए।\"]=\"Passwords must match.\";\n        शब्दकोश[\"Verify your Bhash CRM email\"]=\"अपना भाष सीआरएम ईमेल सत्यापित करें\"; अंग्रेज़ी[\"अपना भाष सीआरएम ईमेल सत्यापित करें\"]=\"Verify your Bhash CRM email\";\n        शब्दकोश[\"Open this link to verify your email and finish creating your account. The link expires in 30 minutes.\"]=\"ईमेल सत्यापित करके खाता बनाना पूरा करने के लिए यह लिंक खोलें। लिंक ३० मिनट में समाप्त हो जाता है।\"; अंग्रेज़ी[\"ईमेल सत्यापित करके खाता बनाना पूरा करने के लिए यह लिंक खोलें। लिंक ३० मिनट में समाप्त हो जाता है।\"]=\"Open this link to verify your email and finish creating your account. The link expires in 30 minutes.\";\n        शब्दकोश[\"If you did not request this email, you can ignore it.\"]=\"यदि आपने यह ईमेल नहीं माँगा था, तो इसे अनदेखा कर सकते हैं।\"; अंग्रेज़ी[\"यदि आपने यह ईमेल नहीं माँगा था, तो इसे अनदेखा कर सकते हैं।\"]=\"If you did not request this email, you can ignore it.\";\n    }\n    सार्वजनिक फलन पाठलो(कुंजी: पाठ) -> पाठ {\n        यदि (भाषा==\"hi\" && शब्दकोश.है(कुंजी)) { लौटाओ शब्दकोश[कुंजी]; }\n        यदि (भाषा==\"en\" && अंग्रेज़ी.है(कुंजी)) { लौटाओ अंग्रेज़ी[कुंजी]; } लौटाओ कुंजी;\n    }\n    सार्वजनिक फलन नोड(नाम: पाठ, कुंजी: पाठ) -> दृश्य { लौटाओ दृश्य.शब्द(नाम,यह.पाठलो(कुंजी)); }\n    सार्वजनिक फलन कड़ी(पथ: पाठ, कुंजी: पाठ) -> दृश्य { लौटाओ दृश्य.कड़ी(पथ,यह.पाठलो(कुंजी)); }\n    सार्वजनिक फलन क्षेत्र(नाम: पाठ, कुंजी: पाठ, प्रकार: पाठ, मानक: पाठ) -> दृश्य { लौटाओ दृश्य.क्षेत्र(नाम,यह.पाठलो(कुंजी"; }
    निजी साझा फलन अंश65() -> पाठ { लौटाओ "),प्रकार,मानक); }\n    सार्वजनिक फलन भेजो(कुंजी: पाठ) -> दृश्य { लौटाओ दृश्य.भेजो(यह.पाठलो(कुंजी)); }\n    सार्वजनिक फलन पृष्ठ(शीर्षक: पाठ, शरीर: दृश्य) -> वेबउत्तर { लौटाओ यह.पृष्ठ(शीर्षक,शरीर,\"shared\"); }\n    सार्वजनिक फलन पृष्ठ(शीर्षक: पाठ, शरीर: दृश्य, स्रोतकुंजी: पाठ) -> वेबउत्तर { लौटाओ दृश्य.पृष्ठ(शीर्षक,दृश्य.खंड(\"div\").जोड़ो(शरीर).जोड़ो(स्रोतदृश्य.पैनल(यह,स्रोतकुंजी)),भाषा); }\n}\n"; }
    निजी साझा फलन अंश66() -> पाठ { लौटाओ "// SPDX-License-Identifier: Apache-2.0\nआयात अनुप्रयोग.दृश्य; आयात अनुप्रयोग.स्रोतप्रकाश; आयात मानक.वेबउत्तर; आयात मानक.वेबत्रुटि; आयात मानक.पाठ्य;\n\n// Native disclosures preserve the page, forms, scroll, and browser history.\n// The catalog is generated only from a fixed list of public Bhash source files.\nवर्ग स्रोतदृश्य {\n    निजी साझा फलन खंड(अ: अनुवाद, शीर्षक: पाठ, कुंजी: पाठ, खुला: तार्किक) -> दृश्य {\n        स्थिर भाग: दृश्य=दृश्य.खंड(\"details\").गुण(\"class\",\"source-file\");\n        यदि (खुला) { भाग.गुण(\"open\",\"open\"); }\n        लौटाओ भाग.जोड़ो(दृश्य.शब्द(\"summary\",शीर्षक)).जोड़ो(स्रोतदृश्य.कोडब्लॉक(अ,स्रोतसंग्रह.लो(कुंजी),शीर्षक));\n    }\n    निजी साझा फलन कोडब्लॉक(अ: अनुवाद, स्रोत: पाठ, शीर्षक: पाठ) -> दृश्य {\n        लौटाओ स्रोतप्रकाश.ब्लॉक(स्रोत,शीर्षक,अ.पाठलो(\"Copy code\"),अ.पाठलो(\"Copied\"),अ.पाठलो(\"Copy unavailable. Code selected; press Ctrl+C or Command+C.\"));\n    }\n    निजी साझा फलन आलसीखंड(शीर्षक: पाठ, भाग: पाठ, पृष्ठ: पाठ, भाषा: पाठ) -> दृश्य {\n        लौटाओ दृश्य.खंड(\"details\").गुण(\"class\",\"source-file\").जोड़ो(दृश्य.शब्द(\"summary\",शीर्षक)).जोड़ो(दृश्य.खंड(\"iframe\").गुण(\"class\",\"source-code-frame\").गुण(\"title\",शीर्षक).गुण(\"loading\",\"lazy\").गुण(\"sandbox\",\"allow-same-origin allow-scripts\").गुण(\"allow\",\"clipboard-write 'self'\").गुण(\"src\",\"/source/\"+पृष्ठ+\"/\"+भाग+\"?language=\"+भाषा));\n    }\n    निजी साझा फलन कोडपृष्ठ(अ: अनुवाद, शरीर: दृश्य) -> वेबउत्तर {\n        स्थिर उत्तर: वेबउत्तर=दृश्य.पृष्ठ(अ.पाठलो(\"Bhash source for this page\"),दृश्य.खंड(\"div\").जोड़ो(शरीर).जोड़ो(दृश्य.बाह्यलिपि(\"/assets/source-copy.js\")),अ.भाषा);\n        उत्तर.शीर्षरखो(\"Content-Security-Policy\",\"default-src 'none'; style-src 'self'; script-src 'self'; frame-src 'self'; form-action 'none'; frame-ancestors 'self'; base-uri 'none'\");\n        उत्तर.शीर्षरखो(\"Permissions-Policy\",\"clipboard-write=(s"; }
    निजी साझा फलन अंश67() -> पाठ { लौटाओ "elf), clipboard-read=()\");\n        लौटाओ उत्तर;\n    }\n    सार्वजनिक साझा फलन अंशदस्तावेज़(अ: अनुवाद, पृष्ठ: पाठ, भाग: पाठ) -> वेबउत्तर {\n        स्रोतदृश्य.जाँचो(पृष्ठ); मान कुंजी: पाठ=\"\";\n        यदि (भाग==\"layout\") { कुंजी=\"ui:layout\"; }\n        यदि (भाग==\"routing\") { कुंजी=\"backend:routing\"; }\n        यदि (भाग==\"validation\") { कुंजी=\"backend:validation\"; }\n        यदि (भाग==\"source-tools\") { कुंजी=\"file:packages/web-platform/src/source.bhash\"; }\n        यदि (भाग==\"signup\") { कुंजी=\"file:src/signup.bhash\"; }\n        यदि (भाग==\"ui\") { कुंजी=\"file:packages/web-platform/src/ui.bhash\"; }\n        यदि (भाग==\"translations\") { कुंजी=\"file:src/translations.bhash\"; }\n        यदि (भाग==\"viewer\") { कुंजी=\"file:src/source_viewer.bhash\"; }\n        यदि (भाग==\"main\") { कुंजी=\"file:src/main.bhash\"; }\n        यदि (भाग==\"forms\") { कुंजी=\"file:packages/web-platform/src/forms.bhash\"; }\n        यदि (भाग==\"sessions\") { कुंजी=\"file:packages/web-platform/src/sessions.bhash\"; }\n        यदि (भाग==\"tenancy\") { कुंजी=\"file:packages/web-platform/src/tenancy.bhash\"; }\n        यदि (भाग==\"schema\") { कुंजी=\"file:src/schema.bhash\"; }\n        यदि (कुंजी==\"\") { फेंको नया वेबत्रुटि(४०४,\"स्रोत पृष्ठ उपलब्ध नहीं।\"); }\n        स्थिर कोड: दृश्य=दृश्य.खंड(\"main\").गुण(\"class\",\"source-code-document\").जोड़ो(स्रोतदृश्य.कोडब्लॉक(अ,स्रोतसंग्रह.लो(कुंजी),अ.पाठलो(\"Bhash source for this page\")));\n        लौटाओ स्रोतदृश्य.कोडपृष्ठ(अ,कोड);\n    }\n    निजी साझा फलन जाँचो(पृष्ठ: पाठ) -> शून्य {\n        प्रत्येक (नया सूची<पाठ>{\"signin\",\"signup\",\"verify\",\"organizations\",\"overview\",\"list\",\"record\",\"members\",\"audit\",\"account\",\"error\",\"shared\"} में नाम: पाठ) { यदि (पृष्ठ==नाम) { लौटाओ; } }\n        फेंको नया वेबत्रुटि(४०४,\"स्रोत पृष्ठ उपलब्ध नहीं।\");\n    }\n    सार्वजनिक साझा फलन पैनल(अ: अनुवाद, पृष्ठ: पाठ) -> दृश्य {\n        स्रो"; }
