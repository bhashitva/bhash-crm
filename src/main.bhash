आयात अनुप्रयोग.डेटास्रोत; आयात अनुप्रयोग.मंच; आयात अनुप्रयोग.स्थायीसत्र;
आयात अनुप्रयोग.फॉर्मसुरक्षा;
आयात मानक.विन्यास; आयात मानक.वेब; आयात मानक.डेटासंबंध;
आयात मानक.एचटीटीपीसर्वर; आयात मानक.सत्रप्रबंधक;
आयात मानक.वेबअनुप्रयोग;

फलन मुख्य() -> शून्य {
    स्थिर त: विन्यास=विन्यास.तर्क();
    स्थिर स्रोत: डेटास्रोत=नया डेटास्रोत(त.पढ़ो("provider","sqlite"),त.पढ़ो("db","crm.db"));
    संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { सीआरएमस्कीमा.आरंभकरो(ड); }
    स्थिर भंडार: सीआरएमभंडार=नया सीआरएमभंडार(स्रोत);
    यदि (त.पढ़ो("setup-status","false")=="true") {
        यदि (भंडार.सेटअपचाहिए()) { लिखो("SETUP_REQUIRED"); } अन्यथा { लिखो("SETUP_READY"); }
        लौटाओ;
    }
    यदि (त.पढ़ो("bootstrap","false")=="true") { भंडार.प्रावधान(); लौटाओ; }
    स्थिर स्थानीय: तार्किक=त.पढ़ो("local","false")=="true";
    स्थिर बंधन: पाठ=त.पढ़ो("bind","127.0.0.1");
    यदि (स्थानीय && बंधन!="127.0.0.1") { फेंको नया अपवाद("स्थानीय HTTP केवल loopback पर उपलब्ध है।"); }
    संसाधन (सर्वर: एचटीटीपीसर्वर=नया एचटीटीपीसर्वर(बंधन,वेब.संख्या(त.पढ़ो("port","8080"),६५५३५))) {
        मान मूल: पाठ=त.पढ़ो("origin","https://localhost");
        यदि (स्थानीय) { मूल="http://127.0.0.1:"+वेब.अंक(सर्वर.पोर्ट()); }
        संसाधन (म: सत्रप्रबंधक=नया स्थायीसत्र(स्रोत,मूल,स्थानीय)) {
            स्थिर चालक: सीआरएमचालक=नया सीआरएमचालक(भंडार,म);
            स्थिर मार्ग: वेबअनुप्रयोग=नया वेबअनुप्रयोग();
            मार्ग.जोड़ो("GET","/",चालक); मार्ग.जोड़ो("GET","/healthz",चालक);
            मार्ग.जोड़ो("GET","/assets/platform.css",चालक);
            मार्ग.जोड़ो("GET","/source/:page",चालक);
            मार्ग.जोड़ो("GET","/source/:page/:part",चालक);
            मार्ग.जोड़ो("POST","/login",चालक); मार्ग.जोड़ो("POST","/logout",चालक); मार्ग.जोड़ो("POST","/tenants",चालक);
            मार्ग.जोड़ो("GET","/account",चालक); मार्ग.जोड़ो("POST","/account/password",चालक);
            मार्ग.जोड़ो("POST","/language",चालक); मार्ग.जोड़ो("POST","/account/preferences",चालक);
            मार्ग.जोड़ो("GET","/t/:tenant",चालक); मार्ग.जोड़ो("GET","/t/:tenant/:kind",चालक);
            मार्ग.जोड़ो("GET","/t/:tenant/:kind/:id",चालक);
            मार्ग.जोड़ो("POST","/t/:tenant/:kind/save",चालक);
            मार्ग.जोड़ो("POST","/t/:tenant/:kind/archive",चालक);
            मार्ग.जोड़ो("POST","/t/:tenant/:kind/remove",चालक);
            स्थिर त्रुटि: सीआरएमत्रुटिदृश्य=नया सीआरएमत्रुटिदृश्य(भंडार,म);
            लिखो("READY "+वेब.अंक(सर्वर.पोर्ट())); सर्वर.चलाओ(नया फॉर्मसुरक्षा(म,नया सीआरएममार्ग(मार्ग,त्रुटि),त्रुटि));
        }
    }
}
