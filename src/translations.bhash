        शब्दकोश["Read the Bhash source used by this running app. Opening or closing this panel keeps your page and unsaved entries in place."]="इस चल रहे ऐप का भाष स्रोत पढ़ें। इस पैनल को खोलने या बंद करने पर आपका पृष्ठ और बिना सहेजी प्रविष्टियाँ बनी रहती हैं।"; अंग्रेज़ी["इस चल रहे ऐप का भाष स्रोत पढ़ें। इस पैनल को खोलने या बंद करने पर आपका पृष्ठ और बिना सहेजी प्रविष्टियाँ बनी रहती हैं।"]="Read the Bhash source used by this running app. Opening or closing this panel keeps your page and unsaved entries in place.";
    }
    सार्वजनिक फलन पाठलो(कुंजी: पाठ) -> पाठ {
        यदि (भाषा=="hi" && शब्दकोश.है(कुंजी)) { लौटाओ शब्दकोश[कुंजी]; }
        यदि (भाषा=="en" && अंग्रेज़ी.है(कुंजी)) { लौटाओ अंग्रेज़ी[कुंजी]; } लौटाओ कुंजी;
    }
    सार्वजनिक फलन नोड(नाम: पाठ, कुंजी: पाठ) -> दृश्य { लौटाओ दृश्य.शब्द(नाम,यह.पाठलो(कुंजी)); }
    सार्वजनिक फलन कड़ी(पथ: पाठ, कुंजी: पाठ) -> दृश्य { लौटाओ दृश्य.कड़ी(पथ,यह.पाठलो(कुंजी)); }
    सार्वजनिक फलन क्षेत्र(नाम: पाठ, कुंजी: पाठ, प्रकार: पाठ, मानक: पाठ) -> दृश्य { लौटाओ दृश्य.क्षेत्र(नाम,यह.पाठलो(कुंजी),प्रकार,मानक); }
    सार्वजनिक फलन भेजो(कुंजी: पाठ) -> दृश्य { लौटाओ दृश्य.भेजो(यह.पाठलो(कुंजी)); }
    सार्वजनिक फलन पृष्ठ(शीर्षक: पाठ, शरीर: दृश्य) -> वेबउत्तर { लौटाओ यह.पृष्ठ(शीर्षक,शरीर,"shared"); }
    सार्वजनिक फलन पृष्ठ(शीर्षक: पाठ, शरीर: दृश्य, स्रोतकुंजी: पाठ) -> वेबउत्तर { लौटाओ दृश्य.पृष्ठ(शीर्षक,दृश्य.खंड("div").जोड़ो(शरीर).जोड़ो(स्रोतदृश्य.पैनल(यह,स्रोतकुंजी)),भाषा); }
}
