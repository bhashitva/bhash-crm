आयात अनुप्रयोग.दृश्य; आयात मानक.वेबउत्तर;
वर्ग अनुवाद {
    सार्वजनिक स्थिर भाषा: पाठ;
    निजी स्थिर शब्दकोश: मानचित्र<पाठ,पाठ>;
    निजी स्थिर अंग्रेज़ी: मानचित्र<पाठ,पाठ>;
    निर्माता(भाषा: पाठ) {
        सीआरएमभंडार.भाषाजाँचो(भाषा); यह.भाषा=भाषा; शब्दकोश=नया मानचित्र<पाठ,पाठ>(); अंग्रेज़ी=नया मानचित्र<पाठ,पाठ>();
        अनुवाद.भाग१(शब्दकोश,अंग्रेज़ी);
        अनुवाद.भाग२(शब्दकोश,अंग्रेज़ी);
        अनुवाद.भाग३(शब्दकोश,अंग्रेज़ी);
        अनुवाद.भाग४(शब्दकोश,अंग्रेज़ी);
        अनुवाद.भाग५(शब्दकोश,अंग्रेज़ी);
        अनुवाद.भाग६(शब्दकोश,अंग्रेज़ी);
        अनुवाद.भाग७(शब्दकोश,अंग्रेज़ी);
        अनुवाद.भाग८(शब्दकोश,अंग्रेज़ी);
        अनुवाद.भाग९(शब्दकोश,अंग्रेज़ी);
        अनुवाद.भाग१०(शब्दकोश,अंग्रेज़ी);
    }
    निजी साझा फलन भाग१(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {
        शब्दकोश["Account"]="खाता"; अंग्रेज़ी["खाता"]="Account";
        शब्दकोश["Action"]="क्रिया"; अंग्रेज़ी["क्रिया"]="Action";
        शब्दकोश["Active"]="सक्रिय"; अंग्रेज़ी["सक्रिय"]="Active";
        शब्दकोश["Actor"]="कर्ता"; अंग्रेज़ी["कर्ता"]="Actor";
        शब्दकोश["Add a member"]="सदस्य जोड़ें"; अंग्रेज़ी["सदस्य जोड़ें"]="Add a member";
        शब्दकोश["Add member"]="सदस्य जोड़ें"; अंग्रेज़ी["सदस्य जोड़ें"]="Add member";
        शब्दकोश["Add record"]="रिकॉर्ड जोड़ें"; अंग्रेज़ी["रिकॉर्ड जोड़ें"]="Add record";
        शब्दकोश["Archive record"]="रिकॉर्ड संग्रहित करें"; अंग्रेज़ी["रिकॉर्ड संग्रहित करें"]="Archive record";
        शब्दकोश["Archived"]="संग्रहित"; अंग्रेज़ी["संग्रहित"]="Archived";
        शब्दकोश["Audit"]="लेखा"; अंग्रेज़ी["लेखा"]="Audit";
        शब्दकोश["Audit trail"]="बदलावों का लेखा"; अंग्रेज़ी["बदलावों का लेखा"]="Audit trail";
        शब्दकोश["Back to list"]="सूची पर लौटें"; अंग्रेज़ी["सूची पर लौटें"]="Back to list";
        शब्दकोश["Browse, search and manage records."]="रिकॉर्ड देखें, खोजें और प्रबंधित करें।"; अंग्रेज़ी["रिकॉर्ड देखें, खोजें और प्रबंधित करें।"]="Browse, search and manage records.";
        शब्दकोश["Change password"]="कूटशब्द बदलें"; अंग्रेज़ी["कूटशब्द बदलें"]="Change password";
        शब्दकोश["Change password and sign out"]="कूटशब्द बदलें और बाहर निकलें"; अंग्रेज़ी["कूटशब्द बदलें और बाहर निकलें"]="Change password and sign out";
        शब्दकोश["Companies"]="कंपनियाँ"; अंग्रेज़ी["कंपनियाँ"]="Companies";
        शब्दकोश["Company"]="कंपनी"; अंग्रेज़ी["कंपनी"]="Company";
        शब्दकोश["Confirm new password"]="नए कूटशब्द की पुष्टि"; अंग्रेज़ी["नए कूटशब्द की पुष्टि"]="Confirm new password";
        शब्दकोश["Contacts"]="संपर्क"; अंग्रेज़ी["संपर्क"]="Contacts";
        शब्दकोश["Contacts, pipeline and follow-ups in one place."]="संपर्क, बिक्री के अवसर और अनुवर्ती कार्य एक स्थान पर।"; अंग्रेज़ी["संपर्क, बिक्री के अवसर और अनुवर्ती कार्य एक स्थान पर।"]="Contacts, pipeline and follow-ups in one place.";
    }
    निजी साझा फलन भाग२(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {
        शब्दकोश["Create an organization"]="संगठन बनाएँ"; अंग्रेज़ी["संगठन बनाएँ"]="Create an organization";
        शब्दकोश["Create organization"]="संगठन बनाएँ"; अंग्रेज़ी["संगठन बनाएँ"]="Create organization";
        शब्दकोश["Currency"]="मुद्रा"; अंग्रेज़ी["मुद्रा"]="Currency";
        शब्दकोश["Current password"]="वर्तमान कूटशब्द"; अंग्रेज़ी["वर्तमान कूटशब्द"]="Current password";
        शब्दकोश["Current related record"]="वर्तमान संबंधित रिकॉर्ड"; अंग्रेज़ी["वर्तमान संबंधित रिकॉर्ड"]="Current related record";
        शब्दकोश["Details"]="विवरण"; अंग्रेज़ी["विवरण"]="Details";
        शब्दकोश["Due date"]="नियत तिथि"; अंग्रेज़ी["नियत तिथि"]="Due date";
        शब्दकोश["Email"]="ईमेल"; अंग्रेज़ी["ईमेल"]="Email";
        शब्दकोश["Entity"]="रिकॉर्ड का प्रकार"; अंग्रेज़ी["रिकॉर्ड का प्रकार"]="Entity";
        शब्दकोश["Language"]="भाषा"; अंग्रेज़ी["भाषा"]="Language";
        शब्दकोश["Default language"]="डिफ़ॉल्ट भाषा"; अंग्रेज़ी["डिफ़ॉल्ट भाषा"]="Default language";
        शब्दकोश["Display language"]="प्रदर्शन की भाषा"; अंग्रेज़ी["प्रदर्शन की भाषा"]="Display language";
        शब्दकोश["Save language preference"]="भाषा की पसंद सहेजें"; अंग्रेज़ी["भाषा की पसंद सहेजें"]="Save language preference";
        शब्दकोश["Language preference"]="भाषा की पसंद"; अंग्रेज़ी["भाषा की पसंद"]="Language preference";
        शब्दकोश["Choose your default language. It is used whenever you sign in."]="अपनी डिफ़ॉल्ट भाषा चुनें। हर बार प्रवेश करने पर यही भाषा उपयोग होगी।"; अंग्रेज़ी["अपनी डिफ़ॉल्ट भाषा चुनें। हर बार प्रवेश करने पर यही भाषा उपयोग होगी।"]="Choose your default language. It is used whenever you sign in.";
        शब्दकोश["Switch"]="बदलें"; अंग्रेज़ी["बदलें"]="Switch";
        शब्दकोश["Main navigation"]="मुख्य नेविगेशन"; अंग्रेज़ी["मुख्य नेविगेशन"]="Main navigation";
        शब्दकोश["Members"]="सदस्य"; अंग्रेज़ी["सदस्य"]="Members";
        शब्दकोश["Members & access"]="सदस्य और अनुमतियाँ"; अंग्रेज़ी["सदस्य और अनुमतियाँ"]="Members & access";
        शब्दकोश["Name"]="नाम"; अंग्रेज़ी["नाम"]="Name";
    }
    निजी साझा फलन भाग३(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {
        शब्दकोश["New password"]="नया कूटशब्द"; अंग्रेज़ी["नया कूटशब्द"]="New password";
        शब्दकोश["Next"]="अगला"; अंग्रेज़ी["अगला"]="Next";
        शब्दकोश["No matching records."]="कोई मेल खाता रिकॉर्ड नहीं मिला।"; अंग्रेज़ी["कोई मेल खाता रिकॉर्ड नहीं मिला।"]="No matching records.";
        शब्दकोश["None"]="कोई नहीं"; अंग्रेज़ी["कोई नहीं"]="None";
        शब्दकोश["Notes"]="टिप्पणियाँ"; अंग्रेज़ी["टिप्पणियाँ"]="Notes";
        शब्दकोश["Opportunities"]="बिक्री के अवसर"; अंग्रेज़ी["बिक्री के अवसर"]="Opportunities";
        शब्दकोश["Organization name"]="संगठन का नाम"; अंग्रेज़ी["संगठन का नाम"]="Organization name";
        शब्दकोश["Organizations"]="संगठन"; अंग्रेज़ी["संगठन"]="Organizations";
        शब्दकोश["Overview"]="अवलोकन"; अंग्रेज़ी["अवलोकन"]="Overview";
        शब्दकोश["Pagination"]="पृष्ठ बदलें"; अंग्रेज़ी["पृष्ठ बदलें"]="Pagination";
        शब्दकोश["Password"]="कूटशब्द"; अंग्रेज़ी["कूटशब्द"]="Password";
        शब्दकोश["Password for a NEW account only (12+ characters)"]="केवल नए खाते का कूटशब्द (कम से कम १२ अक्षर)"; अंग्रेज़ी["केवल नए खाते का कूटशब्द (कम से कम १२ अक्षर)"]="Password for a NEW account only (12+ characters)";
        शब्दकोश["Phone"]="फ़ोन"; अंग्रेज़ी["फ़ोन"]="Phone";
        शब्दकोश["Pipeline preview shows the first 50 opportunities. Open Opportunities to search and page through all records."]="पूर्वावलोकन में पहले ५० अवसर हैं। सभी रिकॉर्ड खोजने और उनके पृष्ठ देखने के लिए बिक्री के अवसर खोलें।"; अंग्रेज़ी["पूर्वावलोकन में पहले ५० अवसर हैं। सभी रिकॉर्ड खोजने और उनके पृष्ठ देखने के लिए बिक्री के अवसर खोलें।"]="Pipeline preview shows the first 50 opportunities. Open Opportunities to search and page through all records.";
        शब्दकोश["Previous"]="पिछला"; अंग्रेज़ी["पिछला"]="Previous";
        शब्दकोश["Related contact"]="संबंधित संपर्क"; अंग्रेज़ी["संबंधित संपर्क"]="Related contact";
        शब्दकोश["Remove member"]="सदस्य हटाएँ"; अंग्रेज़ी["सदस्य हटाएँ"]="Remove member";
        शब्दकोश["Restore record"]="रिकॉर्ड वापस लाएँ"; अंग्रेज़ी["रिकॉर्ड वापस लाएँ"]="Restore record";
        शब्दकोश["Role"]="भूमिका"; अंग्रेज़ी["भूमिका"]="Role";
        शब्दकोश["Sales pipeline"]="बिक्री के अवसरों की स्थिति"; अंग्रेज़ी["बिक्री के अवसरों की स्थिति"]="Sales pipeline";
    }
    निजी साझा फलन भाग४(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {
        शब्दकोश["Save record"]="रिकॉर्ड सहेजें"; अंग्रेज़ी["रिकॉर्ड सहेजें"]="Save record";
        शब्दकोश["Search"]="खोजें"; अंग्रेज़ी["खोजें"]="Search";
        शब्दकोश["Search by name"]="नाम से खोजें"; अंग्रेज़ी["नाम से खोजें"]="Search by name";
        शब्दकोश["Sign in"]="प्रवेश करें"; अंग्रेज़ी["प्रवेश करें"]="Sign in";
        शब्दकोश["Sign in to manage your organizations, relationships and opportunities."]="अपने संगठन, संपर्क और बिक्री के अवसर सँभालने के लिए प्रवेश करें।"; अंग्रेज़ी["अपने संगठन, संपर्क और बिक्री के अवसर सँभालने के लिए प्रवेश करें।"]="Sign in to manage your organizations, relationships and opportunities.";
        शब्दकोश["Sign out"]="बाहर निकलें"; अंग्रेज़ी["बाहर निकलें"]="Sign out";
        शब्दकोश["Status"]="स्थिति"; अंग्रेज़ी["स्थिति"]="Status";
        शब्दकोश["Tasks"]="कार्य"; अंग्रेज़ी["कार्य"]="Tasks";
        शब्दकोश["Time (UTC)"]="समय (यूटीसी)"; अंग्रेज़ी["समय (यूटीसी)"]="Time (UTC)";
        शब्दकोश["Update role"]="भूमिका बदलें"; अंग्रेज़ी["भूमिका बदलें"]="Update role";
        शब्दकोश["Use an existing username, or create a new account with a temporary password. Share credentials privately; the owner cannot reset an existing account's password here."]="मौजूदा उपयोगकर्ता नाम दें या अस्थायी कूटशब्द से नया खाता बनाएँ। प्रवेश विवरण निजी रूप से साझा करें। मालिक यहाँ किसी मौजूदा खाते का कूटशब्द नहीं बदल सकता।"; अंग्रेज़ी["मौजूदा उपयोगकर्ता नाम दें या अस्थायी कूटशब्द से नया खाता बनाएँ। प्रवेश विवरण निजी रूप से साझा करें। मालिक यहाँ किसी मौजूदा खाते का कूटशब्द नहीं बदल सकता।"]="Use an existing username, or create a new account with a temporary password. Share credentials privately; the owner cannot reset an existing account's password here.";
        शब्दकोश["Use at least 12 characters. Changing your password signs out all your sessions, including this one."]="कम से कम १२ अक्षर दें। कूटशब्द बदलने पर इस सत्र सहित आपके सभी सत्र समाप्त होंगे।"; अंग्रेज़ी["कम से कम १२ अक्षर दें। कूटशब्द बदलने पर इस सत्र सहित आपके सभी सत्र समाप्त होंगे।"]="Use at least 12 characters. Changing your password signs out all your sessions, including this one.";
        शब्दकोश["Username"]="उपयोगकर्ता नाम"; अंग्रेज़ी["उपयोगकर्ता नाम"]="Username";
        शब्दकोश["Value in minor units (e.g. 12500 = 125.00)"]="राशि सबसे छोटी इकाई में (जैसे 12500 = 125.00)"; अंग्रेज़ी["राशि सबसे छोटी इकाई में (जैसे 12500 = 125.00)"]="Value in minor units (e.g. 12500 = 125.00)";
        शब्दकोश["Your account"]="आपका खाता"; अंग्रेज़ी["आपका खाता"]="Your account";
        शब्दकोश["Your customer workspace"]="आपके ग्राहक प्रबंधन का कार्यस्थल"; अंग्रेज़ी["आपके ग्राहक प्रबंधन का कार्यस्थल"]="Your customer workspace";
        शब्दकोश["Your organizations"]="आपके संगठन"; अंग्रेज़ी["आपके संगठन"]="Your organizations";
        शब्दकोश[" (first 50; existing selection retained)"]=" (पहले ५०; वर्तमान चयन सुरक्षित रहेगा)"; अंग्रेज़ी[" (पहले ५०; वर्तमान चयन सुरक्षित रहेगा)"]=" (first 50; existing selection retained)";
        शब्दकोश["Record"]="रिकॉर्ड"; अंग्रेज़ी["रिकॉर्ड"]="Record";
        शब्दकोश["Request could not be completed"]="अनुरोध पूरा नहीं हो सका"; अंग्रेज़ी["अनुरोध पूरा नहीं हो सका"]="Request could not be completed";
    }
    निजी साझा फलन भाग५(शब्दकोश: मानचित्र<पाठ,पाठ>, अंग्रेज़ी: मानचित्र<पाठ,पाठ>) -> शून्य {
        शब्दकोश["Refresh the original page before trying again."]="फिर प्रयास करने से पहले मूल पृष्ठ दोबारा खोलें।"; अंग्रेज़ी["फिर प्रयास करने से पहले मूल पृष्ठ दोबारा खोलें।"]="Refresh the original page before trying again.";
        शब्दकोश["Return to CRM"]="सीआरएम पर लौटें"; अंग्रेज़ी["सीआरएम पर लौटें"]="Return to CRM";
        शब्दकोश["owner"]="मालिक"; अंग्रेज़ी["मालिक"]="owner";
