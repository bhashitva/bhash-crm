आयात अनुप्रयोग.मंच;
आयात मानक.माइग्रेशन; आयात मानक.माइग्रेशनयोजना; आयात मानक.डेटासंबंध;
वर्ग सीआरएमस्कीमा {
    सार्वजनिक साझा फलन आरंभकरो(ड: डेटासंबंध) -> शून्य {
        स्थिर बदलाव: सूची<माइग्रेशन> = मंच.माइग्रेशनलो();
        बदलाव.जोड़ो(नया माइग्रेशन(२,"CRM records",नया सूची<पाठ>{
            "CREATE TABLE crm_records (tenant_id TEXT NOT NULL REFERENCES platform_tenants(id), id TEXT NOT NULL, kind TEXT NOT NULL CHECK (kind IN ('companies','contacts','deals','tasks')), name TEXT NOT NULL, email TEXT NOT NULL, phone TEXT NOT NULL, notes TEXT NOT NULL, related_id TEXT, stage TEXT NOT NULL, amount_minor BIGINT NOT NULL CHECK(amount_minor>=0), currency TEXT NOT NULL, due_date TEXT NOT NULL, version BIGINT NOT NULL, archived BOOLEAN NOT NULL, PRIMARY KEY(tenant_id,id), FOREIGN KEY(tenant_id,related_id) REFERENCES crm_records(tenant_id,id))",
            "CREATE INDEX crm_records_list ON crm_records(tenant_id,kind,archived,name,id)"
        }));
        बदलाव.जोड़ो(नया माइग्रेशन(३,"User display languages",नया सूची<पाठ>{
            "ALTER TABLE platform_users ADD COLUMN ui_language TEXT NOT NULL DEFAULT 'hi' CHECK (ui_language IN ('hi','en'))",
            "ALTER TABLE platform_sessions ADD COLUMN display_language TEXT NOT NULL DEFAULT '' CHECK (display_language IN ('','hi','en'))"
        }));
        बदलाव.जोड़ो(नया माइग्रेशन(४,"Verified self-service signup",नया सूची<पाठ>{
            "ALTER TABLE platform_users ADD COLUMN email TEXT",
            "ALTER TABLE platform_users ADD COLUMN email_verified BOOLEAN NOT NULL DEFAULT FALSE",
            "CREATE UNIQUE INDEX platform_users_email ON platform_users(email)",
            "CREATE TABLE crm_email_verifications (token_hash TEXT PRIMARY KEY, email TEXT NOT NULL, language TEXT NOT NULL CHECK(language IN ('hi','en')), created BIGINT NOT NULL, expires BIGINT NOT NULL, sent BOOLEAN NOT NULL)",
            "CREATE INDEX crm_email_verifications_email ON crm_email_verifications(email)",
            "CREATE TABLE crm_signup_limits (key_hash TEXT PRIMARY KEY, started BIGINT NOT NULL, attempts BIGINT NOT NULL)",
            "CREATE TABLE crm_captcha_tokens (token_hash TEXT PRIMARY KEY, expires BIGINT NOT NULL)"
        }));
        स्थिर योजना: माइग्रेशनयोजना=नया माइग्रेशनयोजना(बदलाव); योजना.लागूकरो(ड);
    }
}
