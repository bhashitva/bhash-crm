// SPDX-License-Identifier: Apache-2.0
आयात अनुप्रयोग.दृश्य; आयात अनुप्रयोग.स्रोतप्रकाश; आयात अनुप्रयोग.फॉर्म; आयात अनुप्रयोग.संगठनसंदर्भ;
आयात मानक.वेबचालक; आयात मानक.वेबअनुरोध; आयात मानक.वेबउत्तर; आयात मानक.वेबत्रुटि; आयात मानक.वेब;
आयात मानक.सत्र; आयात मानक.सत्रप्रबंधक; आयात मानक.पाठ्य; आयात मानक.एचटीटीपी; आयात मानक.समय;

वर्ग सीआरएमपृष्ठ पालन वेबचालक {
    निजी स्थिर भाषादृश्य: अनुवाद;
    निजी स्थिर वापसी: पाठ;
    निजी स्थिर भंडार: सीआरएमभंडार;
    निजी स्थिर म: सत्रप्रबंधक;
    निर्माता(भंडार: सीआरएमभंडार, म: सत्रप्रबंधक, भाषा: पाठ, वापसी: पाठ) { यह.भंडार=भंडार; यह.म=म; भाषादृश्य=नया अनुवाद(भाषा); यह.वापसी=वापसी; }
    निजी फलन शीर्षक(प्रकार: पाठ) -> पाठ {
        यदि (प्रकार=="companies") { लौटाओ भाषादृश्य.पाठलो("Companies"); } यदि (प्रकार=="contacts") { लौटाओ भाषादृश्य.पाठलो("Contacts"); }
        यदि (प्रकार=="deals") { लौटाओ भाषादृश्य.पाठलो("Opportunities"); } यदि (प्रकार=="tasks") { लौटाओ भाषादृश्य.पाठलो("Tasks"); }
        फेंको नया वेबत्रुटि(४०४,"अमान्य CRM प्रकार।");
    }
    निजी फलन पथ(त: पाठ, प्रकार: पाठ) -> पाठ { लौटाओ "/t/"+त+"/"+प्रकार; }
    निजी फलन वैकल्पिक(फ: मानचित्र<पाठ,पाठ>, न: पाठ, सीमा: पूर्णांक) -> पाठ {
        यदि (!फ.है(न)) { लौटाओ ""; } स्थिर व: पाठ=पाठ्य.छाँटो(फ[न]); यदि (पाठ्य.यूटीएफ८(व).आकार>सीमा) { फेंको नया वेबत्रुटि(४२२,"क्षेत्र बहुत बड़ा।"); } लौटाओ व;
    }
    निजी फलन क्षेत्र(न: पाठ, शीर्षक: पाठ, प्रकार: पाठ, व: पाठ) -> दृश्य {
        लौटाओ दृश्य.खंड("label").जोड़ो(दृश्य.अक्षर(भाषादृश्य.पाठलो(शीर्षक))).जोड़ो(दृश्य.खंड("input").गुण("name",न).गुण("type",प्रकार).गुण("value",व).गुण("maxlength","1024"));
    }
    निजी फलन चुनो(न: पाठ, शीर्षक: पाठ, मानक: पाठ, विकल्पसूची: सूची<पाठ>) -> दृश्य {
        स्थिर चयनसूची: दृश्य=दृश्य.खंड("select").गुण("name",न);
        प्रत्येक (विकल्पसूची में व: पाठ) { मान नाम: पाठ=भाषादृश्य.पाठलो(व); यदि (व=="hi") { नाम="हिन्दी"; } यदि (व=="en") { नाम="English"; } स्थिर ख: दृश्य=दृश्य.शब्द("option",नाम).गुण("value",व); यदि (व==मानक) { ख.गुण("selected","selected"); } चयनसूची.जोड़ो(ख); }
        लौटाओ दृश्य.खंड("label").जोड़ो(दृश्य.अक्षर(भाषादृश्य.पाठलो(शीर्षक))).जोड़ो(चयनसूची);
    }
    निजी फलन भाषाफॉर्म(स: सत्र) -> दृश्य {
        लौटाओ दृश्य.फॉर्म("/language",स.सीएसआरएफ()).जोड़ो(दृश्य.छिपा("_return",वापसी)).जोड़ो(यह.चुनो("language","Display language",भाषादृश्य.भाषा,नया सूची<पाठ>{"hi","en"})).जोड़ो(भाषादृश्य.भेजो("Switch"));
    }
    निजी फलन ढाँचा(स: सत्र, त: पाठ, शीर्षक: पाठ, मुख्य: दृश्य, स्रोतकुंजी: पाठ) -> वेबउत्तर {
        स्थिर नव: दृश्य=दृश्य.खंड("nav").गुण("aria-label",भाषादृश्य.पाठलो("Main navigation")).जोड़ो(भाषादृश्य.कड़ी("/","Organizations"));
        यदि (त!="") {
            नव.जोड़ो(भाषादृश्य.कड़ी("/t/"+त,"Overview"));
            प्रत्येक (नया सूची<पाठ>{"companies","contacts","deals","tasks"} में प: पाठ) { नव.जोड़ो(दृश्य.कड़ी(यह.पथ(त,प),यह.शीर्षक(प))); }
            यदि (भंडार.संदर्भ(स,त).भूमिका=="owner") { नव.जोड़ो(भाषादृश्य.कड़ी(यह.पथ(त,"members"),"Members")).जोड़ो(भाषादृश्य.कड़ी(यह.पथ(त,"audit"),"Audit")); }
        }
        नव.जोड़ो(भाषादृश्य.कड़ी("/account","Account"));
        स्थिर शीर्ष: दृश्य=दृश्य.खंड("header").जोड़ो(भाषादृश्य.नोड("strong","Bhash · CRM")).जोड़ो(नव).जोड़ो(यह.भाषाफॉर्म(स)).जोड़ो(दृश्य.फॉर्म("/logout",स.सीएसआरएफ()).जोड़ो(भाषादृश्य.भेजो("Sign out")));
        लौटाओ भाषादृश्य.पृष्ठ(शीर्षक,दृश्य.खंड("div").जोड़ो(शीर्ष).जोड़ो(दृश्य.खंड("main").जोड़ो(दृश्य.शब्द("h1",शीर्षक)).जोड़ो(मुख्य)),स्रोतकुंजी);
    }
    निजी फलन प्रवेशपृष्ठ(स: सत्र) -> वेबउत्तर {
        स्थिर फ: दृश्य=दृश्य.फॉर्म("/login",स.सीएसआरएफ()).जोड़ो(भाषादृश्य.क्षेत्र("username","Username","text","")).जोड़ो(भाषादृश्य.क्षेत्र("password","Password","password","")).जोड़ो(भाषादृश्य.भेजो("Sign in"));
        स्थिर उ: वेबउत्तर=भाषादृश्य.पृष्ठ(भाषादृश्य.पाठलो("Sign in"),दृश्य.खंड("main").गुण("class","narrow").जोड़ो(दृश्य.खंड("section").जोड़ो(भाषादृश्य.नोड("p","Bhash · CRM").गुण("class","badge")).जोड़ो(यह.भाषाफॉर्म(स)).जोड़ो(भाषादृश्य.नोड("h1","Your customer workspace")).जोड़ो(भाषादृश्य.नोड("p","Sign in to manage your organizations, relationships and opportunities.")).जोड़ो(फ)),"signin");
        म.कुकीरखो(उ,स); लौटाओ उ;
    }
    निजी फलन संगठनपृष्ठ(स: सत्र) -> वेबउत्तर {
        स्थिर भाग: दृश्य=दृश्य.खंड("div"); स्थिर ग्रिड: दृश्य=दृश्य.खंड("div").गुण("class","grid");
        प्रत्येक (भंडार.संगठनसूची(स) में त: मानचित्र<पाठ,पाठ>) {
            ग्रिड.जोड़ो(दृश्य.खंड("article").जोड़ो(भाषादृश्य.नोड("span",त["role"]).गुण("class","badge")).जोड़ो(दृश्य.खंड("h2").जोड़ो(दृश्य.कड़ी("/t/"+त["id"],त["name"]))).जोड़ो(भाषादृश्य.नोड("p","Contacts, pipeline and follow-ups in one place.")));
        }
        भाग.जोड़ो(ग्रिड).जोड़ो(दृश्य.खंड("section").जोड़ो(भाषादृश्य.नोड("h2","Create an organization")).जोड़ो(दृश्य.फॉर्म("/tenants",स.सीएसआरएफ()).जोड़ो(भाषादृश्य.क्षेत्र("name","Organization name","text","")).जोड़ो(भाषादृश्य.भेजो("Create organization"))));
        लौटाओ यह.ढाँचा(स,"",भाषादृश्य.पाठलो("Your organizations"),भाग,"organizations");
    }
    निजी फलन राशि(प: सीआरएमपंक्ति) -> पाठ {
        स्थिर अ: पाठ=वेब.अंक(प.राशि%१००); मान छोटा: पाठ=अ; यदि (प.राशि%१००<१०) { छोटा="0"+अ; }
        लौटाओ प.मुद्रा+" "+वेब.अंक(प.राशि/१००)+"."+छोटा;
    }
    निजी फलन अवलोकन(स: सत्र, त: पाठ) -> वेबउत्तर {
        स्थिर भाग: दृश्य=दृश्य.खंड("div"); स्थिर ग्रिड: दृश्य=दृश्य.खंड("div").गुण("class","grid");
        प्रत्येक (नया सूची<पाठ>{"companies","contacts","deals","tasks"} में प: पाठ) {
            ग्रिड.जोड़ो(दृश्य.खंड("article").जोड़ो(दृश्य.खंड("h2").जोड़ो(दृश्य.कड़ी(यह.पथ(त,प),यह.शीर्षक(प)))).जोड़ो(भाषादृश्य.नोड("p","Browse, search and manage records.")));
        } भाग.जोड़ो(ग्रिड).जोड़ो(भाषादृश्य.नोड("h2","Sales pipeline"));
        स्थिर अवसर: सूची<सीआरएमपंक्ति> =भंडार.सूचीलो(स,त,"deals","",०,असत्य);
        स्थिर पट: दृश्य=दृश्य.खंड("div").गुण("class","pipeline");
        प्रत्येक (नया सूची<पाठ>{"open","won","lost"} में स्थिति: पाठ) {
            स्थिर स्तंभ: दृश्य=दृश्य.खंड("section").जोड़ो(भाषादृश्य.नोड("h3",स्थिति));
            प्रत्येक (अवसर में प: सीआरएमपंक्ति) { यदि (प.स्थिति==स्थिति) { स्तंभ.जोड़ो(दृश्य.खंड("article").जोड़ो(दृश्य.कड़ी(यह.पथ(त,"deals")+"/"+प.पहचान,प.नाम)).जोड़ो(दृश्य.शब्द("p",यह.राशि(प)).गुण("class","money"))); } }
            पट.जोड़ो(स्तंभ);
        }
        भाग.जोड़ो(पट).जोड़ो(भाषादृश्य.नोड("small","Pipeline preview shows the first 50 opportunities. Open Opportunities to search and page through all records."));
        लौटाओ यह.ढाँचा(स,त,भंडार.संगठननाम(स,त),भाग,"overview");
    }
    निजी फलन पृष्ठअंतर(अ: वेबअनुरोध) -> पूर्णांक {
        स्थिर म: सूची<पाठ> =अ.प्रश्नमान("offset"); यदि (म.आकार>१) { फेंको नया वेबत्रुटि(४००,"दोहरा पृष्ठ।"); } यदि (म.आकार==०) { लौटाओ ०; } लौटाओ वेब.संख्या(म[०],१००००);
    }
    निजी फलन सूचीपृष्ठ(स: सत्र, त: पाठ, प्रकार: पाठ, अ: वेबअनुरोध) -> वेबउत्तर {
        स्थिर शीर्षक: पाठ=यह.शीर्षक(प्रकार); स्थिर संदर्भ: संगठनसंदर्भ=भंडार.संदर्भ(स,त); स्थिर भाग: दृश्य=दृश्य.खंड("div");
        मान खोज: पाठ=""; स्थिर ख: सूची<पाठ> =अ.प्रश्नमान("q"); यदि (ख.आकार>१) { फेंको नया वेबत्रुटि(४००,"दोहरी खोज।"); } यदि (ख.आकार==१) { खोज=ख[०]; }
        यदि (पाठ्य.यूटीएफ८(खोज).आकार>२००) { फेंको नया वेबत्रुटि(४२२,"खोज बहुत बड़ी।"); }
        स्थिर संग: सूची<पाठ> =अ.प्रश्नमान("archived"); यदि (संग.आकार>१) { फेंको नया वेबत्रुटि(४००,"दोहरा संग्रह।"); }
        स्थिर संग्रहित: तार्किक=संग.आकार==१ && संग[०]=="1";
        स्थिर अंतर: पूर्णांक=यह.पृष्ठअंतर(अ); स्थिर पंक्तियाँ: सूची<सीआरएमपंक्ति> =भंडार.सूचीलो(स,त,प्रकार,खोज,अंतर,संग्रहित);
        स्थिर पथ: पाठ=यह.पथ(त,प्रकार);
        स्थिर खोजफॉर्म: दृश्य=दृश्य.खंड("form").गुण("method","get").गुण("action",पथ).जोड़ो(यह.क्षेत्र("q","Search by name","search",खोज)).जोड़ो(भाषादृश्य.भेजो("Search"));
        यदि (संग्रहित) { खोजफॉर्म.जोड़ो(दृश्य.छिपा("archived","1")); }
        स्थिर औजार: दृश्य=दृश्य.खंड("section").जोड़ो(खोजफॉर्म);
        यदि (संदर्भ.भूमिका!="viewer") { औजार.जोड़ो(भाषादृश्य.कड़ी(पथ+"/new","Add record")); }
        औजार.जोड़ो(भाषादृश्य.नोड("span"," · ")).जोड़ो(भाषादृश्य.कड़ी(पथ,"Active")).जोड़ो(भाषादृश्य.नोड("span"," · ")).जोड़ो(भाषादृश्य.कड़ी(पथ+"?archived=1","Archived")); भाग.जोड़ो(औजार);
        स्थिर शरीर: दृश्य=दृश्य.खंड("tbody");
        प्रत्येक (पंक्तियाँ में प: सीआरएमपंक्ति) {
            स्थिर पंक्ति: दृश्य=दृश्य.खंड("tr").जोड़ो(दृश्य.खंड("td").जोड़ो(दृश्य.कड़ी(पथ+"/"+प.पहचान,प.नाम))).जोड़ो(दृश्य.शब्द("td",प.ईमेल)).जोड़ो(दृश्य.खंड("td").जोड़ो(भाषादृश्य.नोड("span",प.स्थिति).गुण("class","badge")));
            मान सार: पाठ=प.फ़ोन; यदि (प्रकार=="deals") { सार=यह.राशि(प); } यदि (प्रकार=="tasks") { सार=प.तिथि; }
            शरीर.जोड़ो(पंक्ति.जोड़ो(दृश्य.शब्द("td",सार)));
        }
        भाग.जोड़ो(दृश्य.खंड("section").गुण("class","table-wrap").जोड़ो(दृश्य.खंड("table").जोड़ो(दृश्य.खंड("thead").जोड़ो(दृश्य.खंड("tr").जोड़ो(भाषादृश्य.नोड("th","Name")).जोड़ो(भाषादृश्य.नोड("th","Email")).जोड़ो(भाषादृश्य.नोड("th","Status")).जोड़ो(भाषादृश्य.नोड("th","Details")))).जोड़ो(शरीर)));
        यदि (पंक्तियाँ.आकार==०) { भाग.जोड़ो(भाषादृश्य.नोड("p","No matching records.").गुण("class","empty")); }
        मान प्रश्न: पाठ="?q="+एचटीटीपी.कूटित(खोज); यदि (संग्रहित) { प्रश्न=प्रश्न+"&archived=1"; }
        स्थिर पृष्ठ: दृश्य=दृश्य.खंड("nav").गुण("aria-label",भाषादृश्य.पाठलो("Pagination"));
        यदि (अंतर>=५०) { पृष्ठ.जोड़ो(भाषादृश्य.कड़ी(पथ+प्रश्न+"&offset="+वेब.अंक(अंतर-५०),"Previous")); }
        यदि (पंक्तियाँ.आकार==५० && अंतर<९९५०) { पृष्ठ.जोड़ो(भाषादृश्य.कड़ी(पथ+प्रश्न+"&offset="+वेब.अंक(अंतर+५०),"Next")); }
        भाग.जोड़ो(पृष्ठ); लौटाओ यह.ढाँचा(स,त,शीर्षक,भाग,"list");
    }
    निजी फलन संपादन(स: सत्र, त: पाठ, प्रकार: पाठ, पहचान: पाठ) -> वेबउत्तर {
        यह.शीर्षक(प्रकार); स्थिर संदर्भ: संगठनसंदर्भ=भंडार.संदर्भ(स,त);
        मान प: सीआरएमपंक्ति=नया सीआरएमपंक्ति("",प्रकार,"","","","","","open",०,"USD","",०,असत्य);
        यदि (पहचान!="new") { प=भंडार.पाओ(स,त,प्रकार,पहचान); }
        स्थिर भाग: दृश्य=दृश्य.खंड("section");
        यदि (संदर्भ.भूमिका=="viewer" || प.संग्रहित) {
            भाग.जोड़ो(दृश्य.शब्द("h2",प.नाम)).जोड़ो(दृश्य.शब्द("p",प.ईमेल+" "+प.फ़ोन)).जोड़ो(दृश्य.शब्द("p",प.टिप्पणी)).जोड़ो(भाषादृश्य.नोड("p",प.स्थिति));
        } अन्यथा {
            स्थिर फ: दृश्य=दृश्य.फॉर्म(यह.पथ(त,प्रकार)+"/save",स.सीएसआरएफ()).जोड़ो(दृश्य.छिपा("id",प.पहचान)).जोड़ो(दृश्य.छिपा("version",वेब.अंक(प.संस्करण))).जोड़ो(भाषादृश्य.क्षेत्र("name","Name","text",प.नाम));
            स्थिर ग्रिड: दृश्य=दृश्य.खंड("div").गुण("class","grid").जोड़ो(यह.क्षेत्र("email","Email","email",प.ईमेल)).जोड़ो(यह.क्षेत्र("phone","Phone","tel",प.फ़ोन)); फ.जोड़ो(ग्रिड);
            मान विकल्पसूची: सूची<पाठ> =नया सूची<पाठ>{"open","active","inactive"};
            यदि (प्रकार=="deals") { विकल्पसूची=नया सूची<पाठ>{"open","won","lost"}; }
            यदि (प्रकार=="tasks") { विकल्पसूची=नया सूची<पाठ>{"open","done"}; }
            फ.जोड़ो(यह.चुनो("stage","Status",प.स्थिति,विकल्पसूची));
            यदि (प्रकार=="deals") { फ.जोड़ो(यह.क्षेत्र("amount_minor","Value in minor units (e.g. 12500 = 125.00)","number",वेब.अंक(प.राशि))).जोड़ो(यह.चुनो("currency","Currency",प.मुद्रा,नया सूची<पाठ>{"USD","INR","EUR","GBP"})); }
            यदि (प्रकार=="tasks") { फ.जोड़ो(यह.क्षेत्र("due_date","Due date","date",प.तिथि)); }
            यदि (प्रकार!="companies") {
                मान जाति: पाठ="contacts"; मान शीर्ष: पाठ="Related contact"; यदि (प्रकार=="contacts") { जाति="companies"; शीर्ष="Company"; }
                स्थिर चयनसूची: दृश्य=दृश्य.खंड("select").गुण("name","related_id").जोड़ो(भाषादृश्य.नोड("option","None").गुण("value",""));
                यदि (प.संबंध!="") { चयनसूची.जोड़ो(भाषादृश्य.नोड("option","Current related record").गुण("value",प.संबंध).गुण("selected","selected")); }
                प्रत्येक (भंडार.सूचीलो(स,त,जाति,"",०,असत्य) में र: सीआरएमपंक्ति) { चयनसूची.जोड़ो(दृश्य.शब्द("option",र.नाम).गुण("value",र.पहचान)); }
                फ.जोड़ो(दृश्य.खंड("label").जोड़ो(दृश्य.अक्षर(भाषादृश्य.पाठलो(शीर्ष)+भाषादृश्य.पाठलो(" (first 50; existing selection retained)"))).जोड़ो(चयनसूची));
            }
            फ.जोड़ो(दृश्य.खंड("label").जोड़ो(दृश्य.अक्षर("Notes")).जोड़ो(दृश्य.शब्द("textarea",प.टिप्पणी).गुण("name","notes").गुण("maxlength","4000"))).जोड़ो(भाषादृश्य.भेजो("Save record")); भाग.जोड़ो(फ);
        }
        यदि (प.पहचान!="" && संदर्भ.भूमिका!="viewer") {
            मान संग्रह: पाठ="1"; मान शीर्ष: पाठ="Archive record"; यदि (प.संग्रहित) { संग्रह="0"; शीर्ष="Restore record"; }
            भाग.जोड़ो(दृश्य.फॉर्म(यह.पथ(त,प्रकार)+"/archive",स.सीएसआरएफ()).जोड़ो(दृश्य.छिपा("id",प.पहचान)).जोड़ो(दृश्य.छिपा("version",वेब.अंक(प.संस्करण))).जोड़ो(दृश्य.छिपा("archived",संग्रह)).जोड़ो(भाषादृश्य.भेजो(शीर्ष).गुण("class","danger")));
        }
        भाग.जोड़ो(भाषादृश्य.कड़ी(यह.पथ(त,प्रकार),"Back to list")); लौटाओ यह.ढाँचा(स,त,यह.शीर्षक(प्रकार)+" · "+भाषादृश्य.पाठलो("Record"),भाग,"record");
    }
    निजी फलन रिकॉर्डलो(फ: मानचित्र<पाठ,पाठ>, प्रकार: पाठ) -> सीआरएमपंक्ति {
        यह.शीर्षक(प्रकार);
        प्रत्येक (फ.कुंजियाँ() में न: पाठ) { यदि (!पाठ्य.है("|_csrf|id|version|name|email|phone|notes|related_id|stage|amount_minor|currency|due_date|","|"+न+"|")) { फेंको नया वेबत्रुटि(४२२,"अज्ञात रिकॉर्ड क्षेत्र।"); } }
        स्थिर नाम: पाठ=फॉर्म.मानलो(फ,"name",२००); स्थिर स्थिति: पाठ=फॉर्म.मानलो(फ,"stage",२०);
        मान विकल्पसूची: पाठ="|open|active|inactive|"; यदि (प्रकार=="deals") { विकल्पसूची="|open|won|lost|"; } यदि (प्रकार=="tasks") { विकल्पसूची="|open|done|"; }
        यदि (!पाठ्य.है(विकल्पसूची,"|"+स्थिति+"|")) { फेंको नया वेबत्रुटि(४२२,"अमान्य स्थिति।"); }
        मान राशि: पूर्णांक=०; मान मुद्रा: पाठ="USD"; यदि (प्रकार=="deals") {
            राशि=वेब.संख्या(फॉर्म.मानलो(फ,"amount_minor",१६),१००००००००००००); मुद्रा=फॉर्म.मानलो(फ,"currency",३);
            यदि (!पाठ्य.है("|USD|INR|EUR|GBP|","|"+मुद्रा+"|")) { फेंको नया वेबत्रुटि(४२२,"अमान्य मुद्रा।"); }
        }
        स्थिर तिथि: पाठ=यह.वैकल्पिक(फ,"due_date",१०);
        यदि (तिथि!="") { प्रयास { समय.पढ़ो(तिथि+"T00:00:00.000Z"); } पकड़ो (द: अपवाद) { फेंको नया वेबत्रुटि(४२२,"अमान्य तिथि।"); } }
        स्थिर ईमेल: पाठ=यह.वैकल्पिक(फ,"email",२५४); यदि (ईमेल!="" && (!पाठ्य.है(ईमेल,"@") || पाठ्य.है(ईमेल," ") || पाठ्य.है(ईमेल,"\n") || पाठ्य.है(ईमेल,"\r"))) { फेंको नया वेबत्रुटि(४२२,"अमान्य ईमेल।"); }
        लौटाओ नया सीआरएमपंक्ति(यह.वैकल्पिक(फ,"id",६४),प्रकार,नाम,ईमेल,यह.वैकल्पिक(फ,"phone",६४),यह.वैकल्पिक(फ,"notes",४०००),यह.वैकल्पिक(फ,"related_id",६४),स्थिति,राशि,मुद्रा,तिथि,वेब.संख्या(फॉर्म.मानलो(फ,"version",१०),२१४७४८३६४६),असत्य);
    }
    निजी फलन सदस्यपृष्ठ(स: सत्र, त: पाठ) -> वेबउत्तर {
        स्थिर भाग: दृश्य=दृश्य.खंड("div"); स्थिर सूची: दृश्य=दृश्य.खंड("section");
        प्रत्येक (भंडार.सदस्यसूची(स,त) में प: मानचित्र<पाठ,पाठ>) {
            स्थिर फ: दृश्य=दृश्य.फॉर्म(यह.पथ(त,"members")+"/save",स.सीएसआरएफ()).जोड़ो(दृश्य.छिपा("username",प["name"])).जोड़ो(दृश्य.शब्द("strong",प["name"])).जोड़ो(यह.चुनो("role","Role",प["role"],नया सूची<पाठ>{"owner","editor","viewer"})).जोड़ो(भाषादृश्य.भेजो("Update role"));
            सूची.जोड़ो(दृश्य.खंड("article").जोड़ो(फ).जोड़ो(दृश्य.फॉर्म(यह.पथ(त,"members")+"/remove",स.सीएसआरएफ()).जोड़ो(दृश्य.छिपा("username",प["name"])).जोड़ो(दृश्य.छिपा("role","viewer")).जोड़ो(भाषादृश्य.भेजो("Remove member").गुण("class","danger"))));
        }
        भाग.जोड़ो(सूची).जोड़ो(दृश्य.खंड("section").जोड़ो(भाषादृश्य.नोड("h2","Add a member")).जोड़ो(भाषादृश्य.नोड("p","Use an existing username, or create a new account with a temporary password. Share credentials privately; the owner cannot reset an existing account's password here.")).जोड़ो(दृश्य.फॉर्म(यह.पथ(त,"members")+"/save",स.सीएसआरएफ()).जोड़ो(भाषादृश्य.क्षेत्र("username","Username","text","")).जोड़ो(यह.क्षेत्र("password","Password for a NEW account only (12+ characters)","password","")).जोड़ो(यह.चुनो("role","Role","viewer",नया सूची<पाठ>{"viewer","editor","owner"})).जोड़ो(भाषादृश्य.भेजो("Add member"))));
        लौटाओ यह.ढाँचा(स,त,भाषादृश्य.पाठलो("Members & access"),भाग,"members");
    }
    निजी फलन लेखापृष्ठ(स: सत्र, त: पाठ, अ: वेबअनुरोध) -> वेबउत्तर {
        स्थिर भाग: दृश्य=दृश्य.खंड("section"); स्थिर शरीर: दृश्य=दृश्य.खंड("tbody"); स्थिर अंतर: पूर्णांक=यह.पृष्ठअंतर(अ);
        स्थिर पंक्तियाँ: सूची<मानचित्र<पाठ,पाठ>> =भंडार.लेखासूची(स,त,अंतर);
        प्रत्येक (पंक्तियाँ में प: मानचित्र<पाठ,पाठ>) { शरीर.जोड़ो(दृश्य.खंड("tr").जोड़ो(दृश्य.शब्द("td",प["time"])).जोड़ो(दृश्य.शब्द("td",प["user"])).जोड़ो(भाषादृश्य.नोड("td",प["action"])).जोड़ो(भाषादृश्य.नोड("td",प["entity"]))); }
        भाग.जोड़ो(दृश्य.खंड("table").जोड़ो(दृश्य.खंड("thead").जोड़ो(दृश्य.खंड("tr").जोड़ो(भाषादृश्य.नोड("th","Time (UTC)")).जोड़ो(भाषादृश्य.नोड("th","Actor")).जोड़ो(भाषादृश्य.नोड("th","Action")).जोड़ो(भाषादृश्य.नोड("th","Entity")))).जोड़ो(शरीर));
        यदि (अंतर>=५०) { भाग.जोड़ो(भाषादृश्य.कड़ी(यह.पथ(त,"audit")+"?offset="+वेब.अंक(अंतर-५०),"Previous")); }
        यदि (पंक्तियाँ.आकार==५० && अंतर<९९५०) { भाग.जोड़ो(भाषादृश्य.कड़ी(यह.पथ(त,"audit")+"?offset="+वेब.अंक(अंतर+५०),"Next")); }
        लौटाओ यह.ढाँचा(स,त,भाषादृश्य.पाठलो("Audit trail"),भाग,"audit");
    }
    निजी फलन खातापृष्ठ(स: सत्र) -> वेबउत्तर {
            लौटाओ यह.ढाँचा(स,"",भाषादृश्य.पाठलो("Your account"),दृश्य.खंड("section").जोड़ो(भाषादृश्य.नोड("h2","Language preference")).जोड़ो(भाषादृश्य.नोड("p","Choose your default language. It is used whenever you sign in.")).जोड़ो(दृश्य.फॉर्म("/account/preferences",स.सीएसआरएफ()).जोड़ो(यह.चुनो("language","Default language",भंडार.डिफ़ॉल्टभाषालो(स),नया सूची<पाठ>{"hi","en"})).जोड़ो(भाषादृश्य.भेजो("Save language preference"))).जोड़ो(भाषादृश्य.नोड("h2","Change password")).जोड़ो(भाषादृश्य.नोड("p","Use at least 12 characters. Changing your password signs out all your sessions, including this one.")).जोड़ो(दृश्य.फॉर्म("/account/password",स.सीएसआरएफ()).जोड़ो(भाषादृश्य.क्षेत्र("current_password","Current password","password","")).जोड़ो(भाषादृश्य.क्षेत्र("new_password","New password","password","")).जोड़ो(भाषादृश्य.क्षेत्र("confirm_password","Confirm new password","password","")).जोड़ो(भाषादृश्य.भेजो("Change password and sign out"))),"account");
    }
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर {
        यदि (अ.पथ=="/healthz") { लौटाओ वेब.पाठउत्तर(२००,"ok"); }
        यदि (अ.पथ=="/assets/platform.css") { लौटाओ दृश्य.शैली(); }
        यदि (अ.पथ=="/assets/source-copy.js") { लौटाओ स्रोतप्रकाश.कॉपीलिपि(); }
        मान स: सत्र=म.पाओ(अ);
        यदि (अ.पथ=="/" && (स==रिक्त || स.उपयोगकर्ता()=="")) { यदि (स==रिक्त) { स=म.आरंभ("",नया सूची<पाठ>()); } लौटाओ यह.प्रवेशपृष्ठ(स); }
        यदि (अ.पथ=="/language") {
            स्थिर फ: मानचित्र<पाठ,पाठ> =फॉर्म.पढ़ो(अ);
            प्रत्येक (फ.कुंजियाँ() में कुंजी: पाठ) { यदि (कुंजी!="_csrf" && कुंजी!="language" && कुंजी!="_return") { फेंको नया वेबत्रुटि(४२२,"अज्ञात रिकॉर्ड क्षेत्र।"); } }
            स्थिर भाषा: पाठ=फॉर्म.मानलो(फ,"language",२); मान अगला: पाठ="/";
            यदि (फ.है("_return")) { अगला=फॉर्म.मानलो(फ,"_return",२०४८); }
            प्रयास { दृश्य.सुरक्षितपथ(अगला); } पकड़ो (द: अपवाद) { फेंको नया वेबत्रुटि(४२२,"वापसी का पथ इसी ऐप में होना चाहिए।"); } भंडार.भाषाबदलो(स,भाषा,असत्य); लौटाओ दृश्य.आगे(अगला);
        }
        यदि (अ.पथ=="/login") {
            स्थिर फ: मानचित्र<पाठ,पाठ> =फॉर्म.पढ़ो(अ); स्थिर नाम: पाठ=फॉर्म.मानलो(फ,"username",६४);
            यदि (!फ.है("password") || पाठ्य.यूटीएफ८(फ["password"]).आकार>१०२४) { फेंको नया वेबत्रुटि(४२२,"अमान्य कूटशब्द।"); }
            स्थिर उ: पाठ=भंडार.प्रवेश(नाम,फ["password"]); स्थिर नवीनसत्र: सत्र=म.बदलो(स,उ,नया सूची<पाठ>());
            स्थिर उत्तर: वेबउत्तर=दृश्य.आगे("/"); म.कुकीरखो(उत्तर,नवीनसत्र); लौटाओ उत्तर;
        }
        यदि (स==रिक्त || स.उपयोगकर्ता()=="") { लौटाओ दृश्य.आगे("/"); }
        यदि (अ.पथ=="/logout") { स्थिर उ: वेबउत्तर=दृश्य.आगे("/"); म.समाप्त(अ,उ); लौटाओ उ; }
        यदि (अ.पथ=="/account") {
            लौटाओ यह.खातापृष्ठ(स);
        }
        यदि (अ.पथ=="/account/preferences") {
            स्थिर फ: मानचित्र<पाठ,पाठ> =फॉर्म.पढ़ो(अ);
            प्रत्येक (फ.कुंजियाँ() में कुंजी: पाठ) { यदि (कुंजी!="_csrf" && कुंजी!="language") { फेंको नया वेबत्रुटि(४२२,"अज्ञात रिकॉर्ड क्षेत्र।"); } }
            भंडार.भाषाबदलो(स,फॉर्म.मानलो(फ,"language",२),सत्य); लौटाओ दृश्य.आगे("/account");
        }
        यदि (अ.पथ=="/account/password") {
            स्थिर फ: मानचित्र<पाठ,पाठ> =फॉर्म.पढ़ो(अ);
            यदि (!फ.है("current_password") || !फ.है("new_password") || !फ.है("confirm_password") || फ["new_password"]!=फ["confirm_password"] || पाठ्य.यूटीएफ८(फ["current_password"]).आकार>१०२४) { फेंको नया वेबत्रुटि(४२२,"कूटशब्द पुष्टि और सीमा जाँचें।"); }
            भंडार.कूटबदलो(स,फ["current_password"],फ["new_password"]); स्थिर उ: वेबउत्तर=दृश्य.आगे("/"); म.कुकीमिटाओ(उ); लौटाओ उ;
        }
        यदि (अ.पथ=="/") { लौटाओ यह.संगठनपृष्ठ(स); }
        यदि (अ.पथ=="/tenants") { स्थिर फ: मानचित्र<पाठ,पाठ> =फॉर्म.पढ़ो(अ); स्थिर त: पाठ=भंडार.नयासंगठन(स,फॉर्म.मानलो(फ,"name",२००)); लौटाओ दृश्य.आगे("/t/"+त); }
        स्थिर त: पाठ=अ.पथमान["tenant"];
        यदि (!अ.पथमान.है("kind")) { लौटाओ यह.अवलोकन(स,त); }
        स्थिर प्रकार: पाठ=अ.पथमान["kind"];
        यदि (प्रकार=="members") {
            यदि (अ.विधि=="GET") { लौटाओ यह.सदस्यपृष्ठ(स,त); }
            स्थिर फ: मानचित्र<पाठ,पाठ> =फॉर्म.पढ़ो(अ);
            मान पास: पाठ=""; यदि (फ.है("password")) { पास=फ["password"]; }
            स्थिर अगलापथ: पाठ=भंडार.सदस्यबदलो(स,त,फॉर्म.मानलो(फ,"username",६४),फॉर्म.मानलो(फ,"role",१०),पास,पाठ्य.अंत(अ.पथ,"/remove"));
            लौटाओ दृश्य.आगे(अगलापथ);
        }
        यदि (प्रकार=="audit" && अ.विधि=="GET") { लौटाओ यह.लेखापृष्ठ(स,त,अ); }
        यह.शीर्षक(प्रकार);
        यदि (अ.विधि=="GET") { यदि (अ.पथमान.है("id")) { लौटाओ यह.संपादन(स,त,प्रकार,अ.पथमान["id"]); } लौटाओ यह.सूचीपृष्ठ(स,त,प्रकार,अ); }
        स्थिर फ: मानचित्र<पाठ,पाठ> =फॉर्म.पढ़ो(अ);
        यदि (पाठ्य.अंत(अ.पथ,"/save")) { स्थिर पहचान: पाठ=भंडार.सहेजो(स,त,यह.रिकॉर्डलो(फ,प्रकार)); लौटाओ दृश्य.आगे(यह.पथ(त,प्रकार)+"/"+पहचान); }
        यदि (!पाठ्य.अंत(अ.पथ,"/archive")) { फेंको नया वेबत्रुटि(४०४,"अमान्य क्रिया।"); }
        यदि (!फ.है("archived") || (फ["archived"]!="1" && फ["archived"]!="0")) { फेंको नया वेबत्रुटि(४२२,"अमान्य संग्रह स्थिति।"); }
        भंडार.संग्रहकरो(स,त,प्रकार,फॉर्म.मानलो(फ,"id",६४),वेब.संख्या(फॉर्म.मानलो(फ,"version",१०),२१४७४८३६४६),फ["archived"]=="1");
        लौटाओ दृश्य.आगे(यह.पथ(त,प्रकार));
    }
}

// Language is request-scoped; no shared mutable locale can leak between users.
वर्ग सीआरएमचालक पालन वेबचालक {
    निजी स्थिर भंडार: सीआरएमभंडार; निजी स्थिर म: सत्रप्रबंधक;
    निर्माता(भंडार: सीआरएमभंडार, म: सत्रप्रबंधक) { यह.भंडार=भंडार; यह.म=म; }
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर {
        मान भाषा: पाठ="hi";
        यदि (पाठ्य.आरंभ(अ.पथ,"/source/")) {
            स्थिर भाषाएँ: सूची<पाठ> =अ.प्रश्नमान("language");
            यदि (भाषाएँ.आकार>१) { फेंको नया वेबत्रुटि(४२२,"अमान्य भाषा विकल्प।"); }
            यदि (भाषाएँ.आकार==१) { भाषा=भाषाएँ[०]; }
            सीआरएमभंडार.भाषाजाँचो(भाषा);
            यदि (अ.पथमान.है("part")) { लौटाओ स्रोतदृश्य.अंशदस्तावेज़(नया अनुवाद(भाषा),अ.पथमान["page"],अ.पथमान["part"]); }
            लौटाओ स्रोतदृश्य.दस्तावेज़(नया अनुवाद(भाषा),अ.पथमान["page"]);
        }
        यदि (अ.पथ!="/healthz" && अ.पथ!="/assets/platform.css" && अ.पथ!="/assets/source-copy.js") { भाषा=भंडार.भाषालो(म.पाओ(अ)); }
        लौटाओ नया सीआरएमपृष्ठ(भंडार,म,भाषा,अ.लक्ष्य).संभालो(अ);
    }
}
