// SPDX-License-Identifier: Apache-2.0
आयात अनुप्रयोग.डेटास्रोत; आयात अनुप्रयोग.संगठननीति; आयात अनुप्रयोग.संगठनसंदर्भ;
आयात मानक.डेटासंबंध; आयात मानक.डेटाकथन; आयात मानक.डेटालेनदेन;
आयात मानक.विन्यास; आयात मानक.पाठ्य; आयात मानक.समय; आयात मानक.सुरक्षा; आयात मानक.कूटशब्द; आयात मानक.डेटाचेकसम;
आयात मानक.एचटीटीपीउत्तर; आयात मानक.सत्र; आयात मानक.वेबत्रुटि; आयात मानक.एचटीटीपीअनुरोध; आयात मानक.एचटीटीपी; आयात मानक.जेसन;

// Email ownership is proved BEFORE choosing credentials, preventing pre-hijacked accounts.
वर्ग पंजीकरण {
    निजी स्थिर स्रोत: डेटास्रोत; निजी स्थिर मूल: पाठ; निजी स्थिर कैप्चापता: पाठ; निजी स्थिर मेलपता: पाठ;
    निजी स्थिर सक्षम: तार्किक; निजी स्थिर कुंजी: पाठ; निजी स्थिर गुप्त: पाठ; निजी स्थिर मेलकुंजी: पाठ; निजी स्थिर भेजनेवाला: पाठ; निजी स्थिर होस्ट: पाठ;
    निर्माता(स्रोत: डेटास्रोत, मूल: पाठ, स्थानीय: तार्किक, परीक्षणपता: पाठ) {
        यह.स्रोत=स्रोत; यह.मूल=मूल;
        सक्षम=विन्यास.परिवेश("CRM_SIGNUP_ENABLED","false")=="true";
        कुंजी=विन्यास.परिवेश("CRM_TURNSTILE_SITE_KEY",""); गुप्त=विन्यास.परिवेश("CRM_TURNSTILE_SECRET_KEY","");
        मेलकुंजी=विन्यास.परिवेश("CRM_RESEND_API_KEY",""); भेजनेवाला=विन्यास.परिवेश("CRM_MAIL_FROM","info@bhashitva.org"); होस्ट=विन्यास.परिवेश("CRM_SIGNUP_HOST","bhashcrm.bhashitva.org");
        मान कै: पाठ="https://challenges.cloudflare.com/turnstile/v0/siteverify"; मान मे: पाठ="https://api.resend.com/emails";
        यदि (परीक्षणपता!="") {
            यदि (!स्थानीय || !पाठ्य.आरंभ(परीक्षणपता,"http://127.0.0.1:")) { फेंको नया अपवाद("Signup test transport requires local loopback mode."); }
            कै=परीक्षणपता+"/turnstile"; मे=परीक्षणपता+"/emails";
        } अन्यथा यदि (सक्षम && !स्थानीय && (पाठ्य.आरंभ(कुंजी,"1x000000") || पाठ्य.आरंभ(कुंजी,"2x000000") || पाठ्य.आरंभ(कुंजी,"3x000000"))) { फेंको नया अपवाद("Turnstile test keys cannot enable production signup."); }
        कैप्चापता=कै; मेलपता=मे;
    }
    सार्वजनिक फलन तैयार() -> तार्किक { लौटाओ सक्षम && कुंजी!="" && गुप्त!="" && मेलकुंजी!="" && भेजनेवाला!=""; }
    सार्वजनिक फलन साइटकुंजी() -> पाठ { लौटाओ कुंजी; }
    सार्वजनिक साझा फलन ईमेलजाँचो(मूल: पाठ) -> पाठ {
        स्थिर ई: पाठ=पाठ्य.छोटाअक्षर(पाठ्य.छाँटो(मूल)); स्थिर भाग: सूची<पाठ> =पाठ्य.बाँटो(ई,"@");
        यदि (पाठ्य.लंबाई(ई)>२५४ || भाग.आकार!=२ || भाग[०]=="" || पाठ्य.लंबाई(भाग[०])>६४ || !पाठ्य.है(भाग[१],".") || पाठ्य.आरंभ(भाग[०],".") || पाठ्य.अंत(भाग[०],".") || पाठ्य.है(भाग[०],"..")) { फेंको नया वेबत्रुटि(४२२,"Enter a valid email address."); }
        मान क: पूर्णांक=०; जबतक (क<पाठ्य.लंबाई(भाग[०])) { यदि (!पाठ्य.है("abcdefghijklmnopqrstuvwxyz0123456789.!#$%&'*+-/=?^_`{|}~",पाठ्य.अंश(भाग[०],क,क+१))) { फेंको नया वेबत्रुटि(४२२,"Enter a valid email address."); } क=क+१; }
        प्रत्येक (पाठ्य.बाँटो(भाग[१],".") में ख: पाठ) {
            यदि (ख=="" || पाठ्य.लंबाई(ख)>६३ || पाठ्य.आरंभ(ख,"-") || पाठ्य.अंत(ख,"-")) { फेंको नया वेबत्रुटि(४२२,"Enter a valid email address."); }
            क=०; जबतक (क<पाठ्य.लंबाई(ख)) { यदि (!पाठ्य.है("abcdefghijklmnopqrstuvwxyz0123456789-",पाठ्य.अंश(ख,क,क+१))) { फेंको नया वेबत्रुटि(४२२,"Enter a valid email address."); } क=क+१; }
        } लौटाओ ई;
    }
    निजी साझा फलन तालालो(ड: डेटासंबंध) -> शून्य { संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_lock SET revision=revision WHERE id=1")) { क.चलाओ(); } }
    निजी फलन सीमा(कुंजी: पाठ, सीमा: पूर्णांक, अवधि: पूर्णांक) -> शून्य {
        स्थिर अब: पूर्णांक=समय.अभी(); स्थिर ह: पाठ=डेटाचेकसम.शा२५६(कुंजी);
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            पंजीकरण.तालालो(ड);
            संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM crm_signup_limits WHERE started<=?")) { क.पूर्णांकरखो(१,अब-८६४०००००); क.चलाओ(); }
            मान मिला: तार्किक=असत्य;
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT started,attempts FROM crm_signup_limits WHERE key_hash=?")) { क.पाठरखो(१,ह); यदि (क.अगला()) { मिला=सत्य; यदि (क.पूर्णांकलो(०)>अब || (क.पूर्णांकलो(०)>अब-अवधि && क.पूर्णांकलो(१)>=सीमा)) { फेंको नया वेबत्रुटि(४२९,"Too many signup attempts. Try again later."); } } }
            यदि (!मिला) {
                संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM crm_signup_limits")) { क.अगला(); यदि (क.पूर्णांकलो(०)>=१००००) { फेंको नया वेबत्रुटि(४२९,"Too many signup attempts. Try again later."); } }
                संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO crm_signup_limits(key_hash,started,attempts) VALUES (?,?,0)")) { क.पाठरखो(१,ह); क.पूर्णांकरखो(२,अब); क.चलाओ(); }
            }
            संसाधन (क: डेटाकथन=ड.तैयार("UPDATE crm_signup_limits SET attempts=CASE WHEN started<=? THEN 1 ELSE attempts+1 END, started=CASE WHEN started<=? THEN ? ELSE started END WHERE key_hash=?")) { क.पूर्णांकरखो(१,अब-अवधि); क.पूर्णांकरखो(२,अब-अवधि); क.पूर्णांकरखो(३,अब); क.पाठरखो(४,ह); क.चलाओ(); } ल.सहेजो();
        } }
    }
    निजी फलन कैप्चाजाँचो(स: सत्र, प्रमाण: पाठ) -> शून्य {
        यदि (प्रमाण=="" || पाठ्य.लंबाई(प्रमाण)>२०४८) { फेंको नया वेबत्रुटि(४२२,"Complete the bot check and try again."); }
        स्थिर शरीर: मानचित्र<पाठ,सर्ववस्तु> =नया मानचित्र<पाठ,सर्ववस्तु>(); शरीर["secret"]=गुप्त; शरीर["response"]=प्रमाण;
        प्रयास {
            स्थिर अ: एचटीटीपीअनुरोध=नया एचटीटीपीअनुरोध("POST",कैप्चापता); अ.समयसीमा=२५००; अ.अनुसरणसीमा=०; अ.पाठरखो(जेसन.पाठबनाओ(शरीर)); अ.शीर्षरखो("Content-Type","application/json");
            स्थिर उ: एचटीटीपीउत्तर=एचटीटीपी.भेजो(अ); यदि (उ.स्थिति()!=२०० || उ.सामग्री().आकार>८१९२) { फेंको नया अपवाद("Unavailable"); }
            स्थिर ज: मानचित्र<पाठ,सर्ववस्तु> =परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(जेसन.पढ़ो(उ.पाठ्यांश()));
            यदि (!ज.है("success") || !परिवर्तित<तार्किक>(ज["success"]) || !ज.है("hostname") || परिवर्तित<पाठ>(ज["hostname"])!=होस्ट || !ज.है("action") || परिवर्तित<पाठ>(ज["action"])!="crm-signup" || !ज.है("cdata") || परिवर्तित<पाठ>(ज["cdata"])!=डेटाचेकसम.शा२५६(स.पहचान())) { फेंको नया वेबत्रुटि(४२२,"Complete the bot check and try again."); }
        } पकड़ो (द: वेबत्रुटि) { फेंको द; } पकड़ो (द: अपवाद) { फेंको नया वेबत्रुटि(५०३,"Bot verification is unavailable. Try again later."); }
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            पंजीकरण.तालालो(ड); स्थिर ह: पाठ=डेटाचेकसम.शा२५६(प्रमाण);
            संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM crm_captcha_tokens WHERE expires<=?")) { क.पूर्णांकरखो(१,समय.अभी()); क.चलाओ(); }
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT token_hash FROM crm_captcha_tokens WHERE token_hash=?")) { क.पाठरखो(१,ह); यदि (क.अगला()) { फेंको नया वेबत्रुटि(४२२,"Complete the bot check and try again."); } }
            संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO crm_captcha_tokens(token_hash,expires) VALUES (?,?)")) { क.पाठरखो(१,ह); क.पूर्णांकरखो(२,समय.अभी()+६०००००); क.चलाओ(); } ल.सहेजो();
        } }
    }
    सार्वजनिक फलन अनुरोध(स: सत्र, ईमेल: पाठ, प्रमाण: पाठ, भाषा: पाठ) -> शून्य {
        यदि (!यह.तैयार()) { फेंको नया वेबत्रुटि(५०३,"Account registration is temporarily unavailable."); }
        स्थिर ई: पाठ=पंजीकरण.ईमेलजाँचो(ईमेल); सीआरएमभंडार.भाषाजाँचो(भाषा);
        यह.सीमा("session:"+स.पहचान(),५,३६०००००); यह.सीमा("email:"+ई,३,३६०००००); यह.कैप्चाजाँचो(स,प्रमाण); यह.सीमा("mail-budget",८०,८६४०००००);
        स्थिर ट: पाठ=सुरक्षा.टोकन(); स्थिर ह: पाठ=डेटाचेकसम.शा२५६(ट); स्थिर अब: पूर्णांक=समय.अभी();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            पंजीकरण.तालालो(ड);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT id FROM platform_users WHERE email=?")) { क.पाठरखो(१,ई); यदि (क.अगला()) { ल.सहेजो(); लौटाओ; } }
            संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM crm_email_verifications WHERE expires<=?")) { क.पूर्णांकरखो(१,अब); क.चलाओ(); }
            संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO crm_email_verifications(token_hash,email,language,created,expires,sent) VALUES (?,?,?,?,?,FALSE)")) { क.पाठरखो(१,ह); क.पाठरखो(२,ई); क.पाठरखो(३,भाषा); क.पूर्णांकरखो(४,अब); क.पूर्णांकरखो(५,अब+१८०००००); क.चलाओ(); } ल.सहेजो();
        } }
        प्रयास {
            स्थिर अन: अनुवाद=नया अनुवाद(भाषा); स्थिर शरीर: मानचित्र<पाठ,सर्ववस्तु> =नया मानचित्र<पाठ,सर्ववस्तु>();
            शरीर["from"]=भेजनेवाला; शरीर["to"]=नया सूची<पाठ>{ई}; शरीर["subject"]=अन.पाठलो("Verify your Bhash CRM email");
            शरीर["text"]=अन.पाठलो("Open this link to verify your email and finish creating your account. The link expires in 30 minutes.")+"\n\n"+मूल+"/verify-email?token="+ट+"\n\n"+अन.पाठलो("If you did not request this email, you can ignore it.");
            स्थिर अ: एचटीटीपीअनुरोध=नया एचटीटीपीअनुरोध("POST",मेलपता); अ.समयसीमा=३५००; अ.अनुसरणसीमा=०; अ.पाठरखो(जेसन.पाठबनाओ(शरीर)); अ.शीर्षरखो("Content-Type","application/json"); अ.शीर्षरखो("Authorization","Bearer "+मेलकुंजी); अ.शीर्षरखो("Idempotency-Key","crm-verify-"+ह);
            स्थिर उ: एचटीटीपीउत्तर=एचटीटीपी.भेजो(अ); यदि (उ.स्थिति()<२०० || उ.स्थिति()>=३०० || उ.सामग्री().आकार>८१९२) { फेंको नया अपवाद("Unavailable"); }
            स्थिर ज: मानचित्र<पाठ,सर्ववस्तु> =परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(जेसन.पढ़ो(उ.पाठ्यांश())); यदि (!ज.है("id") || परिवर्तित<पाठ>(ज["id"])=="") { फेंको नया अपवाद("Unavailable"); }
        } पकड़ो (द: अपवाद) {
            संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM crm_email_verifications WHERE token_hash=?")) { क.पाठरखो(१,ह); क.चलाओ(); } }
            फेंको नया वेबत्रुटि(५०३,"Verification email could not be sent. Try again later.");
        }
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार("UPDATE crm_email_verifications SET sent=TRUE WHERE token_hash=?")) { क.पाठरखो(१,ह); क.चलाओ(); } }
    }
    सार्वजनिक फलन विवरण(टोकन: पाठ) -> मानचित्र<पाठ,पाठ> {
        यदि (पाठ्य.लंबाई(टोकन)!=६४) { फेंको नया वेबत्रुटि(४२२,"Verification link is invalid or expired. Request a new email."); }
        मान क: पूर्णांक=०; जबतक (क<६४) { यदि (!पाठ्य.है("0123456789abcdef",पाठ्य.अंश(टोकन,क,क+१))) { फेंको नया वेबत्रुटि(४२२,"Verification link is invalid or expired. Request a new email."); } क=क+१; }
        स्थिर फल: मानचित्र<पाठ,पाठ> =नया मानचित्र<पाठ,पाठ>();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (कथन: डेटाकथन=ड.तैयार("SELECT email,language FROM crm_email_verifications WHERE token_hash=? AND sent=TRUE AND created<=? AND expires>?")) { कथन.पाठरखो(१,डेटाचेकसम.शा२५६(टोकन)); कथन.पूर्णांकरखो(२,समय.अभी()); कथन.पूर्णांकरखो(३,समय.अभी()); यदि (कथन.अगला()) { फल["email"]=कथन.पाठलो(०); फल["language"]=कथन.पाठलो(१); लौटाओ फल; } } }
        फेंको नया वेबत्रुटि(४२२,"Verification link is invalid or expired. Request a new email.");
    }
    सार्वजनिक फलन पूरा(टोकन: पाठ, नाम: पाठ, पास: पाठ, संगठन: पाठ) -> पाठ {
        यदि (!यह.तैयार()) { फेंको नया वेबत्रुटि(५०३,"Account registration is temporarily unavailable."); }
        स्थिर वि: मानचित्र<पाठ,पाठ> =यह.विवरण(टोकन); यह.सीमा("complete:"+टोकन,८,६०००००);
        स्थिर उ: पाठ=सीआरएमभंडार.खातानाम(नाम); सीआरएमभंडार.कूटजाँचो(पास);
        स्थिर सं: पाठ=पाठ्य.छाँटो(संगठन); यदि (सं=="" || पाठ्य.यूटीएफ८(सं).आकार>२००) { फेंको नया वेबत्रुटि(४२२,"Enter an organization name."); }
        स्थिर हैश: पाठ=कूटशब्द.हैशबनाओ(पास); स्थिर पहचान: पाठ=सुरक्षा.टोकन(); स्थिर त: पाठ=सुरक्षा.टोकन();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            पंजीकरण.तालालो(ड);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT id FROM platform_users WHERE username=? OR email=?")) { क.पाठरखो(१,उ); क.पाठरखो(२,वि["email"]); यदि (क.अगला()) { फेंको नया वेबत्रुटि(४०९,"Username or email is already registered. Sign in or choose another username."); } }
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM platform_users")) { क.अगला(); यदि (क.पूर्णांकलो(०)>=१००००) { फेंको नया वेबत्रुटि(४०९,"Account capacity reached."); } }
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM platform_tenants")) { क.अगला(); यदि (क.पूर्णांकलो(०)>=१०००) { फेंको नया वेबत्रुटि(४०९,"Organization capacity reached."); } }
            संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM crm_email_verifications WHERE token_hash=? AND email=? AND sent=TRUE AND expires>?")) { क.पाठरखो(१,डेटाचेकसम.शा२५६(टोकन)); क.पाठरखो(२,वि["email"]); क.पूर्णांकरखो(३,समय.अभी()); यदि (क.चलाओ()!=१) { फेंको नया वेबत्रुटि(४२२,"Verification link is invalid or expired. Request a new email."); } }
            संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO platform_users(id,username,password_hash,active,ui_language,email,email_verified) VALUES (?,?,?,TRUE,?,?,TRUE)")) { क.पाठरखो(१,पहचान); क.पाठरखो(२,उ); क.पाठरखो(३,हैश); क.पाठरखो(४,वि["language"]); क.पाठरखो(५,वि["email"]); क.चलाओ(); }
            संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO platform_tenants(id,name,revision) VALUES (?,?,0)")) { क.पाठरखो(१,त); क.पाठरखो(२,सं); क.चलाओ(); }
            संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO platform_members(tenant_id,user_id,role) VALUES (?,?,'owner')")) { क.पाठरखो(१,त); क.पाठरखो(२,पहचान); क.चलाओ(); }
            संगठननीति.लेखा(ड,नया संगठनसंदर्भ(त,पहचान,"owner"),"create","organization",त);
            संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM crm_email_verifications WHERE email=?")) { क.पाठरखो(१,वि["email"]); क.चलाओ(); } ल.सहेजो();
        } } लौटाओ पहचान;
    }
}
