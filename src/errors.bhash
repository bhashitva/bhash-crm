आयात अनुप्रयोग.दृश्य; आयात अनुप्रयोग.वेबत्रुटिदृश्य;
आयात मानक.वेबअनुरोध; आयात मानक.वेबउत्तर; आयात मानक.वेबत्रुटि;
आयात मानक.सत्रप्रबंधक; आयात मानक.वेब;
आयात मानक.वेबचालक; आयात मानक.लेखा;

// Route misses and unexpected application failures use the same page shell.
वर्ग सीआरएममार्ग पालन वेबचालक {
    निजी स्थिर मार्ग: वेबचालक; निजी स्थिर त्रुटि: सीआरएमत्रुटिदृश्य;
    निर्माता(मार्ग: वेबचालक, त्रुटि: सीआरएमत्रुटिदृश्य) { यह.मार्ग=मार्ग; यह.त्रुटि=त्रुटि; }
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर {
        मान उत्तर: वेबउत्तर=रिक्त;
        प्रयास { उत्तर=मार्ग.संभालो(अ); }
        पकड़ो (द: वेबत्रुटि) { फेंको द; }
        पकड़ो (द: अपवाद) { लेखा.सूचना("CRM अनुरोध में आंतरिक त्रुटि।"); लौटाओ त्रुटि.उत्तर(अ,नया वेबत्रुटि(५००,"Request could not be completed")); }
        यदि (उत्तर.स्थिति==४०४ || उत्तर.स्थिति==४०५) {
            मान संदेश: पाठ="Page not found."; यदि (उत्तर.स्थिति==४०५) { संदेश="Method not allowed."; }
            स्थिर फल: वेबउत्तर=त्रुटि.उत्तर(अ,नया वेबत्रुटि(उत्तर.स्थिति,संदेश));
            मान क: पूर्णांक=०; जबतक (क<उत्तर.शीर्ष.आकार) { यदि (उत्तर.शीर्ष[क]=="allow") { फल.शीर्षरखो("Allow",उत्तर.शीर्ष[क+१]); } क=क+२; }
            लौटाओ फल;
        }
        लौटाओ उत्तर;
    }
}

वर्ग सीआरएमत्रुटिदृश्य पालन वेबत्रुटिदृश्य {
    निजी स्थिर भंडार: सीआरएमभंडार; निजी स्थिर म: सत्रप्रबंधक;
    निर्माता(भंडार: सीआरएमभंडार, म: सत्रप्रबंधक) { यह.भंडार=भंडार; यह.म=म; }
    सार्वजनिक फलन उत्तर(अनुरोध: वेबअनुरोध, दोष: वेबत्रुटि) -> वेबउत्तर {
        मान भाषा: पाठ="hi";
        प्रयास { भाषा=भंडार.भाषालो(म.पाओ(अनुरोध)); } पकड़ो (द: वेबत्रुटि) { भाषा="hi"; }
        स्थिर अ: अनुवाद=नया अनुवाद(भाषा);
        स्थिर उ: वेबउत्तर=अ.पृष्ठ(अ.पाठलो("Request could not be completed"),दृश्य.खंड("main").जोड़ो(अ.नोड("h1","Request could not be completed")).जोड़ो(दृश्य.शब्द("p",अ.पाठलो("Status")+" "+वेब.अंक(दोष.स्थिति))).जोड़ो(अ.नोड("p",दोष.संदेश)).जोड़ो(अ.नोड("p","Refresh the original page before trying again.")).जोड़ो(अ.कड़ी("/","Return to CRM")),"error");
        उ.स्थिति=दोष.स्थिति; लौटाओ उ;
    }
}
