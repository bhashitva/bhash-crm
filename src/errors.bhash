आयात अनुप्रयोग.दृश्य; आयात अनुप्रयोग.वेबत्रुटिदृश्य;
आयात मानक.वेबअनुरोध; आयात मानक.वेबउत्तर; आयात मानक.वेबत्रुटि;
आयात मानक.सत्रप्रबंधक; आयात मानक.वेब;

वर्ग सीआरएमत्रुटिदृश्य पालन वेबत्रुटिदृश्य {
    निजी स्थिर भंडार: सीआरएमभंडार; निजी स्थिर म: सत्रप्रबंधक;
    निर्माता(भंडार: सीआरएमभंडार, म: सत्रप्रबंधक) { यह.भंडार=भंडार; यह.म=म; }
    सार्वजनिक फलन उत्तर(अनुरोध: वेबअनुरोध, दोष: वेबत्रुटि) -> वेबउत्तर {
        मान भाषा: पाठ="hi";
        प्रयास { भाषा=भंडार.भाषालो(म.पाओ(अनुरोध)); } पकड़ो (द: वेबत्रुटि) { भाषा="hi"; }
        स्थिर अ: अनुवाद=नया अनुवाद(भाषा);
        स्थिर उ: वेबउत्तर=अ.पृष्ठ(अ.पाठलो("Request could not be completed"),दृश्य.खंड("main").जोड़ो(अ.नोड("h1","Request could not be completed")).जोड़ो(दृश्य.शब्द("p",अ.पाठलो("Status")+" "+वेब.अंक(दोष.स्थिति))).जोड़ो(अ.नोड("p",दोष.संदेश)).जोड़ो(अ.नोड("p","Refresh the original page before trying again.")).जोड़ो(अ.कड़ी("/","Return to CRM")));
        उ.स्थिति=दोष.स्थिति; लौटाओ उ;
    }
}
