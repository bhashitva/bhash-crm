// SPDX-License-Identifier: Apache-2.0
आयात अनुप्रयोग.डेटास्रोत; आयात अनुप्रयोग.मंच; आयात अनुप्रयोग.संगठननीति; आयात अनुप्रयोग.संगठनसंदर्भ;
आयात मानक.डेटासंबंध; आयात मानक.डेटाकथन; आयात मानक.डेटालेनदेन;
आयात मानक.सत्र; आयात मानक.सुरक्षा; आयात मानक.कूटशब्द; आयात मानक.पाठ्य;
आयात मानक.वेब; आयात मानक.वेबत्रुटि; आयात मानक.विन्यास; आयात मानक.समय;
आयात मानक.डेटाचेकसम;

अभिलेख सीआरएमपंक्ति(पहचान: पाठ, प्रकार: पाठ, नाम: पाठ, ईमेल: पाठ, फ़ोन: पाठ, टिप्पणी: पाठ, संबंध: पाठ, स्थिति: पाठ, राशि: पूर्णांक, मुद्रा: पाठ, तिथि: पाठ, संस्करण: पूर्णांक, संग्रहित: तार्किक);

वर्ग सीआरएमभंडार {
    निजी स्थिर स्रोत: डेटास्रोत;
    निर्माता(स्रोत: डेटास्रोत) { यह.स्रोत=स्रोत; }
    सार्वजनिक साझा फलन भाषाजाँचो(भाषा: पाठ) -> शून्य {
        यदि (भाषा!="hi" && भाषा!="en") { फेंको नया वेबत्रुटि(४२२,"असमर्थित भाषा।"); }
    }
    सार्वजनिक फलन भाषालो(स: सत्र) -> पाठ {
        यदि (स==रिक्त) { लौटाओ "hi"; }
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) {
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT s.display_language,u.ui_language FROM platform_sessions s LEFT JOIN platform_users u ON u.id=s.user_id WHERE s.token_hash=? AND s.csrf=?")) {
                क.पाठरखो(१,डेटाचेकसम.शा२५६(स.पहचान())); क.पाठरखो(२,स.सीएसआरएफ());
                यदि (क.अगला()) {
                    स्थिर सक्रिय: पाठ=क.पाठलो(०); यदि (सक्रिय=="hi" || सक्रिय=="en") { लौटाओ सक्रिय; }
                    यदि (!क.रिक्तहै(१) && क.पाठलो(१)=="en") { लौटाओ "en"; }
                }
            }
        } लौटाओ "hi";
    }
    सार्वजनिक फलन डिफ़ॉल्टभाषालो(स: सत्र) -> पाठ {
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संगठननीति.खाताजाँचो(ड,स);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT ui_language FROM platform_users WHERE id=?")) { क.पाठरखो(१,स.उपयोगकर्ता()); क.अगला(); लौटाओ क.पाठलो(०); }
        }
    }
    निजी फलन सत्रभाषारखो(ड: डेटासंबंध, स: सत्र, भाषा: पाठ) -> शून्य {
        स्थिर अब: पूर्णांक=समय.अभी();
        संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_sessions SET display_language=? WHERE token_hash=? AND csrf=? AND born<=? AND born>? AND touched>?")) {
            क.पाठरखो(१,भाषा); क.पाठरखो(२,डेटाचेकसम.शा२५६(स.पहचान())); क.पाठरखो(३,स.सीएसआरएफ()); क.पूर्णांकरखो(४,अब); क.पूर्णांकरखो(५,अब-२८८०००००); क.पूर्णांकरखो(६,अब-१८०००००);
            यदि (क.चलाओ()!=१) { फेंको नया वेबत्रुटि(४०१,"सत्र उपलब्ध नहीं।"); }
        }
    }
    सार्वजनिक फलन भाषाबदलो(स: सत्र, भाषा: पाठ, डिफ़ॉल्ट: तार्किक) -> शून्य {
        सीआरएमभंडार.भाषाजाँचो(भाषा);
        यदि (स==रिक्त) { फेंको नया वेबत्रुटि(४०१,"प्रवेश आवश्यक।"); }
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            यदि (डिफ़ॉल्ट) {
                संगठननीति.खाताजाँचो(ड,स);
                संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_users SET ui_language=? WHERE id=? AND active=TRUE")) { क.पाठरखो(१,भाषा); क.पाठरखो(२,स.उपयोगकर्ता()); यदि (क.चलाओ()!=१) { फेंको नया वेबत्रुटि(४०१,"खाता उपलब्ध नहीं।"); } }
            }
            यह.सत्रभाषारखो(ड,स,भाषा); ल.सहेजो();
        } }
    }
    सार्वजनिक फलन खाताविवरण(स: सत्र) -> मानचित्र<पाठ,पाठ> {
        स्थिर विवरण: मानचित्र<पाठ,पाठ> =नया मानचित्र<पाठ,पाठ>();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) {
            संगठननीति.खाताजाँचो(ड,स);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT username,COALESCE(email,'') FROM platform_users WHERE id=? AND active=TRUE")) {
                क.पाठरखो(१,स.उपयोगकर्ता()); यदि (!क.अगला()) { फेंको नया वेबत्रुटि(४०१,"खाता उपलब्ध नहीं।"); }
                विवरण["username"]=क.पाठलो(०); विवरण["email"]=क.पाठलो(१);
            }
        } लौटाओ विवरण;
    }
    सार्वजनिक फलन सेटअपचाहिए() -> तार्किक {
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) {
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM platform_users")) { क.अगला(); लौटाओ क.पूर्णांकलो(०)==०; }
        }
    }
    सार्वजनिक साझा फलन खातानाम(नाम: पाठ) -> पाठ {
        मान न: पाठ=पाठ्य.छोटाअक्षर(पाठ्य.छाँटो(नाम));
        // Canonically equivalent Devanagari nukta forms share one login identity.
        स्थिर संयुक्त: सूची<पाठ> =नया सूची<पाठ>{"ऩ","ऱ","ऴ","क़","ख़","ग़","ज़","ड़","ढ़","फ़","य़"};
        स्थिर खुले: सूची<पाठ> =नया सूची<पाठ>{"ऩ","ऱ","ऴ","क़","ख़","ग़","ज़","ड़","ढ़","फ़","य़"};
        मान ज: पूर्णांक=०; जबतक (ज<संयुक्त.आकार) { न=पाठ्य.बदलो(न,संयुक्त[ज],खुले[ज]); ज=ज+१; }
        // Joiners after a virama only affect glyph shaping, not account identity.
        न=पाठ्य.बदलो(पाठ्य.बदलो(न,"्‍","्"),"्‌","्");
        जबतक (पाठ्य.है(न,"  ")) { न=पाठ्य.बदलो(न,"  "," "); }
        यदि (पाठ्य.लंबाई(न)<३ || पाठ्य.लंबाई(न)>६४) { फेंको नया वेबत्रुटि(४२२,"खाता ३–६४ अक्षर चाहिए।"); }
        स्थिर अक्षर: पाठ="अआइईउऊऋऌऍऎएऐऑऒओऔकखगघङचछजझञटठडढणतथदधनपफबभमयरलळवशषसहऄॐॠॡ";
        स्थिर मात्राएँ: पाठ="ऀँंः़ऺऻािीुूृॄॅॆेैॉॊोौ्ॎॏॕॖॗॢॣ";
        मान मूलाक्षर: तार्किक=असत्य;
        मान क: पूर्णांक=०; जबतक (क<पाठ्य.लंबाई(न)) {
            स्थिर च: पाठ=पाठ्य.अंश(न,क,क+१);
            यदि (पाठ्य.है(अक्षर,च)) { मूलाक्षर=सत्य; }
            अन्यथा यदि (पाठ्य.है(मात्राएँ,च) && मूलाक्षर) { }
            अन्यथा यदि (पाठ्य.है("abcdefghijklmnopqrstuvwxyz0123456789०१२३४५६७८९._- ",च)) { मूलाक्षर=असत्य; }
            अन्यथा { फेंको नया वेबत्रुटि(४२२,"खाते में हिन्दी या English अक्षर, अंक, रिक्त स्थान, . _ - दें।"); }
            क=क+१;
        } लौटाओ न;
    }
    सार्वजनिक साझा फलन कूटजाँचो(प: पाठ) -> शून्य {
        यदि (पाठ्य.लंबाई(प)<१२ || पाठ्य.यूटीएफ८(प).आकार>१०२४) { फेंको नया वेबत्रुटि(४२२,"कूटशब्द कम से कम १२ अक्षर और अधिकतम १०२४ UTF-8 बाइट चाहिए।"); }
    }
    निजी फलन उपयोगकर्तालो(ड: डेटासंबंध, नाम: पाठ) -> पाठ {
        संसाधन (क: डेटाकथन=ड.तैयार("SELECT id FROM platform_users WHERE username=? AND active=TRUE")) { क.पाठरखो(१,नाम); यदि (क.अगला()) { लौटाओ क.पाठलो(०); } } लौटाओ "";
    }
    सार्वजनिक फलन प्रवेश(नाम: पाठ, पास: पाठ) -> पाठ {
        स्थिर न: पाठ=सीआरएमभंडार.खातानाम(नाम); मंच.प्रवेशसीमा(स्रोत,न);
        मान पहचान: पाठ=""; मान हैश: पाठ="$bhash$pbkdf2-sha256$600000$000102030405060708090a0b0c0d0e0f$3bc37118e625093e9b79ed08930ea7af7389591233fdd92dddf369371e60dbc0";
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार("SELECT id,password_hash FROM platform_users WHERE username=? AND active=TRUE")) { क.पाठरखो(१,न); यदि (क.अगला()) { पहचान=क.पाठलो(०); हैश=क.पाठलो(१); } } }
        यदि (!कूटशब्द.जाँचो(पास,हैश) || पहचान=="") { फेंको नया वेबत्रुटि(४०१,"प्रवेश असफल।"); } लौटाओ पहचान;
    }
    निजी फलन खाताबनाओ(ड: डेटासंबंध, नाम: पाठ, हैश: पाठ) -> पाठ {
        संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM platform_users")) { क.अगला(); यदि (क.पूर्णांकलो(०)>=१००००) { फेंको नया वेबत्रुटि(४०९,"खाता सीमा।"); } }
        स्थिर पहचान: पाठ=सुरक्षा.टोकन();
        संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO platform_users(id,username,password_hash,active) VALUES (?,?,?,TRUE)")) { क.पाठरखो(१,पहचान); क.पाठरखो(२,नाम); क.पाठरखो(३,हैश); क.चलाओ(); }
        लौटाओ पहचान;
    }
    सार्वजनिक फलन प्रावधान() -> शून्य {
        स्थिर नाम: पाठ=सीआरएमभंडार.खातानाम(विन्यास.परिवेश("BHASH_CRM_USER",""));
        स्थिर पास: पाठ=विन्यास.परिवेश("BHASH_CRM_PASSWORD",""); सीआरएमभंडार.कूटजाँचो(पास);
        स्थिर संगठननाम: पाठ=पाठ्य.छाँटो(विन्यास.परिवेश("BHASH_CRM_TENANT","My organization"));
        यदि (संगठननाम=="" || पाठ्य.यूटीएफ८(संगठननाम).आकार>२००) { फेंको नया अपवाद("अमान्य संगठन नाम।"); }
        स्थिर हैश: पाठ=कूटशब्द.हैशबनाओ(पास);
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_lock SET revision=revision WHERE id=1")) { क.चलाओ(); }
            यदि (यह.उपयोगकर्तालो(ड,नाम)!="") { फेंको नया अपवाद("खाता पहले से है; मौजूदा CRM में नया संगठन बनाएँ।"); }
            स्थिर उ: पाठ=यह.खाताबनाओ(ड,नाम,हैश); स्थिर त: पाठ=यह.संगठनबनाओ(ड,उ,संगठननाम); ल.सहेजो(); लिखो("Created organization "+त+" for "+नाम);
        } }
    }
    निजी फलन संगठनबनाओ(ड: डेटासंबंध, उ: पाठ, नाम: पाठ) -> पाठ {
        संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM platform_tenants")) { क.अगला(); यदि (क.पूर्णांकलो(०)>=१०००) { फेंको नया वेबत्रुटि(४०९,"संगठन क्षमता।"); } }
        संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM platform_members WHERE user_id=? AND role='owner'")) { क.पाठरखो(१,उ); क.अगला(); यदि (क.पूर्णांकलो(०)>=२०) { फेंको नया वेबत्रुटि(४०९,"मालिक संगठन सीमा।"); } }
        स्थिर त: पाठ=सुरक्षा.टोकन();
        संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO platform_tenants(id,name,revision) VALUES (?,?,0)")) { क.पाठरखो(१,त); क.पाठरखो(२,नाम); क.चलाओ(); }
        संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO platform_members(tenant_id,user_id,role) VALUES (?,?,'owner')")) { क.पाठरखो(१,त); क.पाठरखो(२,उ); क.चलाओ(); }
        संगठननीति.लेखा(ड,नया संगठनसंदर्भ(त,उ,"owner"),"create","tenant",त); लौटाओ त;
    }
    सार्वजनिक फलन नयासंगठन(स: सत्र, नाम: पाठ) -> पाठ {
        यदि (नाम=="" || पाठ्य.यूटीएफ८(नाम).आकार>२००) { फेंको नया वेबत्रुटि(४२२,"अमान्य नाम।"); }
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_lock SET revision=revision WHERE id=1")) { क.चलाओ(); }
            यह.जीवितखाता(ड,स); स्थिर त: पाठ=यह.संगठनबनाओ(ड,स.उपयोगकर्ता(),नाम); ल.सहेजो(); लौटाओ त;
        } }
    }
    निजी फलन जीवितखाता(ड: डेटासंबंध, स: सत्र) -> शून्य {
        संगठननीति.खाताजाँचो(ड,स);
    }
    सार्वजनिक फलन कूटबदलो(स: सत्र, पुराना: पाठ, नवीन: पाठ) -> शून्य {
        सीआरएमभंडार.कूटजाँचो(नवीन); मंच.प्रवेशसीमा(स्रोत,"password:"+स.उपयोगकर्ता());
        मान हैश: पाठ="";
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { यह.जीवितखाता(ड,स);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT password_hash FROM platform_users WHERE id=?")) { क.पाठरखो(१,स.उपयोगकर्ता()); क.अगला(); हैश=क.पाठलो(०); }
        }
        यदि (!कूटशब्द.जाँचो(पुराना,हैश)) { फेंको नया वेबत्रुटि(४०१,"वर्तमान कूटशब्द गलत है।"); }
        स्थिर नवीनहैश: पाठ=कूटशब्द.हैशबनाओ(नवीन);
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_lock SET revision=revision WHERE id=1")) { क.चलाओ(); }
            यह.जीवितखाता(ड,स);
            संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_users SET password_hash=? WHERE id=? AND password_hash=? AND active=TRUE")) { क.पाठरखो(१,नवीनहैश); क.पाठरखो(२,स.उपयोगकर्ता()); क.पाठरखो(३,हैश); यदि (क.चलाओ()!=१) { फेंको नया वेबत्रुटि(४०९,"खाता बदल गया; फिर प्रवेश करें।"); } }
            संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM platform_sessions WHERE user_id=?")) { क.पाठरखो(१,स.उपयोगकर्ता()); क.चलाओ(); }
            संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM crm_password_resets WHERE user_id=?")) { क.पाठरखो(१,स.उपयोगकर्ता()); क.चलाओ(); }
            ल.सहेजो();
        } }
    }
    सार्वजनिक फलन संगठनसूची(स: सत्र) -> सूची<मानचित्र<पाठ,पाठ>> {
        स्थिर फल: सूची<मानचित्र<पाठ,पाठ>> =नया सूची<मानचित्र<पाठ,पाठ>>();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { यह.जीवितखाता(ड,स);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT t.id,t.name,m.role FROM platform_tenants t JOIN platform_members m ON m.tenant_id=t.id WHERE m.user_id=? ORDER BY t.name,t.id LIMIT 1000")) { क.पाठरखो(१,स.उपयोगकर्ता());
                जबतक (क.अगला()) { स्थिर प: मानचित्र<पाठ,पाठ> =नया मानचित्र<पाठ,पाठ>(); प["id"]=क.पाठलो(०); प["name"]=क.पाठलो(१); प["role"]=क.पाठलो(२); फल.जोड़ो(प); }
            }
        } लौटाओ फल;
    }
    सार्वजनिक फलन संदर्भ(स: सत्र, त: पाठ) -> संगठनसंदर्भ { संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { लौटाओ संगठननीति.जाँचो(ड,स,त,असत्य,असत्य); } }
    सार्वजनिक फलन संगठननाम(स: सत्र, त: पाठ) -> पाठ {
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संगठननीति.जाँचो(ड,स,त,असत्य,असत्य);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT name FROM platform_tenants WHERE id=?")) { क.पाठरखो(१,त); क.अगला(); लौटाओ क.पाठलो(०); }
        }
    }
    निजी फलन पंक्तिलो(क: डेटाकथन) -> सीआरएमपंक्ति {
        मान संबंध: पाठ=""; यदि (!क.रिक्तहै(७)) { संबंध=क.पाठलो(७); }
        लौटाओ नया सीआरएमपंक्ति(क.पाठलो(०),क.पाठलो(१),क.पाठलो(२),क.पाठलो(३),क.पाठलो(४),क.पाठलो(५),संबंध,क.पाठलो(६),क.पूर्णांकलो(८),क.पाठलो(९),क.पाठलो(१०),क.पूर्णांकलो(११),क.तार्किकलो(१२));
    }
    सार्वजनिक फलन सूचीलो(स: सत्र, त: पाठ, प्रकार: पाठ, खोज: पाठ, अंतर: पूर्णांक, संग्रहित: तार्किक) -> सूची<सीआरएमपंक्ति> {
        स्थिर फल: सूची<सीआरएमपंक्ति> =नया सूची<सीआरएमपंक्ति>();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संगठननीति.जाँचो(ड,स,त,असत्य,असत्य);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT id,kind,name,email,phone,notes,stage,related_id,amount_minor,currency,due_date,version,archived FROM crm_records WHERE tenant_id=? AND kind=? AND archived=? AND LOWER(name) LIKE ? ORDER BY name,id LIMIT 50 OFFSET ?")) {
                क.पाठरखो(१,त); क.पाठरखो(२,प्रकार); क.तार्किकरखो(३,संग्रहित); क.पाठरखो(४,"%"+पाठ्य.छोटाअक्षर(खोज)+"%"); क.पूर्णांकरखो(५,अंतर);
                जबतक (क.अगला()) { फल.जोड़ो(यह.पंक्तिलो(क)); }
            }
        } लौटाओ फल;
    }
    सार्वजनिक फलन पाओ(स: सत्र, त: पाठ, प्रकार: पाठ, पहचान: पाठ) -> सीआरएमपंक्ति {
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संगठननीति.जाँचो(ड,स,त,असत्य,असत्य);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT id,kind,name,email,phone,notes,stage,related_id,amount_minor,currency,due_date,version,archived FROM crm_records WHERE tenant_id=? AND kind=? AND id=?")) {
                क.पाठरखो(१,त); क.पाठरखो(२,प्रकार); क.पाठरखो(३,पहचान); यदि (!क.अगला()) { फेंको नया वेबत्रुटि(४०४,"रिकॉर्ड उपलब्ध नहीं।"); } लौटाओ यह.पंक्तिलो(क);
            }
        }
    }
    सार्वजनिक फलन सहेजो(स: सत्र, त: पाठ, प: सीआरएमपंक्ति) -> पाठ {
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            संगठननीति.तालालो(ड,त); स्थिर संदर्भ: संगठनसंदर्भ=संगठननीति.जाँचो(ड,स,त,सत्य,असत्य);
            यदि (प.संबंध!="") {
                मान अपेक्षित: पाठ="contacts"; यदि (प.प्रकार=="contacts") { अपेक्षित="companies"; }
                यदि (प.प्रकार=="companies" || प.संबंध==प.पहचान) { फेंको नया वेबत्रुटि(४२२,"अमान्य संबंध।"); }
                संसाधन (क: डेटाकथन=ड.तैयार("SELECT id FROM crm_records WHERE tenant_id=? AND id=? AND kind=? AND archived=FALSE")) { क.पाठरखो(१,त); क.पाठरखो(२,प.संबंध); क.पाठरखो(३,अपेक्षित); यदि (!क.अगला()) { फेंको नया वेबत्रुटि(४२२,"संबंध इसी संगठन के सक्रिय रिकॉर्ड से चाहिए।"); } }
            }
            मान पहचान: पाठ=प.पहचान; मान एसक्यूएल: पाठ="UPDATE crm_records SET name=?,email=?,phone=?,notes=?,stage=?,related_id=?,amount_minor=?,currency=?,due_date=?,version=version+1 WHERE tenant_id=? AND kind=? AND id=? AND version=? AND archived=FALSE";
            यदि (पहचान=="") {
                संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM crm_records WHERE tenant_id=?")) { क.पाठरखो(१,त); क.अगला(); यदि (क.पूर्णांकलो(०)>=१००००) { फेंको नया वेबत्रुटि(४०९,"संगठन रिकॉर्ड सीमा।"); } }
                पहचान=सुरक्षा.टोकन(); एसक्यूएल="INSERT INTO crm_records(name,email,phone,notes,stage,related_id,amount_minor,currency,due_date,tenant_id,kind,id,version,archived) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,1,FALSE)";
            }
            संसाधन (क: डेटाकथन=ड.तैयार(एसक्यूएल)) {
                क.पाठरखो(१,प.नाम); क.पाठरखो(२,प.ईमेल); क.पाठरखो(३,प.फ़ोन); क.पाठरखो(४,प.टिप्पणी); क.पाठरखो(५,प.स्थिति);
                यदि (प.संबंध=="") { क.रिक्तरखो(६); } अन्यथा { क.पाठरखो(६,प.संबंध); }
                क.पूर्णांकरखो(७,प.राशि); क.पाठरखो(८,प.मुद्रा); क.पाठरखो(९,प.तिथि); क.पाठरखो(१०,त); क.पाठरखो(११,प.प्रकार); क.पाठरखो(१२,पहचान);
                यदि (प.पहचान!="") { क.पूर्णांकरखो(१३,प.संस्करण); }
                यदि (क.चलाओ()!=१) { फेंको नया वेबत्रुटि(४०९,"रिकॉर्ड बदल गया; नया रिकॉर्ड पढ़ें।"); }
            }
            मान क्रिया: पाठ="update"; यदि (प.पहचान=="") { क्रिया="create"; }
            संगठननीति.लेखा(ड,संदर्भ,क्रिया,प.प्रकार,पहचान); ल.सहेजो(); लौटाओ पहचान;
        } }
    }
    सार्वजनिक फलन संग्रहकरो(स: सत्र, त: पाठ, प्रकार: पाठ, पहचान: पाठ, संस्करण: पूर्णांक, संग्रहित: तार्किक) -> शून्य {
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            संगठननीति.तालालो(ड,त); स्थिर संदर्भ: संगठनसंदर्भ=संगठननीति.जाँचो(ड,स,त,सत्य,असत्य);
            यदि (संग्रहित) { संसाधन (क: डेटाकथन=ड.तैयार("SELECT id FROM crm_records WHERE tenant_id=? AND related_id=? AND archived=FALSE LIMIT 1")) { क.पाठरखो(१,त); क.पाठरखो(२,पहचान); यदि (क.अगला()) { फेंको नया वेबत्रुटि(४०९,"सक्रिय संबंधित रिकॉर्ड पहले अलग करें।"); } } }
            अन्यथा { संसाधन (क: डेटाकथन=ड.तैयार("SELECT r.id FROM crm_records r JOIN crm_records parent ON parent.tenant_id=r.tenant_id AND parent.id=r.related_id WHERE r.tenant_id=? AND r.id=? AND r.kind=? AND parent.archived=TRUE")) { क.पाठरखो(१,त); क.पाठरखो(२,पहचान); क.पाठरखो(३,प्रकार); यदि (क.अगला()) { फेंको नया वेबत्रुटि(४०९,"संबंधित रिकॉर्ड पहले वापस लाएँ।"); } } }
            संसाधन (क: डेटाकथन=ड.तैयार("UPDATE crm_records SET archived=?,version=version+1 WHERE tenant_id=? AND kind=? AND id=? AND version=? AND archived<>?")) {
                क.तार्किकरखो(१,संग्रहित); क.पाठरखो(२,त); क.पाठरखो(३,प्रकार); क.पाठरखो(४,पहचान); क.पूर्णांकरखो(५,संस्करण); क.तार्किकरखो(६,संग्रहित);
                यदि (क.चलाओ()!=१) { फेंको नया वेबत्रुटि(४०९,"रिकॉर्ड बदल गया।"); }
            }
            मान क्रिया: पाठ="restore"; यदि (संग्रहित) { क्रिया="archive"; } संगठननीति.लेखा(ड,संदर्भ,क्रिया,प्रकार,पहचान); ल.सहेजो();
        } }
    }
    सार्वजनिक फलन सदस्यसूची(स: सत्र, त: पाठ) -> सूची<मानचित्र<पाठ,पाठ>> {
        स्थिर फल: सूची<मानचित्र<पाठ,पाठ>> =नया सूची<मानचित्र<पाठ,पाठ>>();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संगठननीति.जाँचो(ड,स,त,असत्य,सत्य);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT u.id,u.username,m.role FROM platform_members m JOIN platform_users u ON u.id=m.user_id WHERE m.tenant_id=? ORDER BY u.username LIMIT 100")) { क.पाठरखो(१,त); जबतक (क.अगला()) { स्थिर प: मानचित्र<पाठ,पाठ> =नया मानचित्र<पाठ,पाठ>(); प["id"]=क.पाठलो(०); प["name"]=क.पाठलो(१); प["role"]=क.पाठलो(२); फल.जोड़ो(प); } }
        } लौटाओ फल;
    }
    सार्वजनिक फलन सदस्यबदलो(स: सत्र, त: पाठ, नाम: पाठ, भूमिका: पाठ, पास: पाठ, हटाना: तार्किक) -> पाठ {
        स्थिर न: पाठ=सीआरएमभंडार.खातानाम(नाम);
        यदि (भूमिका!="owner" && भूमिका!="editor" && भूमिका!="viewer") { फेंको नया वेबत्रुटि(४२२,"अमान्य भूमिका।"); }
        // Authorize before password hashing or global account access.
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संगठननीति.जाँचो(ड,स,त,सत्य,सत्य); }
        मान हैश: पाठ=""; यदि (पास!="") { सीआरएमभंडार.कूटजाँचो(पास); हैश=कूटशब्द.हैशबनाओ(पास); }
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            संगठननीति.तालालो(ड,त); स्थिर संदर्भ: संगठनसंदर्भ=संगठननीति.जाँचो(ड,स,त,सत्य,सत्य);
            संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_lock SET revision=revision WHERE id=1")) { क.चलाओ(); }
            मान उ: पाठ=यह.उपयोगकर्तालो(ड,न);
            यदि (उ=="") { यदि (हैश=="" || हटाना) { फेंको नया वेबत्रुटि(४२२,"नए खाते के लिए कूटशब्द दें।"); } उ=यह.खाताबनाओ(ड,न,हैश); }
            अन्यथा यदि (पास!="") { फेंको नया वेबत्रुटि(४२२,"मौजूदा खाते का कूटशब्द यहाँ नहीं बदलता।"); }
            मान पुरानी: पाठ="";
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT role FROM platform_members WHERE tenant_id=? AND user_id=?")) { क.पाठरखो(१,त); क.पाठरखो(२,उ); यदि (क.अगला()) { पुरानी=क.पाठलो(०); } }
            यदि (पुरानी=="owner" && (हटाना || भूमिका!="owner")) {
                संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM platform_members WHERE tenant_id=? AND role='owner'")) { क.पाठरखो(१,त); क.अगला(); यदि (क.पूर्णांकलो(०)<=१) { फेंको नया वेबत्रुटि(४०९,"कम से कम एक मालिक चाहिए।"); } }
            }
            मान प्रभावीभूमिका: पाठ=भूमिका;
            मान एसक्यूएल: पाठ="UPDATE platform_members SET role=? WHERE tenant_id=? AND user_id=?";
            यदि (हटाना) { एसक्यूएल="DELETE FROM platform_members WHERE role<>? AND tenant_id=? AND user_id=?"; प्रभावीभूमिका="never"; }
            अन्यथा यदि (पुरानी=="") {
                संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM platform_members WHERE tenant_id=?")) { क.पाठरखो(१,त); क.अगला(); यदि (क.पूर्णांकलो(०)>=१००) { फेंको नया वेबत्रुटि(४०९,"सदस्य सीमा।"); } }
                एसक्यूएल="INSERT INTO platform_members(role,tenant_id,user_id) VALUES (?,?,?)";
            }
            संसाधन (क: डेटाकथन=ड.तैयार(एसक्यूएल)) { क.पाठरखो(१,प्रभावीभूमिका); क.पाठरखो(२,त); क.पाठरखो(३,उ); यदि (क.चलाओ()!=१) { फेंको नया वेबत्रुटि(४०४,"सदस्य उपलब्ध नहीं।"); } }
            संगठननीति.लेखा(ड,संदर्भ,"membership","user",उ); ल.सहेजो();
            यदि (उ==स.उपयोगकर्ता() && (हटाना || भूमिका!="owner")) { लौटाओ "/"; }
            लौटाओ "/t/"+त+"/members";
        } }
    }
    सार्वजनिक फलन लेखासूची(स: सत्र, त: पाठ, अंतर: पूर्णांक) -> सूची<मानचित्र<पाठ,पाठ>> {
        स्थिर फल: सूची<मानचित्र<पाठ,पाठ>> =नया सूची<मानचित्र<पाठ,पाठ>>();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संगठननीति.जाँचो(ड,स,त,असत्य,सत्य);
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT a.action,a.entity,a.entity_id,u.username,a.created FROM platform_audit a JOIN platform_users u ON u.id=a.actor WHERE a.tenant_id=? ORDER BY a.created DESC,a.id LIMIT 50 OFFSET ?")) {
                क.पाठरखो(१,त); क.पूर्णांकरखो(२,अंतर); जबतक (क.अगला()) { स्थिर प: मानचित्र<पाठ,पाठ> =नया मानचित्र<पाठ,पाठ>(); प["action"]=क.पाठलो(०); प["entity"]=क.पाठलो(१); प["id"]=क.पाठलो(२); प["user"]=क.पाठलो(३); प["time"]=समय.पाठबनाओ(क.पूर्णांकलो(४)); फल.जोड़ो(प); }
            }
        } लौटाओ फल;
    }
}
