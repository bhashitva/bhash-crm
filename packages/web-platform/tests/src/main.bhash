आयात अनुप्रयोग.दृश्य; आयात अनुप्रयोग.फॉर्म;
आयात अनुप्रयोग.स्थायीसत्र; आयात अनुप्रयोग.डेटास्रोत;
आयात मानक.वेबअनुरोध; आयात मानक.वेबत्रुटि; आयात मानक.पाठ्य; आयात मानक.परीक्षण;

फलन अस्वीकारफॉर्म(पाठ्यांश: पाठ, स्थिति: पूर्णांक) -> शून्य {
    मान असफल: तार्किक=असत्य;
    प्रयास { फॉर्म.पढ़ो(नया वेबअनुरोध("POST","/",नया सूची<पाठ>{"content-type","application/x-www-form-urlencoded"},पाठ्य.यूटीएफ८(पाठ्यांश))); }
    पकड़ो (द: वेबत्रुटि) { परीक्षण.बराबर(स्थिति,द.स्थिति); असफल=सत्य; }
    परीक्षण.सत्यहै(असफल,"फॉर्म अस्वीकार होना चाहिए।");
}
फलन मूलनीतिजाँचो(म: स्थायीसत्र, होस्ट: पाठ, मूल: पाठ, अपेक्षित: पूर्णांक) -> शून्य {
    मान मिला: पूर्णांक=२००;
    प्रयास { म.मूलजाँचो(नया वेबअनुरोध("GET","/",नया सूची<पाठ>{"host",होस्ट,"origin",मूल},नया बाइटबफ़र(०))); }
    पकड़ो (द: वेबत्रुटि) { मिला=द.स्थिति; }
    परीक्षण.बराबर(अपेक्षित,मिला);
}
फलन मुख्य() -> शून्य {
    स्थिर स्रोत: डेटास्रोत=नया डेटास्रोत("sqlite",":memory:");
    प्रत्येक (नया सूची<पाठ>{"http://127.0.0.1:8123","http://localhost:8123"} में मूल: पाठ) {
        संसाधन (म: स्थायीसत्र=नया स्थायीसत्र(स्रोत,मूल,सत्य)) {
            मूलनीतिजाँचो(म,"127.0.0.1:8123","http://127.0.0.1:8123",२००);
            मूलनीतिजाँचो(म,"localhost:8123","http://localhost:8123",२००);
            मूलनीतिजाँचो(म,"LOCALHOST:8123","http://localhost:8123",२००);
            मूलनीतिजाँचो(म,"127.0.0.1:8123","http://localhost:8123",४०३);
            मूलनीतिजाँचो(म,"localhost:8123","http://127.0.0.1:8123",४०३);
            मूलनीतिजाँचो(म,"localhost:8123","http://localhost:8124",४०३);
            मूलनीतिजाँचो(म,"localhost.evil.example:8123","http://localhost.evil.example:8123",४०३);
        }
    }
    संसाधन (म: स्थायीसत्र=नया स्थायीसत्र(स्रोत,"https://crm.example",असत्य)) {
        मूलनीतिजाँचो(म,"crm.example","https://crm.example",२००);
        मूलनीतिजाँचो(म,"localhost","http://localhost",४०३);
        मूलनीतिजाँचो(म,"127.0.0.1","http://127.0.0.1",४०३);
    }
    परीक्षण.बराबर("&lt;script&gt;&amp;&quot;&#39;",दृश्य.अक्षर("<script>&\"'").एचटीएमएल());
    परीक्षण.बराबर("<input type=\"hidden\" name=\"id\" value=\"&quot;&gt;&lt;script&gt;\">",दृश्य.छिपा("id","\"><script>").एचटीएमएल());
    प्रत्येक (नया सूची<पाठ>{"javascript:alert(1)","//evil.example","/\\evil","/ok\nLocation:evil"} में पथ: पाठ) {
        मान असफल: तार्किक=असत्य; प्रयास { दृश्य.कड़ी(पथ,"bad"); } पकड़ो (द: अपवाद) { असफल=सत्य; } परीक्षण.सत्यहै(असफल,"असुरक्षित कड़ी।");
    }
    मान असफल: तार्किक=असत्य; प्रयास { दृश्य.खंड("script"); } पकड़ो (द: अपवाद) { असफल=सत्य; } परीक्षण.सत्यहै(असफल,"script असमर्थित।");
    असफल=असत्य; प्रयास { दृश्य.खंड("a").गुण("onclick","alert(1)"); } पकड़ो (द: अपवाद) { असफल=सत्य; } परीक्षण.सत्यहै(असफल,"event गुण असमर्थित।");
    स्थिर फ: मानचित्र<पाठ,पाठ> = फॉर्म.पढ़ो(नया वेबअनुरोध("POST","/",नया सूची<पाठ>{"content-type","application/x-www-form-urlencoded; charset=utf-8"},पाठ्य.यूटीएफ८("name=%E0%A4%AD%E0%A4%BE%E0%A4%B7&notes=one%0Atwo&plus=%2B+%26&empty=")));
    परीक्षण.बराबर("भाष",फ["name"]); परीक्षण.बराबर("one\ntwo",फ["notes"]); परीक्षण.बराबर("+ &",फ["plus"]); परीक्षण.बराबर("",फ["empty"]);
    अस्वीकारफॉर्म("name=a&name=b",४००); अस्वीकारफॉर्म("%6Eame=a&name=b",४००);
    अस्वीकारफॉर्म("name=%FF",४००); अस्वीकारफॉर्म("name=%00",४००); अस्वीकारफॉर्म("name=%G0",४००); अस्वीकारफॉर्म("name=%",४००);
    अस्वीकारफॉर्म("name="+पाठ्य.दोहराओ("x",८१९३),४००);
    लिखो("PASS: local origin aliases, strict production origins, escaped UI trees and UTF-8 form bounds");
}
