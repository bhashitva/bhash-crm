// SPDX-License-Identifier: Apache-2.0
संकुल अनुप्रयोग;
आयात मानक.सत्रप्रबंधक; आयात मानक.सत्र; आयात मानक.कुकी;
आयात मानक.पाठ्य; आयात मानक.सुरक्षा; आयात मानक.समय; आयात मानक.डेटाचेकसम;
आयात मानक.डेटासंबंध; आयात मानक.डेटाकथन; आयात मानक.डेटालेनदेन;
आयात मानक.वेबअनुरोध; आयात मानक.वेबउत्तर; आयात मानक.वेबत्रुटि;

// Database-backed sessions work across cooperating processes. Tokens are never
// stored in plaintext. Membership roles are deliberately read separately per request.
सार्वजनिक वर्ग स्थायीसत्र विस्तार सत्रप्रबंधक {
    निजी स्थिर स्रोत: डेटास्रोत;
    निजी स्थिर नीति: सत्रप्रबंधक;
    निजी मान दूसरीनीति: सत्रप्रबंधक;
    निजी मान दूसराहोस्ट: पाठ="";
    निजी स्थिर विकासमोड: तार्किक;
    निजी मान सेवाबंद: तार्किक=असत्य;
    सार्वजनिक निर्माता(स्रोत: डेटास्रोत, मूल: पाठ, विकासमोड: तार्किक) : आधार("https://localhost") {
        यह.स्रोत=स्रोत; यह.विकासमोड=विकासमोड;
        यदि (विकासमोड) {
            नीति=सत्रप्रबंधक.स्थानीय(मूल);
            मान दूसरा: पाठ="";
            यदि (पाठ्य.आरंभ(मूल,"http://127.0.0.1")) { दूसरा="http://localhost"+पाठ्य.अंश(मूल,पाठ्य.लंबाई("http://127.0.0.1"),पाठ्य.लंबाई(मूल)); }
            अन्यथा { दूसरा="http://127.0.0.1"+पाठ्य.अंश(मूल,पाठ्य.लंबाई("http://localhost"),पाठ्य.लंबाई(मूल)); }
            दूसरीनीति=सत्रप्रबंधक.स्थानीय(दूसरा); दूसराहोस्ट=पाठ्य.अंश(दूसरा,७,पाठ्य.लंबाई(दूसरा));
        } अन्यथा { नीति=नया सत्रप्रबंधक(मूल); }
    }
    निजी फलन नाम() -> पाठ { यदि (विकासमोड) { लौटाओ "bhash-local-session"; } लौटाओ "__Host-bhash-session"; }
    निजी फलन जाँचो() -> शून्य { यदि (सेवाबंद) { फेंको नया अपवाद("सत्र सेवा सेवाबंद है।"); } }
    सार्वजनिक अधिलेखन फलन मूलजाँचो(अ: वेबअनुरोध) -> शून्य {
        यह.जाँचो();
        स्थिर होस्ट: सूची<पाठ> = कुकी.शीर्षलो(अ,"host");
        यदि (दूसरीनीति!=रिक्त && होस्ट.आकार==१ && पाठ्य.छोटाअक्षर(होस्ट[०])==दूसराहोस्ट) {
            दूसरीनीति.मूलजाँचो(अ);
        } अन्यथा { नीति.मूलजाँचो(अ); }
    }
    सार्वजनिक अधिलेखन फलन पाओ(अ: वेबअनुरोध) -> सत्र {
        यह.मूलजाँचो(अ); स्थिर ट: पाठ=कुकी.पढ़ो(अ,यह.नाम());
        यदि (पाठ्य.लंबाई(ट)!=६४) { लौटाओ रिक्त; }
        मान क्रम: पूर्णांक=०; जबतक (क्रम<६४) { यदि (!पाठ्य.है("0123456789abcdef",पाठ्य.अंश(ट,क्रम,क्रम+१))) { लौटाओ रिक्त; } क्रम=क्रम+१; }
        स्थिर ह: पाठ=डेटाचेकसम.शा२५६(ट); स्थिर अब: पूर्णांक=समय.अभी();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) {
            // Never move touched backwards when another worker has already advanced it.
            // A time captured before waiting on a row lock is not a clock-regression signal.
            संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_sessions SET touched=CASE WHEN touched>? THEN touched ELSE ? END WHERE token_hash=? AND born<=? AND born>? AND touched>?")) {
                क.पूर्णांकरखो(१,अब); क.पूर्णांकरखो(२,अब); क.पाठरखो(३,ह); क.पूर्णांकरखो(४,अब); क.पूर्णांकरखो(५,अब-२८८०००००); क.पूर्णांकरखो(६,अब-१८०००००);
                यदि (क.चलाओ()!=१) { लौटाओ रिक्त; }
            }
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT user_id,csrf FROM platform_sessions WHERE token_hash=?")) {
                क.पाठरखो(१,ह); यदि (!क.अगला()) { लौटाओ रिक्त; }
                लौटाओ नया सत्र(ट,क.पाठलो(०),क.पाठलो(१),नया सूची<पाठ>());
            }
        }
    }
    सार्वजनिक अधिलेखन फलन आरंभ(उ: पाठ, भूमिकाएँ: सूची<पाठ>) -> सत्र {
        यह.जाँचो(); यदि (भूमिकाएँ.आकार!=० || पाठ्य.लंबाई(उ)>२५६) { फेंको नया अपवाद("भूमिकाएँ संगठन सदस्यता से लें।"); }
        स्थिर स: सत्र=नया सत्र(सुरक्षा.टोकन(),उ,सुरक्षा.टोकन(),नया सूची<पाठ>()); स्थिर अब: पूर्णांक=समय.अभी();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (ल: डेटालेनदेन=ड.लेनदेन()) {
            संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_lock SET revision=revision WHERE id=1")) { क.चलाओ(); }
            संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM platform_sessions WHERE born<=? OR touched<=?")) { क.पूर्णांकरखो(१,अब-२८८०००००); क.पूर्णांकरखो(२,अब-१८०००००); क.चलाओ(); }
            संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM platform_sessions")) { क.अगला(); यदि (क.पूर्णांकलो(०)>=१००००) { फेंको नया वेबत्रुटि(५०३,"सत्र क्षमता भर गई।"); } }
            संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO platform_sessions(token_hash,user_id,csrf,born,touched) VALUES (?,?,?,?,?)")) {
                क.पाठरखो(१,डेटाचेकसम.शा२५६(स.पहचान())); क.पाठरखो(२,उ); क.पाठरखो(३,स.सीएसआरएफ()); क.पूर्णांकरखो(४,अब); क.पूर्णांकरखो(५,अब); क.चलाओ();
            } ल.सहेजो();
        } } लौटाओ स;
    }
    सार्वजनिक अधिलेखन फलन आंतरिकजीवितहै(स: सत्र) -> तार्किक {
        यदि (सेवाबंद || स==रिक्त) { लौटाओ असत्य; } स्थिर अब: पूर्णांक=समय.अभी();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार("SELECT user_id,csrf FROM platform_sessions WHERE token_hash=? AND born<=? AND born>? AND touched>?")) {
            क.पाठरखो(१,डेटाचेकसम.शा२५६(स.पहचान())); क.पूर्णांकरखो(२,अब); क.पूर्णांकरखो(३,अब-२८८०००००); क.पूर्णांकरखो(४,अब-१८०००००);
            लौटाओ क.अगला() && क.पाठलो(०)==स.उपयोगकर्ता() && सुरक्षा.समान(क.पाठलो(१),स.सीएसआरएफ());
        } }
    }
    सार्वजनिक अधिलेखन फलन बदलो(पुराना: सत्र, उ: पाठ, भूमिकाएँ: सूची<पाठ>) -> सत्र {
        यदि (!यह.आंतरिकजीवितहै(पुराना)) { फेंको नया वेबत्रुटि(४०१,"सत्र उपलब्ध नहीं।"); }
        यह.हटाओ(पुराना); लौटाओ यह.आरंभ(उ,भूमिकाएँ);
    }
    सार्वजनिक अधिलेखन फलन हटाओ(स: सत्र) -> शून्य {
        यह.जाँचो(); यदि (स==रिक्त) { लौटाओ; }
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM platform_sessions WHERE token_hash=? AND csrf=? AND user_id=?")) {
            क.पाठरखो(१,डेटाचेकसम.शा२५६(स.पहचान())); क.पाठरखो(२,स.सीएसआरएफ()); क.पाठरखो(३,स.उपयोगकर्ता()); क.चलाओ();
        } }
    }
    सार्वजनिक अधिलेखन फलन उपयोगकर्ताहटाओ(उ: पाठ) -> शून्य {
        यह.जाँचो(); संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM platform_sessions WHERE user_id=?")) { क.पाठरखो(१,उ); क.चलाओ(); } }
    }
    सार्वजनिक अधिलेखन फलन कुकीरखो(उ: वेबउत्तर, स: सत्र) -> शून्य {
        यदि (!यह.आंतरिकजीवितहै(स)) { फेंको नया वेबत्रुटि(४०१,"सत्र उपलब्ध नहीं।"); }
        यदि (विकासमोड) { उ.शीर्षजोड़ो("Set-Cookie",यह.नाम()+"="+स.पहचान()+"; Path=/; HttpOnly; SameSite=Lax"); }
        अन्यथा { कुकी.सुरक्षितजोड़ो(उ,यह.नाम(),स.पहचान(),-१); } उ.शीर्षरखो("Cache-Control","no-store");
    }
    सार्वजनिक अधिलेखन फलन कुकीमिटाओ(उ: वेबउत्तर) -> शून्य {
        यदि (विकासमोड) { उ.शीर्षजोड़ो("Set-Cookie",यह.नाम()+"=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0"); }
        अन्यथा { कुकी.सुरक्षितजोड़ो(उ,यह.नाम(),"",०); } उ.शीर्षरखो("Cache-Control","no-store");
    }
    सार्वजनिक अधिलेखन फलन आकार() -> पूर्णांक {
        यह.साफकरो(); संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार("SELECT COUNT(*) FROM platform_sessions")) { क.अगला(); लौटाओ क.पूर्णांकलो(०); } }
    }
    सार्वजनिक अधिलेखन फलन साफकरो() -> शून्य {
        यह.जाँचो(); स्थिर अब: पूर्णांक=समय.अभी();
        संसाधन (ड: डेटासंबंध=स्रोत.खोलो()) { संसाधन (क: डेटाकथन=ड.तैयार("DELETE FROM platform_sessions WHERE born<=? OR touched<=?")) { क.पूर्णांकरखो(१,अब-२८८०००००); क.पूर्णांकरखो(२,अब-१८०००००); क.चलाओ(); } }
    }
    सार्वजनिक अधिलेखन फलन बंदकरो() -> शून्य { सेवाबंद=सत्य; नीति.बंदकरो(); यदि (दूसरीनीति!=रिक्त) { दूसरीनीति.बंदकरो(); } आधार.बंदकरो(); }
}
