संकुल अनुप्रयोग;
आयात मानक.डेटासंबंध; आयात मानक.डेटाकथन; आयात मानक.डेटालेनदेन;
आयात मानक.वेबत्रुटि; आयात मानक.सत्र; आयात मानक.समय; आयात मानक.डेटाचेकसम;
आयात मानक.सुरक्षा;

सार्वजनिक अभिलेख संगठनसंदर्भ(संगठन: पाठ, उपयोगकर्ता: पाठ, भूमिका: पाठ);

सार्वजनिक वर्ग संगठननीति {
    सार्वजनिक साझा फलन खाताजाँचो(ड: डेटासंबंध, स: सत्र) -> शून्य {
        यदि (स==रिक्त || स.उपयोगकर्ता()=="") { फेंको नया वेबत्रुटि(४०१,"प्रवेश आवश्यक।"); }
        स्थिर अब: पूर्णांक=समय.अभी();
        संसाधन (क: डेटाकथन=ड.तैयार("SELECT u.id FROM platform_users u JOIN platform_sessions s ON s.user_id=u.id WHERE u.id=? AND u.active=TRUE AND s.token_hash=? AND s.csrf=? AND s.born<=? AND s.born>? AND s.touched>?")) {
            क.पाठरखो(१,स.उपयोगकर्ता()); क.पाठरखो(२,डेटाचेकसम.शा२५६(स.पहचान())); क.पाठरखो(३,स.सीएसआरएफ()); क.पूर्णांकरखो(४,अब); क.पूर्णांकरखो(५,अब-२८८०००००); क.पूर्णांकरखो(६,अब-१८०००००);
            यदि (!क.अगला()) { फेंको नया वेबत्रुटि(४०१,"खाता उपलब्ध नहीं।"); }
        }
    }
    // Caller supplies an authenticated session, never a client-submitted user ID.
    // Mutations call this after acquiring the tenant write lock in their transaction.
    सार्वजनिक साझा फलन जाँचो(ड: डेटासंबंध, स: सत्र, संगठन: पाठ, लिखना: तार्किक, मालिक: तार्किक) -> संगठनसंदर्भ {
        यदि (स==रिक्त || स.उपयोगकर्ता()=="") { फेंको नया वेबत्रुटि(४०१,"प्रवेश आवश्यक।"); }
        स्थिर अब: पूर्णांक=समय.अभी();
        संसाधन (क: डेटाकथन=ड.तैयार("SELECT m.role FROM platform_members m JOIN platform_users u ON u.id=m.user_id JOIN platform_tenants t ON t.id=m.tenant_id JOIN platform_sessions s ON s.user_id=m.user_id WHERE m.tenant_id=? AND m.user_id=? AND u.active=TRUE AND s.token_hash=? AND s.csrf=? AND s.born<=? AND s.born>? AND s.touched>?")) {
            क.पाठरखो(१,संगठन); क.पाठरखो(२,स.उपयोगकर्ता()); क.पाठरखो(३,डेटाचेकसम.शा२५६(स.पहचान())); क.पाठरखो(४,स.सीएसआरएफ());
            क.पूर्णांकरखो(५,अब); क.पूर्णांकरखो(६,अब-२८८०००००); क.पूर्णांकरखो(७,अब-१८०००००);
            यदि (!क.अगला()) { फेंको नया वेबत्रुटि(४०४,"संगठन उपलब्ध नहीं।"); }
            स्थिर र: पाठ=क.पाठलो(०);
            यदि ((लिखना && र=="viewer") || (मालिक && र!="owner")) { फेंको नया वेबत्रुटि(४०३,"अनुमति नहीं।"); }
            लौटाओ नया संगठनसंदर्भ(संगठन,स.उपयोगकर्ता(),र);
        }
    }
    सार्वजनिक साझा फलन तालालो(ड: डेटासंबंध, संगठन: पाठ) -> शून्य {
        संसाधन (क: डेटाकथन=ड.तैयार("UPDATE platform_tenants SET revision=revision+1 WHERE id=? AND revision<2147483647")) { क.पाठरखो(१,संगठन); यदि (क.चलाओ()!=१) { फेंको नया वेबत्रुटि(४०४,"संगठन उपलब्ध नहीं।"); } }
    }
    सार्वजनिक साझा फलन लेखा(ड: डेटासंबंध, संदर्भ: संगठनसंदर्भ, क्रिया: पाठ, वस्तु: पाठ, पहचान: पाठ) -> शून्य {
        संसाधन (क: डेटाकथन=ड.तैयार("INSERT INTO platform_audit(id,tenant_id,actor,action,entity,entity_id,created) VALUES (?,?,?,?,?,?,?)")) {
            क.पाठरखो(१,सुरक्षा.टोकन()); क.पाठरखो(२,संदर्भ.संगठन); क.पाठरखो(३,संदर्भ.उपयोगकर्ता); क.पाठरखो(४,क्रिया); क.पाठरखो(५,वस्तु); क.पाठरखो(६,पहचान); क.पूर्णांकरखो(७,समय.अभी()); क.चलाओ();
        }
    }
}
