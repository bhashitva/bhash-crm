संकुल अनुप्रयोग;
आयात मानक.डेटा; आयात मानक.डेटासंबंध; आयात मानक.पोस्टग्रेसविन्यास;
आयात मानक.विन्यास; आयात मानक.वेब;

सार्वजनिक वर्ग डेटास्रोत {
    निजी स्थिर पथ: पाठ;
    निजी मान पोस्टग्रेस: पोस्टग्रेसविन्यास;
    सार्वजनिक निर्माता(प्रदाता: पाठ, पथ: पाठ) {
        यह.पथ=पथ;
        यदि (प्रदाता=="postgresql") {
            पोस्टग्रेस=नया पोस्टग्रेसविन्यास();
            पोस्टग्रेस.मेज़बान=विन्यास.परिवेश("BHASH_PG_HOST","localhost");
            पोस्टग्रेस.पोर्ट=वेब.संख्या(विन्यास.परिवेश("BHASH_PG_PORT","5432"),६५५३५);
            पोस्टग्रेस.डेटाबेस=विन्यास.परिवेश("BHASH_PG_DATABASE","bhash_crm");
            पोस्टग्रेस.उपयोगकर्ता=विन्यास.परिवेश("BHASH_PG_USER","bhash");
            पोस्टग्रेस.गुप्तशब्द=विन्यास.परिवेश("BHASH_PG_PASSWORD","");
            पोस्टग्रेस.सुरक्षा=विन्यास.परिवेश("BHASH_PG_SSLMODE","verify-full");
            पोस्टग्रेस.प्रमाणपत्र=विन्यास.परिवेश("BHASH_PG_CA","");
        } अन्यथा यदि (प्रदाता!="sqlite") { फेंको नया अपवाद("sqlite या postgresql प्रदाता चाहिए।"); }
    }
    सार्वजनिक फलन खोलो() -> डेटासंबंध {
        यदि (पोस्टग्रेस==रिक्त) { लौटाओ डेटा.एसक्यूलाइट(पथ); } लौटाओ डेटा.पोस्टग्रेस(पोस्टग्रेस);
    }
}
