संकुल अनुप्रयोग;
आयात मानक.पाठ्य;
आयात मानक.वेब;
आयात मानक.वेबत्रुटि;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबउत्तर;
आयात मानक.वेबचालक;
आयात मानक.सत्रप्रबंधक;

सार्वजनिक वर्ग फॉर्म {
    सार्वजनिक साझा फलन विकूटित(मूल: पाठ) -> पाठ {
        स्थिर ब: बाइटबफ़र=पाठ्य.यूटीएफ८(मूल); स्थिर फल: बाइटबफ़र=नया बाइटबफ़र(ब.आकार); मान क: पूर्णांक=०; मान ग: पूर्णांक=०;
        जबतक (क<ब.आकार) {
            मान अ: पूर्णांक=परिवर्तित<पूर्णांक>(ब[क]);
            यदि (अ==३७) {
                यदि (क+२>=ब.आकार) { फेंको नया वेबत्रुटि(४००,"अमान्य फॉर्म कूट।"); }
                स्थिर ह: पूर्णांक=पाठ्य.खोजो("0123456789abcdef",पाठ्य.छोटाअक्षर(पाठ्य.यूटीएफ८पाठ(ब.काटो(क+१,क+२))));
                स्थिर ल: पूर्णांक=पाठ्य.खोजो("0123456789abcdef",पाठ्य.छोटाअक्षर(पाठ्य.यूटीएफ८पाठ(ब.काटो(क+२,क+३))));
                यदि (ह<० || ल<०) { फेंको नया वेबत्रुटि(४००,"अमान्य फॉर्म कूट।"); } अ=ह*१६+ल; क=क+२;
            } अन्यथा यदि (अ==४३) { अ=३२; }
            यदि ((अ<३२ && अ!=९ && अ!=१० && अ!=१३) || अ==१२७) { फेंको नया वेबत्रुटि(४००,"अमान्य फॉर्म अक्षर।"); }
            फल[ग]=परिवर्तित<बाइट>(अ); ग=ग+१; क=क+१;
        }
        प्रयास { लौटाओ पाठ्य.यूटीएफ८पाठ(फल.काटो(०,ग)); } पकड़ो (द: अपवाद) { फेंको नया वेबत्रुटि(४००,"फॉर्म शुद्ध UTF-8 चाहिए।"); }
    }
    सार्वजनिक साझा फलन पढ़ो(अ: वेबअनुरोध) -> मानचित्र<पाठ,पाठ> {
        स्थिर प्रकार: सूची<पाठ> =अ.शीर्षमान("content-type");
        यदि (प्रकार.आकार!=१) { फेंको नया वेबत्रुटि(४१५,"URL encoded फॉर्म चाहिए।"); }
        स्थिर ख: सूची<पाठ> =पाठ्य.बाँटो(पाठ्य.छोटाअक्षर(प्रकार[०]),";");
        यदि (पाठ्य.छाँटो(ख[०])!="application/x-www-form-urlencoded" || ख.आकार>२ || (ख.आकार==२ && पाठ्य.छाँटो(ख[१])!="charset=utf-8")) { फेंको नया वेबत्रुटि(४१५,"UTF-8 URL encoded फॉर्म चाहिए।"); }
        यदि (अ.सामग्री.आकार>६५५३६) { फेंको नया वेबत्रुटि(४१३,"फॉर्म बहुत बड़ा है।"); }
        स्थिर फल: मानचित्र<पाठ,पाठ> =नया मानचित्र<पाठ,पाठ>();
        प्रत्येक (पाठ्य.बाँटो(अ.पाठ्यांश(),"&") में य: पाठ) {
            यदि (य=="") { जारी; }
            स्थिर बराबर: पूर्णांक=पाठ्य.खोजो(य,"="); यदि (बराबर<१) { फेंको नया वेबत्रुटि(४००,"अमान्य फॉर्म।"); }
            स्थिर न: पाठ=फॉर्म.विकूटित(पाठ्य.अंश(य,०,बराबर)); स्थिर व: पाठ=फॉर्म.विकूटित(पाठ्य.अंश(य,बराबर+१,पाठ्य.लंबाई(य)));
            यदि (पाठ्य.लंबाई(न)>६४ || फल.है(न) || फल.आकार>=६४ || पाठ्य.यूटीएफ८(व).आकार>८१९२) { फेंको नया वेबत्रुटि(४००,"दोहरा या सीमा से बाहर फॉर्म क्षेत्र।"); }
            फल[न]=व;
        } लौटाओ फल;
    }
    सार्वजनिक साझा फलन मानलो(फ: मानचित्र<पाठ,पाठ>, नाम: पाठ, सीमा: पूर्णांक) -> पाठ {
        यदि (!फ.है(नाम)) { फेंको नया वेबत्रुटि(४२२,"अनिवार्य क्षेत्र अनुपस्थित।"); }
        स्थिर व: पाठ=पाठ्य.छाँटो(फ[नाम]); यदि (व=="" || पाठ्य.यूटीएफ८(व).आकार>सीमा) { फेंको नया वेबत्रुटि(४२२,"क्षेत्र सीमा से बाहर।"); } लौटाओ व;
    }
}

// Only this adapter promotes a validated form token into the existing CSRF policy.
// JSON/header-token clients continue to use सुरक्षितवेब unchanged.
सार्वजनिक अनुबंध वेबत्रुटिदृश्य {
    फलन उत्तर(अनुरोध: वेबअनुरोध, दोष: वेबत्रुटि) -> वेबउत्तर;
}
सार्वजनिक वर्ग फॉर्मसुरक्षा पालन वेबचालक {
    निजी स्थिर म: सत्रप्रबंधक; निजी स्थिर चालक: वेबचालक;
    निजी मान त्रुटिदृश्य: वेबत्रुटिदृश्य;
    सार्वजनिक निर्माता(म: सत्रप्रबंधक, चालक: वेबचालक) { यह.म=म; यह.चालक=चालक; }
    सार्वजनिक निर्माता(म: सत्रप्रबंधक, चालक: वेबचालक, त्रुटिदृश्य: वेबत्रुटिदृश्य) { यह.म=म; यह.चालक=चालक; यह.त्रुटिदृश्य=त्रुटिदृश्य; }
    सार्वजनिक फलन संभालो(अ: वेबअनुरोध) -> वेबउत्तर {
        मान उ: वेबउत्तर=रिक्त;
        प्रयास {
            यदि (अ.विधि=="POST") {
                यदि (अ.शीर्षमान("x-csrf-token").आकार!=०) { फेंको नया वेबत्रुटि(४००,"मिश्रित CSRF टोकन।"); }
                स्थिर फ: मानचित्र<पाठ,पाठ> =फॉर्म.पढ़ो(अ);
                यदि (!फ.है("_csrf")) { फेंको नया वेबत्रुटि(४०३,"CSRF टोकन चाहिए।"); }
                अ.शीर्ष.जोड़ो("x-csrf-token"); अ.शीर्ष.जोड़ो(फ["_csrf"]);
            }
            म.सीएसआरएफजाँचो(अ); उ=चालक.संभालो(अ);
        } पकड़ो (द: वेबत्रुटि) {
            यदि (त्रुटिदृश्य!=रिक्त) { उ=त्रुटिदृश्य.उत्तर(अ,द); }
            अन्यथा {
            उ=दृश्य.पृष्ठ("Request could not be completed",दृश्य.खंड("main").जोड़ो(दृश्य.शब्द("h1","Request could not be completed")).जोड़ो(दृश्य.शब्द("p","Status "+वेब.अंक(द.स्थिति))).जोड़ो(दृश्य.शब्द("p",द.संदेश)).जोड़ो(दृश्य.शब्द("p","Refresh the original page before trying again.")).जोड़ो(दृश्य.कड़ी("/","Return to CRM"))); उ.स्थिति=द.स्थिति;
            }
        }
        उ.शीर्षरखो("Cache-Control","no-store"); उ.शीर्षरखो("X-Content-Type-Options","nosniff"); उ.शीर्षरखो("Referrer-Policy","same-origin"); लौटाओ उ;
    }
}
